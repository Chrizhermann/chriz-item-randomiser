// Chriz Item Randomiser (cir.tp2): the post-install campaign runtime.
//
// Installs the runtime modules (prototype/, three tools/probes modules), hooks
// the user interface's single-player New Game, character import and character
// acceptance calls through M_FLPRUI.lua, wherever they are (UI.MENU, other
// menu and Lua files), and marks the BALDUR.GAM new-game template with
// GLOBAL FLPR_FRESH = 1. Every campaign of BG:EE (with Siege of Dragonspear),
// BG2:EE and EET starts from that template. Every input is checked before the first write, so a refused
// install leaves the game unchanged; uninstall restores every file it changed
// from backup. Configurator output written after installation (to
// randomiser-campaigns/) is not tracked.

// Game-text references for the player messages in M_FLPRUI.lua and M_FLPR.lua
// (in-game.tra @1700-@1706), so they appear in the language chosen here.
<<<<<<<< ...cir/fl-inlined/M_FLPRTXT.lua
-- Written by cir.tp2 when installed: game-text references for the
-- Chriz Item Randomiser messages in M_FLPRUI.lua.
FLPR_TEXT = {
    not_running = %flir_rt_text_not_running%,
    unsupported = %flir_rt_text_unsupported%,
    other_campaign = %flir_rt_text_other_campaign%,
    setup_failed = %flir_rt_text_setup_failed%,
    start_plain = %flir_rt_text_start_plain%,
    ready = %flir_rt_text_ready%,
    stopped = %flir_rt_text_stopped%,
}
>>>>>>>>

// The runtime needs Lua's io and os libraries. EEex's LuaJIT component
// provides them by writing exactly this line; comments must not satisfy it.
DEFINE_ACTION_MACRO flir_campaign_runtime_require_luajit BEGIN
  OUTER_SET flir_rt_mode_keys = 0
  OUTER_SET flir_rt_mode_matches = 0
  OUTER_SET flir_rt_mode_suffixes = 0
  ACTION_IF FILE_EXISTS ~InfinityLoader.ini~ BEGIN
    COPY - ~InfinityLoader.ini~ ~InfinityLoader.ini~
      COUNT_REGEXP_INSTANCES ~^LuaPatchMode=~ flir_rt_mode_keys
      COUNT_REGEXP_INSTANCES ~^LuaPatchMode=REPLACE_INTERNAL_WITH_EXTERNAL~ flir_rt_mode_matches
      COUNT_REGEXP_INSTANCES ~^LuaPatchMode=REPLACE_INTERNAL_WITH_EXTERNAL[^%WNL%%MNL%%LNL%]~ flir_rt_mode_suffixes
    BUT_ONLY
  END
  ACTION_IF flir_rt_mode_keys != 1 OR flir_rt_mode_matches != 1 OR flir_rt_mode_suffixes != 0 BEGIN
    FAIL @101510
  END
END

// WeiDU reads only the game's own resources and override, never a DLC archive
// the engine loads on top of them: ZIP files with a mod.key in the game folder
// (sod-dlc.zip) and in dlc/. Hooking UI.MENU and marking BALDUR.GAM from the
// game's own copies would hide the DLC's versions, for example Siege of
// Dragonspear's start menus. DLC Merger leaves an empty sod-dlc.zip behind.
// WeiDU cannot look inside a ZIP file, so other ZIP files in the game folder,
// such as downloaded mods, are not checked, nor is the documents folder.
DEFINE_ACTION_MACRO flir_campaign_runtime_check_dlc BEGIN
  ACTION_IF FILE_EXISTS ~sod-dlc.zip~ AND !FILE_SIZE ~sod-dlc.zip~ 0 BEGIN
    FAIL @101506
  END
  ACTION_IF DIRECTORY_EXISTS ~dlc~ BEGIN
    ACTION_CLEAR_ARRAY flir_rt_dlc
    GET_FILE_ARRAY flir_rt_dlc ~dlc~ ~^.+\.[zZ][iI][pP]$~
    ACTION_PHP_EACH flir_rt_dlc AS flir_rt_index => flir_rt_archive BEGIN
      ACTION_IF !FILE_SIZE ~%flir_rt_archive%~ 0 BEGIN
        FAIL @101506
      END
    END
  END
END

// The hooked engine methods are startEngine:OnNewGameButtonClick,
// startEngine:OnImportCharacterButtonClick and createCharScreen:AcceptCharacter.
// Each call of one, such as startEngine:OnNewGameButtonClick(), is pointed at
// its adapter function in M_FLPRUI.lua (FLPRUI_NewGame()), in every menu and
// Lua file of the user interface but the runtime's own (FLPR*): UI.MENU, a UI
// mod's files, and the default functions of the dispatcher through which mods
// built on DavidW's SFO library (SCS, IWDification) send their calls
// (m_dw_osd.lua). A call that is not hooked would start an unrandomised
// campaign without notice, so any other reference to a hooked method refuses
// the install, naming its file and line: an alias such as
// local f = startEngine.OnNewGameButtonClick, a call through another name, or
// a call split across lines. These need no hook:
//   - a definition (function startEngine:OnNewGameButtonClick(...), or an
//     assignment to startEngine.OnNewGameButtonClick), which the adapter calls;
//   - a string naming exactly the method, a dispatcher's key such as SFO's
//     dwSystemCall('createCharScreen:AcceptCharacter', ...), whose default
//     function makes a hooked call;
//   - multiplayer's connectionScreen:OnNewGameButtonClick and character
//     creation's own import (createCharScreen:OnImportCharacterButtonClick, a
//     character for a game already begun), which stay as they are.
// A UI without a character import button needs no import hook. Existing
// FLPRUI_ calls were written outside this installer; uninstalling it would
// leave them calling missing functions, so they refuse the install too.

// Replaces every character of MATCH0 but line breaks with #: a form already
// classified is not found again, and offsets and line numbers stay.
DEFINE_PATCH_MACRO flir_campaign_runtime_mask BEGIN
  INNER_PATCH_SAVE flir_rt_mask ~%MATCH0%~ BEGIN
    REPLACE_TEXTUALLY CASE_SENSITIVE ~[^%LNL%%MNL%]~ ~#~
  END
END

// Masks Lua comments, which neither call nor refer to anything: long ones
// (--[[ ... ]], also with = between the brackets), then -- to the end of the
// line.
DEFINE_PATCH_MACRO flir_campaign_runtime_mask_comments BEGIN
  SET flir_rt_open = INDEX_BUFFER (~--\[=*\[~)
  WHILE flir_rt_open >= 0 BEGIN
    SET flir_rt_level = 0
    WHILE (BYTE_AT (flir_rt_open + 3 + flir_rt_level)) = 0x3d BEGIN
      SET flir_rt_level += 1
    END
    SPRINT flir_rt_close ~]~
    FOR (flir_rt_i = 0; flir_rt_i < flir_rt_level; ++flir_rt_i) BEGIN
      SPRINT flir_rt_close ~%flir_rt_close%=~
    END
    SPRINT flir_rt_close ~%flir_rt_close%]~
    SET flir_rt_end = INDEX_BUFFER (EXACT_MATCH ~%flir_rt_close%~ (flir_rt_open + 4 + flir_rt_level))
    SET flir_rt_stop = (flir_rt_end < 0) ? BUFFER_LENGTH : (flir_rt_end + 2 + flir_rt_level)
    FOR (flir_rt_i = flir_rt_open; flir_rt_i < flir_rt_stop; ++flir_rt_i) BEGIN
      PATCH_IF (BYTE_AT flir_rt_i) != 10 AND (BYTE_AT flir_rt_i) != 13 BEGIN
        WRITE_BYTE flir_rt_i 0x23
      END
    END
    SET flir_rt_open = (flir_rt_stop >= BUFFER_LENGTH) ? (0 - 1) : INDEX_BUFFER (~--\[=*\[~ flir_rt_stop)
  END
  REPLACE_EVALUATE ~--[^%LNL%%MNL%]*~ BEGIN
    LPM flir_campaign_runtime_mask
  END ~%flir_rt_mask%~
END

// Calls of receiver:method in the buffer (flir_rt_calls). A definition
// (function receiver:method(...)) is no call and stays as it is. With
// hook = 1 the calls are pointed at the adapter, otherwise calls and
// definitions are masked.
DEFINE_PATCH_FUNCTION flir_campaign_runtime_calls
  INT_VAR
    hook = 0
  STR_VAR
    receiver = ~~
    method = ~~
    adapter = ~~
  RET
    flir_rt_calls
BEGIN
  SET flir_rt_calls = 0
  REPLACE_EVALUATE CASE_SENSITIVE
    ~\(function[ %TAB%%LNL%%MNL%]+\|\)\b%receiver%[ %TAB%]*:[ %TAB%]*%method%[ %TAB%]*(~ BEGIN
    SPRINT flir_rt_with ~%MATCH0%~
    PATCH_IF ~%MATCH1%~ STRING_EQUAL ~~ BEGIN
      SET flir_rt_calls += 1
      PATCH_IF hook BEGIN
        SPRINT flir_rt_with ~%adapter%(~
      END
    END
    PATCH_IF !hook BEGIN
      LPM flir_campaign_runtime_mask
      SPRINT flir_rt_with ~%flir_rt_mask%~
    END
  END ~%flir_rt_with%~
END

// Masks the forms of receiver:method that need no hook besides calls and
// definitions (see above) and returns the number of calls.
DEFINE_PATCH_FUNCTION flir_campaign_runtime_mask_method
  STR_VAR
    object = ~~
    name = ~~
  RET
    flir_rt_calls
BEGIN
  // Without EVAL, WeiDU passes the text %object% itself.
  LPF flir_campaign_runtime_calls STR_VAR receiver = EVAL ~%object%~ method = EVAL ~%name%~ RET flir_rt_calls END
  REPLACE_EVALUATE CASE_SENSITIVE
    ~function[ %TAB%%LNL%%MNL%]+%object%[ %TAB%]*\.[ %TAB%]*%name%\b\|\b%object%[ %TAB%]*\.[ %TAB%]*%name%[ %TAB%]*=[^=]~
  BEGIN
    LPM flir_campaign_runtime_mask
  END ~%flir_rt_mask%~
  REPLACE_EVALUATE CASE_SENSITIVE ~'%object%:%name%'\|"%object%:%name%"~ BEGIN
    LPM flir_campaign_runtime_mask
  END ~%flir_rt_mask%~
END

// Classifies one user-interface file, the buffer, which is changed and must
// not be written. Returns its calls of each hooked method and its first
// problem (flir_rt_problem 1: an FLPRUI_ name, 2: a reference to a hooked
// method that cannot be hooked) with its line and form.
DEFINE_PATCH_FUNCTION flir_campaign_runtime_scan_ui
  RET
    flir_rt_new_games
    flir_rt_imports
    flir_rt_accepts
    flir_rt_problem
    flir_rt_line
    flir_rt_form
BEGIN
  SET flir_rt_new_games = 0
  SET flir_rt_imports = 0
  SET flir_rt_accepts = 0
  SET flir_rt_problem = 0
  SET flir_rt_line = 0
  SPRINT flir_rt_form ~FLPRUI_~
  LPM flir_campaign_runtime_mask_comments
  SET flir_rt_at = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~FLPRUI_~)
  PATCH_IF flir_rt_at >= 0 BEGIN
    SET flir_rt_problem = 1
  END ELSE BEGIN
    LPF flir_campaign_runtime_mask_method STR_VAR object = ~startEngine~ name = ~OnNewGameButtonClick~
      RET flir_rt_new_games = flir_rt_calls END
    LPF flir_campaign_runtime_mask_method STR_VAR object = ~startEngine~ name = ~OnImportCharacterButtonClick~
      RET flir_rt_imports = flir_rt_calls END
    LPF flir_campaign_runtime_mask_method STR_VAR object = ~createCharScreen~ name = ~AcceptCharacter~
      RET flir_rt_accepts = flir_rt_calls END
    REPLACE_EVALUATE CASE_SENSITIVE
      ~\bconnectionScreen[ %TAB%]*[:.][ %TAB%]*OnNewGameButtonClick\b\|\bcreateCharScreen[ %TAB%]*[:.][ %TAB%]*OnImportCharacterButtonClick\b~
    BEGIN
      LPM flir_campaign_runtime_mask
    END ~%flir_rt_mask%~
    SPRINT flir_rt_reference
      ~[A-Za-z0-9_]*[ %TAB%]*[:.][ %TAB%]*\(OnNewGameButtonClick\|OnImportCharacterButtonClick\|AcceptCharacter\)\b~
    SET flir_rt_at = INDEX_BUFFER (CASE_SENSITIVE ~%flir_rt_reference%~)
    PATCH_IF flir_rt_at >= 0 BEGIN
      SET flir_rt_problem = 2
      SPRINT flir_rt_form ~~
      REPLACE_EVALUATE CASE_SENSITIVE ~%flir_rt_reference%~ BEGIN
        PATCH_IF ~%flir_rt_form%~ STRING_EQUAL ~~ BEGIN
          SPRINT flir_rt_form ~%MATCH0%~
        END
      END ~%MATCH0%~
    END
  END
  PATCH_IF flir_rt_problem BEGIN
    SET flir_rt_breaks = 0
    PATCH_IF flir_rt_at > 0 BEGIN
      READ_ASCII 0 flir_rt_before (flir_rt_at)
      INNER_PATCH ~%flir_rt_before%~ BEGIN
        COUNT_REGEXP_INSTANCES CASE_SENSITIVE EXACT_MATCH ~%LNL%~ flir_rt_breaks
      END
    END
    SET flir_rt_line = flir_rt_breaks + 1
  END
END

// Checks every menu and Lua file of the user interface and lists the files
// with calls to hook (flir_rt_hook).
DEFINE_ACTION_MACRO flir_campaign_runtime_check_menu BEGIN
  ACTION_IF !FILE_EXISTS_IN_GAME ~UI.MENU~ BEGIN
    FAIL @101512
  END
  OUTER_SET flir_rt_new_game = 0
  OUTER_SET flir_rt_accept = 0
  OUTER_SET flir_rt_failure = 0
  ACTION_CLEAR_ARRAY flir_rt_hook
  COPY_EXISTING_REGEXP - GLOB ~^.+\.\(lua\|menu\)$~ ~override~
    PATCH_IF flir_rt_failure = 0 AND (~%SOURCE_RES%~ STRING_MATCHES_REGEXP ~\([mM]_\)?[fF][lL][pP][rR].*~) BEGIN
      LPF flir_campaign_runtime_scan_ui RET flir_rt_new_games flir_rt_imports flir_rt_accepts flir_rt_problem
        flir_rt_line flir_rt_form END
      PATCH_IF flir_rt_problem BEGIN
        SET flir_rt_failure = flir_rt_problem
        SPRINT flir_rt_file ~%SOURCE_FILE%~
      END
      SET flir_rt_new_game += flir_rt_new_games
      SET flir_rt_accept += flir_rt_accepts
      PATCH_IF flir_rt_new_games + flir_rt_imports + flir_rt_accepts > 0 BEGIN
        SET $flir_rt_hook(~%SOURCE_FILE%~) = 1
      END
    END
  BUT_ONLY
  ACTION_IF flir_rt_failure = 1 BEGIN
    FAIL @101516
  END
  ACTION_IF flir_rt_failure = 2 BEGIN
    FAIL @101515
  END
  ACTION_IF flir_rt_new_game < 1 OR flir_rt_accept < 1 BEGIN
    FAIL @101512
  END
END

// BG2:EE and EET keep the template as GAME V2.0 (their Throne of Bhaal saves
// are GAME V2.1), BG:EE as GAME V1.1; all have a 0xb4-byte header and 84-byte
// variable records: name (32), type word at 0x20, integer value at 0x28. An
// existing FLPR_FRESH = 1 is accepted unchanged.
DEFINE_ACTION_MACRO flir_campaign_runtime_check_gam BEGIN
  ACTION_IF !FILE_EXISTS_IN_GAME ~BALDUR.GAM~ BEGIN
    FAIL @101513
  END
  OUTER_SET flir_rt_gam_valid = 0
  OUTER_SET flir_rt_fresh = 0
  OUTER_SET flir_rt_fresh_value = 0
  COPY_EXISTING - ~BALDUR.GAM~ ~...cir/fl-inlined/flir-baldur.gam~
    PATCH_IF BUFFER_LENGTH >= 0xb4 BEGIN
      READ_ASCII 0 flir_rt_signature (8)
      READ_LONG 0x38 flir_rt_var_offset
      READ_LONG 0x3c flir_rt_var_count
      PATCH_IF ((~%flir_rt_signature%~ STRING_EQUAL ~GAMEV2.0~) OR (~%flir_rt_signature%~ STRING_EQUAL ~GAMEV2.1~) OR
                (~%flir_rt_signature%~ STRING_EQUAL ~GAMEV1.1~)) AND
               flir_rt_var_count >= 0 AND
               (flir_rt_var_count = 0 OR (flir_rt_var_offset >= 0xb4 AND
                flir_rt_var_offset + flir_rt_var_count * 84 <= BUFFER_LENGTH)) BEGIN
        SET flir_rt_gam_valid = 1
        FOR (flir_rt_i = 0; flir_rt_i < flir_rt_var_count; ++flir_rt_i) BEGIN
          READ_ASCII (flir_rt_var_offset + flir_rt_i * 84) flir_rt_name (32) NULL
          PATCH_IF (~%flir_rt_name%~ STRING_EQUAL_CASE ~FLPR_FRESH~) BEGIN
            SET flir_rt_fresh += 1
            READ_LONG (flir_rt_var_offset + flir_rt_i * 84 + 0x28) flir_rt_fresh_value
          END
        END
      END
    END
  BUT_ONLY
  ACTION_IF !flir_rt_gam_valid BEGIN
    FAIL @101513
  END
  ACTION_IF flir_rt_fresh > 1 OR (flir_rt_fresh = 1 AND flir_rt_fresh_value != 1) BEGIN
    FAIL @101514
  END
END

// Same layout as the native test fixture: copy the variable table to the end
// of the file, append the marker and point the header at the new table.
DEFINE_ACTION_MACRO flir_campaign_runtime_mark_gam BEGIN
  ACTION_IF flir_rt_fresh = 0 BEGIN
    COPY_EXISTING ~BALDUR.GAM~ ~override~
      READ_LONG 0x38 flir_rt_var_offset
      READ_LONG 0x3c flir_rt_var_count
      SET flir_rt_table = BUFFER_LENGTH
      INSERT_BYTES flir_rt_table ((flir_rt_var_count + 1) * 84)
      FOR (flir_rt_i = 0; flir_rt_i < flir_rt_var_count * 84; flir_rt_i += 4) BEGIN
        READ_LONG (flir_rt_var_offset + flir_rt_i) flir_rt_long
        WRITE_LONG (flir_rt_table + flir_rt_i) flir_rt_long
      END
      SET flir_rt_marker = flir_rt_table + flir_rt_var_count * 84
      WRITE_ASCII flir_rt_marker ~FLPR_FRESH~ (32)
      WRITE_SHORT (flir_rt_marker + 0x20) 1
      WRITE_LONG (flir_rt_marker + 0x28) 1
      WRITE_LONG 0x38 flir_rt_table
      WRITE_LONG 0x3c (flir_rt_var_count + 1)
  END
END

DEFINE_ACTION_MACRO flir_campaign_runtime_install BEGIN
  LAM flir_campaign_runtime_require_luajit
  LAM flir_campaign_runtime_check_dlc
  LAM flir_campaign_runtime_check_menu
  LAM flir_campaign_runtime_check_gam

  // M_FLPR.lua loads all of these from override. The configurator applies its
  // settings to randomiser-campaigns/, where the runtime also records the
  // details behind a failure message (last-error.txt).
  COPY ~%MOD_FOLDER%/prototype/M_FLPRUI.lua~ ~override~
       ~%MOD_FOLDER%/prototype/M_FLPR.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRCore.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRCur.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRGat.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRGlob.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRHost.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRNat.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRScript.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRShop.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRSite.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRSpell.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRRun.menu~ ~override~
       ~%MOD_FOLDER%/tools/probes/FLPRGateAsm.lua~ ~override~
       ~%MOD_FOLDER%/tools/probes/FLPRCampaignPolicy.lua~ ~override~
       ~%MOD_FOLDER%/tools/probes/FLPRInventoryAsm.lua~ ~override~
  MKDIR ~randomiser-campaigns~

  OUTER_SET flir_rt_text_not_running = RESOLVE_STR_REF (@1700)
  OUTER_SET flir_rt_text_unsupported = RESOLVE_STR_REF (@1701)
  OUTER_SET flir_rt_text_other_campaign = RESOLVE_STR_REF (@1702)
  OUTER_SET flir_rt_text_setup_failed = RESOLVE_STR_REF (@1703)
  OUTER_SET flir_rt_text_start_plain = RESOLVE_STR_REF (@1704)
  OUTER_SET flir_rt_text_ready = RESOLVE_STR_REF (@1705)
  OUTER_SET flir_rt_text_stopped = RESOLVE_STR_REF (@1706)
  COPY ~...cir/fl-inlined/M_FLPRTXT.lua~ ~override/M_FLPRTXT.lua~ EVALUATE_BUFFER

  ACTION_PHP_EACH flir_rt_hook AS flir_rt_file => flir_rt_listed BEGIN
    COPY_EXISTING ~%flir_rt_file%~ ~override~
      LPF flir_campaign_runtime_calls INT_VAR hook = 1
        STR_VAR receiver = ~startEngine~ method = ~OnNewGameButtonClick~ adapter = ~FLPRUI_NewGame~ END
      LPF flir_campaign_runtime_calls INT_VAR hook = 1
        STR_VAR receiver = ~startEngine~ method = ~OnImportCharacterButtonClick~ adapter = ~FLPRUI_ImportCharacter~ END
      LPF flir_campaign_runtime_calls INT_VAR hook = 1
        STR_VAR receiver = ~createCharScreen~ method = ~AcceptCharacter~ adapter = ~FLPRUI_AcceptCharacter~ END
    BUT_ONLY
  END

  LAM flir_campaign_runtime_mark_gam

  // Quest and dialogue changes for the configurator's options; they never
  // stop the installation.
  INCLUDE ~%MOD_FOLDER%/lib/campaign_patches.tpa~
  LAM flir_campaign_patches_install

  COPY ~...blank~ ~override/flrandomiser3.mrk~
    INSERT_BYTES 0 1
    WRITE_BYTE 0 1
END
