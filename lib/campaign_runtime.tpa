// Chriz Item Randomiser (cir.tp2): the post-install campaign runtime.
//
// Installs the runtime modules (prototype/, three tools/probes modules), hooks
// UI.MENU's single-player New Game, character import and character acceptance
// calls through M_FLPRUI.lua, and marks the BALDUR.GAM new-game template with
// GLOBAL FLPR_FRESH = 1. Every campaign of BG:EE (with Siege of Dragonspear),
// BG2:EE and EET starts from that template. Every input is checked before the first write, so a refused
// install leaves the game unchanged; uninstall restores UI.MENU and BALDUR.GAM
// from backup. Configurator output written after installation (to
// randomiser-campaigns/) is not tracked.

// Game-text references for the player messages in M_FLPRUI.lua and M_FLPR.lua
// (in-game.tra @1700-@1706), so they appear in the language chosen here.
<<<<<<<< ...cir/fl-inlined/M_FLPRTXT.lua
-- Written by cir.tp2 when installed: game-text references for the
-- Chriz Item Randomiser messages in M_FLPRUI.lua.
FLPR_TEXT = {
    not_running = %flir_rt_text_not_running%,
    unsupported = %flir_rt_text_unsupported%,
    other_campaign = %flir_rt_text_other_campaign%,
    setup_failed = %flir_rt_text_setup_failed%,
    start_plain = %flir_rt_text_start_plain%,
    ready = %flir_rt_text_ready%,
    stopped = %flir_rt_text_stopped%,
}
>>>>>>>>

// The runtime needs Lua's io and os libraries. EEex's LuaJIT component
// provides them by writing exactly this line; comments must not satisfy it.
DEFINE_ACTION_MACRO flir_campaign_runtime_require_luajit BEGIN
  OUTER_SET flir_rt_mode_keys = 0
  OUTER_SET flir_rt_mode_matches = 0
  OUTER_SET flir_rt_mode_suffixes = 0
  ACTION_IF FILE_EXISTS ~InfinityLoader.ini~ BEGIN
    COPY - ~InfinityLoader.ini~ ~InfinityLoader.ini~
      COUNT_REGEXP_INSTANCES ~^LuaPatchMode=~ flir_rt_mode_keys
      COUNT_REGEXP_INSTANCES ~^LuaPatchMode=REPLACE_INTERNAL_WITH_EXTERNAL~ flir_rt_mode_matches
      COUNT_REGEXP_INSTANCES ~^LuaPatchMode=REPLACE_INTERNAL_WITH_EXTERNAL[^%WNL%%MNL%%LNL%]~ flir_rt_mode_suffixes
    BUT_ONLY
  END
  ACTION_IF flir_rt_mode_keys != 1 OR flir_rt_mode_matches != 1 OR flir_rt_mode_suffixes != 0 BEGIN
    FAIL @101510
  END
END

// WeiDU reads only the game's own resources and override, never a DLC archive
// the engine loads on top of them: ZIP files with a mod.key in the game folder
// (sod-dlc.zip) and in dlc/. Hooking UI.MENU and marking BALDUR.GAM from the
// game's own copies would hide the DLC's versions, for example Siege of
// Dragonspear's start menus. DLC Merger leaves an empty sod-dlc.zip behind.
// WeiDU cannot look inside a ZIP file, so other ZIP files in the game folder,
// such as downloaded mods, are not checked, nor is the documents folder.
DEFINE_ACTION_MACRO flir_campaign_runtime_check_dlc BEGIN
  ACTION_IF FILE_EXISTS ~sod-dlc.zip~ AND !FILE_SIZE ~sod-dlc.zip~ 0 BEGIN
    FAIL @101506
  END
  ACTION_IF DIRECTORY_EXISTS ~dlc~ BEGIN
    ACTION_CLEAR_ARRAY flir_rt_dlc
    GET_FILE_ARRAY flir_rt_dlc ~dlc~ ~^.+\.[zZ][iI][pP]$~
    ACTION_PHP_EACH flir_rt_dlc AS flir_rt_index => flir_rt_archive BEGIN
      ACTION_IF !FILE_SIZE ~%flir_rt_archive%~ 0 BEGIN
        FAIL @101506
      END
    END
  END
END

// A New Game, character import or character acceptance call that is not
// hooked would start an unrandomised campaign without notice, so unrecognised
// call forms refuse the install. Multiplayer connectionScreen:OnNewGameButtonClick
// and character creation's own import (createCharScreen:OnImportCharacterButtonClick,
// a character for a game already begun) stay untouched; a UI without a
// character import button needs no import hook.
// Existing FLPRUI_ calls were written outside this installer; uninstalling it
// would leave them calling missing functions. A UI mod that defines a hooked
// method would have its definition renamed into a global FLPRUI_ function that
// replaces the adapter, so definitions refuse the install too.
DEFINE_ACTION_MACRO flir_campaign_runtime_check_menu BEGIN
  ACTION_IF !FILE_EXISTS_IN_GAME ~UI.MENU~ BEGIN
    FAIL @101512
  END
  COPY_EXISTING - ~UI.MENU~ ~...cir/fl-inlined/flir-ui.menu~
    COUNT_REGEXP_INSTANCES CASE_SENSITIVE EXACT_MATCH ~startEngine:OnNewGameButtonClick(~ flir_rt_new_game
    COUNT_REGEXP_INSTANCES CASE_SENSITIVE EXACT_MATCH ~connectionScreen:OnNewGameButtonClick(~ flir_rt_multiplayer
    COUNT_REGEXP_INSTANCES CASE_SENSITIVE ~[:.]OnNewGameButtonClick~ flir_rt_new_game_any
    COUNT_REGEXP_INSTANCES CASE_SENSITIVE EXACT_MATCH ~startEngine:OnImportCharacterButtonClick(~ flir_rt_import
    COUNT_REGEXP_INSTANCES CASE_SENSITIVE EXACT_MATCH ~createCharScreen:OnImportCharacterButtonClick(~
      flir_rt_chargen_import
    COUNT_REGEXP_INSTANCES CASE_SENSITIVE ~[:.]OnImportCharacterButtonClick~ flir_rt_import_any
    COUNT_REGEXP_INSTANCES CASE_SENSITIVE EXACT_MATCH ~createCharScreen:AcceptCharacter(~ flir_rt_accept
    COUNT_REGEXP_INSTANCES CASE_SENSITIVE ~[:.]AcceptCharacter~ flir_rt_accept_any
    COUNT_REGEXP_INSTANCES CASE_SENSITIVE EXACT_MATCH ~FLPRUI_~ flir_rt_hooked
    COUNT_REGEXP_INSTANCES CASE_SENSITIVE
      ~function[ %TAB%%WNL%%MNL%%LNL%]+\(startEngine:OnNewGameButtonClick\|startEngine:OnImportCharacterButtonClick\|createCharScreen:AcceptCharacter\)~
      flir_rt_defined
  BUT_ONLY
  ACTION_IF flir_rt_defined != 0 BEGIN
    FAIL @101515
  END
  ACTION_IF flir_rt_new_game < 1 OR flir_rt_accept < 1 OR flir_rt_hooked != 0
         OR flir_rt_new_game + flir_rt_multiplayer != flir_rt_new_game_any
         OR flir_rt_import + flir_rt_chargen_import != flir_rt_import_any
         OR flir_rt_accept != flir_rt_accept_any BEGIN
    FAIL @101512
  END
END

// BG2:EE and EET keep the template as GAME V2.0, BG:EE as GAME V1.1; both have
// a 0xb4-byte header and 84-byte variable records: name (32), type word at
// 0x20, integer value at 0x28. An existing FLPR_FRESH = 1 is accepted unchanged.
DEFINE_ACTION_MACRO flir_campaign_runtime_check_gam BEGIN
  ACTION_IF !FILE_EXISTS_IN_GAME ~BALDUR.GAM~ BEGIN
    FAIL @101513
  END
  OUTER_SET flir_rt_gam_valid = 0
  OUTER_SET flir_rt_fresh = 0
  OUTER_SET flir_rt_fresh_value = 0
  COPY_EXISTING - ~BALDUR.GAM~ ~...cir/fl-inlined/flir-baldur.gam~
    PATCH_IF BUFFER_LENGTH >= 0xb4 BEGIN
      READ_ASCII 0 flir_rt_signature (8)
      READ_LONG 0x38 flir_rt_var_offset
      READ_LONG 0x3c flir_rt_var_count
      PATCH_IF ((~%flir_rt_signature%~ STRING_EQUAL ~GAMEV2.0~) OR (~%flir_rt_signature%~ STRING_EQUAL ~GAMEV1.1~)) AND
               flir_rt_var_count >= 0 AND
               (flir_rt_var_count = 0 OR (flir_rt_var_offset >= 0xb4 AND
                flir_rt_var_offset + flir_rt_var_count * 84 <= BUFFER_LENGTH)) BEGIN
        SET flir_rt_gam_valid = 1
        FOR (flir_rt_i = 0; flir_rt_i < flir_rt_var_count; ++flir_rt_i) BEGIN
          READ_ASCII (flir_rt_var_offset + flir_rt_i * 84) flir_rt_name (32) NULL
          PATCH_IF (~%flir_rt_name%~ STRING_EQUAL_CASE ~FLPR_FRESH~) BEGIN
            SET flir_rt_fresh += 1
            READ_LONG (flir_rt_var_offset + flir_rt_i * 84 + 0x28) flir_rt_fresh_value
          END
        END
      END
    END
  BUT_ONLY
  ACTION_IF !flir_rt_gam_valid BEGIN
    FAIL @101513
  END
  ACTION_IF flir_rt_fresh > 1 OR (flir_rt_fresh = 1 AND flir_rt_fresh_value != 1) BEGIN
    FAIL @101514
  END
END

// Same layout as the native test fixture: copy the variable table to the end
// of the file, append the marker and point the header at the new table.
DEFINE_ACTION_MACRO flir_campaign_runtime_mark_gam BEGIN
  ACTION_IF flir_rt_fresh = 0 BEGIN
    COPY_EXISTING ~BALDUR.GAM~ ~override~
      READ_LONG 0x38 flir_rt_var_offset
      READ_LONG 0x3c flir_rt_var_count
      SET flir_rt_table = BUFFER_LENGTH
      INSERT_BYTES flir_rt_table ((flir_rt_var_count + 1) * 84)
      FOR (flir_rt_i = 0; flir_rt_i < flir_rt_var_count * 84; flir_rt_i += 4) BEGIN
        READ_LONG (flir_rt_var_offset + flir_rt_i) flir_rt_long
        WRITE_LONG (flir_rt_table + flir_rt_i) flir_rt_long
      END
      SET flir_rt_marker = flir_rt_table + flir_rt_var_count * 84
      WRITE_ASCII flir_rt_marker ~FLPR_FRESH~ (32)
      WRITE_SHORT (flir_rt_marker + 0x20) 1
      WRITE_LONG (flir_rt_marker + 0x28) 1
      WRITE_LONG 0x38 flir_rt_table
      WRITE_LONG 0x3c (flir_rt_var_count + 1)
  END
END

DEFINE_ACTION_MACRO flir_campaign_runtime_install BEGIN
  LAM flir_campaign_runtime_require_luajit
  LAM flir_campaign_runtime_check_dlc
  LAM flir_campaign_runtime_check_menu
  LAM flir_campaign_runtime_check_gam

  // M_FLPR.lua loads all of these from override. The configurator applies its
  // settings to randomiser-campaigns/, where the runtime also records the
  // details behind a failure message (last-error.txt).
  COPY ~%MOD_FOLDER%/prototype/M_FLPRUI.lua~ ~override~
       ~%MOD_FOLDER%/prototype/M_FLPR.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRCore.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRCur.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRGat.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRGlob.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRHost.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRNat.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRScript.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRShop.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRSite.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRSpell.lua~ ~override~
       ~%MOD_FOLDER%/prototype/FLPRRun.menu~ ~override~
       ~%MOD_FOLDER%/tools/probes/FLPRGateAsm.lua~ ~override~
       ~%MOD_FOLDER%/tools/probes/FLPRCampaignPolicy.lua~ ~override~
       ~%MOD_FOLDER%/tools/probes/FLPRInventoryAsm.lua~ ~override~
  MKDIR ~randomiser-campaigns~

  OUTER_SET flir_rt_text_not_running = RESOLVE_STR_REF (@1700)
  OUTER_SET flir_rt_text_unsupported = RESOLVE_STR_REF (@1701)
  OUTER_SET flir_rt_text_other_campaign = RESOLVE_STR_REF (@1702)
  OUTER_SET flir_rt_text_setup_failed = RESOLVE_STR_REF (@1703)
  OUTER_SET flir_rt_text_start_plain = RESOLVE_STR_REF (@1704)
  OUTER_SET flir_rt_text_ready = RESOLVE_STR_REF (@1705)
  OUTER_SET flir_rt_text_stopped = RESOLVE_STR_REF (@1706)
  COPY ~...cir/fl-inlined/M_FLPRTXT.lua~ ~override/M_FLPRTXT.lua~ EVALUATE_BUFFER

  COPY_EXISTING ~UI.MENU~ ~override~
    REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~startEngine:OnNewGameButtonClick(~ ~FLPRUI_NewGame(~
    REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~startEngine:OnImportCharacterButtonClick(~ ~FLPRUI_ImportCharacter(~
    REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~createCharScreen:AcceptCharacter(~ ~FLPRUI_AcceptCharacter(~
  BUT_ONLY

  LAM flir_campaign_runtime_mark_gam

  // Quest and dialogue changes for the configurator's options; they never
  // stop the installation.
  INCLUDE ~%MOD_FOLDER%/lib/campaign_patches.tpa~
  LAM flir_campaign_patches_install

  COPY ~...blank~ ~override/flrandomiser3.mrk~
    INSERT_BYTES 0 1
    WRITE_BYTE 0 1
END
