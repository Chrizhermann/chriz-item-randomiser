
OUTER_SPRINT Preserve n
OUTER_SET LostChance = 0
OUTER_SET RandomNotRandom = 0
OUTER_SET flir_random_seed_state_ready = 0
ACTION_IF !VARIABLE_IS_SET flir_mode1_defer_state_publication BEGIN
  OUTER_SET flir_mode1_defer_state_publication = 0
END

DEFINE_ACTION_MACRO flir_random_seed_build_options_state BEGIN
  OUTER_TEXT_SPRINT flir_random_options_state ~Header%WNL%~
  ACTION_SORT_ARRAY_INDICES RandOptions LEXICOGRAPHICALLY
  ACTION_PHP_EACH RandOptions AS flir_random_option => flir_random_option_enabled BEGIN
    OUTER_TEXT_SPRINT flir_random_options_state ~%flir_random_options_state%%flir_random_option%%WNL%~
  END
END

DEFINE_ACTION_MACRO flir_random_seed_publish_state BEGIN
  ACTION_IF flir_random_seed_state_ready != 1 BEGIN
    FAIL ~FLIR_RANDOM_SEED_ERR STATE_NOT_READY~
  END
  // RandOptions remains authoritative until the final commit seam: arrays.tpa
  // and extension code may add accepted choices after the seed is prepared.
  LAM flir_random_seed_build_options_state
  COPY + "...blank" "override/fl#randomseed.2da"
    INSERT_BYTES 0 4
    WRITE_LONG 0 Seed
    INSERT_BYTES 4 1
    WRITE_BYTE 4 LostChance
    INSERT_BYTES 5 1
    WRITE_BYTE 5 RandomNotRandom
  BUT_ONLY
  COPY + "...blank" "override/fl#randoptions.2da"
    INSERT_BYTES 0 STRING_LENGTH "%flir_random_options_state%"
    WRITE_ASCIIE 0 "%flir_random_options_state%" (STRING_LENGTH "%flir_random_options_state%")
  BUT_ONLY
END

ACTION_IF weidu_action = 0 BEGIN
  INCLUDE "randomiser/lib/registry.tpa"
  OUTER_SPRINT flir_registry_backend ~legacy-bcs-v1~
END

OUTER_SET flir_seed_state_seed_present = 0
OUTER_SET flir_seed_state_removed_present = 0
OUTER_SET flir_seed_state_options_present = 0
ACTION_IF FILE_EXISTS_IN_GAME "fl#randomseed.2da"
      OR FILE_EXISTS "override/fl#randomseed.2da" BEGIN
  OUTER_SET flir_seed_state_seed_present = 1
END
ACTION_IF FILE_EXISTS_IN_GAME "fl#removeditems.2da"
      OR FILE_EXISTS "override/fl#removeditems.2da" BEGIN
  OUTER_SET flir_seed_state_removed_present = 1
END
ACTION_IF FILE_EXISTS_IN_GAME "fl#randoptions.2da"
      OR FILE_EXISTS "override/fl#randoptions.2da" BEGIN
  OUTER_SET flir_seed_state_options_present = 1
END
OUTER_SET flir_seed_state_count = flir_seed_state_seed_present + flir_seed_state_removed_present + flir_seed_state_options_present

ACTION_IF flir_seed_state_count > 0 AND flir_seed_state_count < 3 BEGIN
  FAIL ~FLIR_RANDOM_SEED_ERR INCOMPLETE_STATE count=%flir_seed_state_count%~
END

ACTION_IF flir_seed_state_count = 3 AND INTERACTIVE BEGIN
  PRINT @100024
  ACTION_READLN Preserve
  OUTER_WHILE !"%Preserve%" STRING_EQUAL_CASE y AND !"%Preserve%" STRING_EQUAL_CASE n BEGIN
    PRINT @100024
    ACTION_READLN Preserve
  END
END

ACTION_IF !INTERACTIVE BEGIN //During non-interactive manipulations of the mod we want to preserve saved-game compatibility
  LOG "NON-INTERACTIVE"
  ACTION_IF flir_seed_state_count = 3 BEGIN
    OUTER_SPRINT Preserve y
  END ELSE BEGIN
    OUTER_SPRINT Preserve n
  END
END

ACTION_IF "%Preserve%" STRING_EQUAL_CASE n BEGIN
  OUTER_SET Seed = RANDOM(1 0xffff)
  RANDOM_SEED "%Seed%"
  ACTION_IF lost BEGIN
    PRINT @100021
    ACTION_READLN LostChance
    OUTER_WHILE !IS_AN_INT LostChance OR LostChance > 100 OR LostChance < 0 BEGIN
      PRINT @100021
      ACTION_READLN LostChance
    END
  END
  ACTION_IF FILE_EXISTS_IN_GAME flrc510.mrk BEGIN
    COPY_EXISTING flrc510.mrk override
      READ_BYTE 0 RandomNotRandom ELSE 0
    BUT_ONLY
  END

  OUTER_PATCH_SAVE flir_random_options_state "" BEGIN
    //INSERT_BYTES 0 STRING_LENGTH "%string%"
    //WRITE_ASCIIE 0 "%string%" (STRING_LENGTH "%string%")
    INSERT_2DA_ROW 0 1 Header
    rc = 1
    PATCH_FOR_EACH condition IN weidu_action BEGIN
      PATCH_IF EVAL "%condition%" BEGIN
        INSERT_2DA_ROW rc 1 "%condition%"
        ++rc
        SET $RandOptions("%condition%") = 1
      END
    END
    PATCH_FOR_EACH condition IN flrc500 flrc520 flrc530 flrc540 flrc550 flrc560 flrc570 BEGIN
      TO_LOWER condition
      PATCH_IF FILE_EXISTS_IN_GAME "%condition%.mrk" BEGIN
        INSERT_2DA_ROW rc 1 "%condition%"
        ++rc
        SET $RandOptions("%condition%") = 1
      END
    END
  END
  OUTER_SET flir_random_seed_state_ready = 1
  ACTION_IF flir_mode1_defer_state_publication = 0 BEGIN
    LAM flir_random_seed_publish_state
  END
END
ACTION_IF "%Preserve%" STRING_EQUAL_CASE y BEGIN
  COPY_EXISTING "fl#randomseed.2da" override
    READ_LONG 0 Seed
    READ_BYTE 4 LostChance
    READ_BYTE 5 RandomNotRandom
  BUT_ONLY
  COPY_EXISTING "fl#randoptions.2da" override
    READ_2DA_ENTRIES_NOW r2en_randoptions 1
    FOR (i=1;i<r2en_randoptions;++i) BEGIN
      READ_2DA_ENTRY_FORMER r2en_randoptions i 0 option
      SET $RandOptions("%option%") = 1
    END
  BUT_ONLY
  ACTION_IF !weidu_action AND VARIABLE_IS_SET $RandOptions("weidu_action") BEGIN
    FAIL @100025
  END
  ACTION_IF weidu_action AND !VARIABLE_IS_SET $RandOptions("weidu_action") BEGIN
    FAIL @100026
  END
  RANDOM_SEED "%Seed%"
END

ACTION_IF weidu_action = 0 BEGIN
  LAM flir_registry_preload_state
END
