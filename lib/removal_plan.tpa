// Mode 1 source declaration hook and read-only removal planning.
//
// The public Phase 2 extension surface is intentionally not implemented here.
// This file provides the internal Phase 1 seam used by the installer and by
// hermetic tests: raw declarations can be replaced before filtering, then a
// validated removal plan is built before any game resource is mutated.

OUTER_SET flir_source_decl_count = 0
OUTER_SET flir_removal_plan_count = 0
OUTER_SET flir_removal_plan_disabled_count = 0
OUTER_SET flir_removal_plan_applied_count = 0
OUTER_SET flir_source_legacy_snapshot_initialized = 0
OUTER_SET flir_source_legacy_cursor = 0
OUTER_SET flir_removal_building_legacy_snapshot = 0
OUTER_SET flir_source_extension_active = 0
OUTER_SET flir_removal_state_ready = 0
ACTION_IF !VARIABLE_IS_SET flir_registry_old_unmarked_migration BEGIN
  OUTER_SET flir_registry_old_unmarked_migration = 0
END

DEFINE_ACTION_MACRO flir_source_prepare_birth_identities BEGIN
  ACTION_IF VARIABLE_IS_SET flir_registry_available
        AND flir_registry_available = 1 BEGIN
    OUTER_FOR (flir_source_birth_i = 1; flir_source_birth_i <= flir_source_decl_count; ++flir_source_birth_i) BEGIN
      ACTION_IF VARIABLE_IS_SET $flir_source_decl_order("%flir_source_birth_i%") BEGIN
        OUTER_SPRINT flir_source_birth_key $flir_source_decl_order("%flir_source_birth_i%")
        OUTER_SPRINT flir_source_birth_tier $flir_source_decl_tier("%flir_source_birth_key%")
        OUTER_SPRINT flir_source_birth_ident $flir_source_decl_ident("%flir_source_birth_key%")
        OUTER_SPRINT flir_source_birth_hook ~~
        ACTION_IF VARIABLE_IS_SET $flir_source_decl_tier_hook("%flir_source_birth_key%") BEGIN
          OUTER_SPRINT flir_source_birth_hook $flir_source_decl_tier_hook("%flir_source_birth_key%")
        END
        OUTER_SPRINT flir_source_birth_campaign ~~
        ACTION_IF "%flir_source_birth_hook%" STRING_EQUAL_CASE "bg1_tiers" BEGIN
          OUTER_SPRINT flir_source_birth_campaign ~bg1~
        END ELSE ACTION_IF "%flir_source_birth_hook%" STRING_EQUAL_CASE "bg2_tiers" BEGIN
          OUTER_SPRINT flir_source_birth_campaign ~bg2~
        END ELSE ACTION_IF VARIABLE_IS_SET $flir_source_decl_campaign("%flir_source_birth_key%") BEGIN
          OUTER_SPRINT flir_source_birth_campaign $flir_source_decl_campaign("%flir_source_birth_key%")
        END
        ACTION_IF "%flir_source_birth_campaign%" STRING_EQUAL_CASE "" BEGIN
          OUTER_SET flir_source_birth_bg1_tier = 0
          OUTER_SET flir_source_birth_bg2_tier = 0
          ACTION_IF VARIABLE_IS_SET $bg1_tiers("%flir_source_birth_tier%") BEGIN
            OUTER_SET flir_source_birth_bg1_tier = 1
          END
          ACTION_IF VARIABLE_IS_SET $bg2_tiers("%flir_source_birth_tier%") BEGIN
            OUTER_SET flir_source_birth_bg2_tier = 1
          END
          ACTION_IF flir_source_birth_bg1_tier = 1 AND flir_source_birth_bg2_tier = 0 BEGIN
            OUTER_SPRINT flir_source_birth_campaign ~bg1~
          END ELSE ACTION_IF flir_source_birth_bg2_tier = 1 AND flir_source_birth_bg1_tier = 0 BEGIN
            OUTER_SPRINT flir_source_birth_campaign ~bg2~
          END
        END
        ACTION_IF "%flir_source_birth_campaign%" STRING_EQUAL_CASE "" BEGIN
          LAF flir_removal_fail STR_VAR code = ~SOURCE_CAMPAIGN_MISSING~ tier = EVAL ~%flir_source_birth_tier%~ token = $flir_source_decl_token("%flir_source_birth_key%") ident = EVAL ~%flir_source_birth_ident%~ END
        END

        ACTION_IF VARIABLE_IS_SET $flir_source_decl_birth_stable("%flir_source_birth_key%") BEGIN
          OUTER_SPRINT flir_source_existing_birth_campaign $flir_source_decl_birth_campaign("%flir_source_birth_key%")
          OUTER_SPRINT flir_source_existing_birth_tier $flir_source_decl_birth_tier("%flir_source_birth_key%")
          ACTION_IF NOT ("%flir_source_birth_campaign%" STRING_EQUAL_CASE "%flir_source_existing_birth_campaign%")
                OR NOT ("%flir_source_birth_tier%" STRING_EQUAL_CASE "%flir_source_existing_birth_tier%") BEGIN
            LAF flir_removal_fail STR_VAR code = ~SOURCE_BIRTH_SCOPE_DRIFT~ tier = EVAL ~%flir_source_birth_tier%~ token = $flir_source_decl_token("%flir_source_birth_key%") ident = EVAL ~%flir_source_birth_ident%~ END
          END
        END ELSE BEGIN
          OUTER_SPRINT flir_source_birth_stable ~~
          ACTION_IF "%flir_source_birth_ident%" STRING_COMPARE_CASE "x" BEGIN
            OUTER_SPRINT flir_source_birth_stable ~legacy:unit-%flir_source_birth_campaign%-%flir_source_birth_tier%-ident-%flir_source_birth_ident%~
          END ELSE BEGIN
            OUTER_TEXT_SPRINT flir_catalog_canonical ~~
            OUTER_TEXT_SPRINT flir_catalog_append_value ~anon-birth-v1~
            LAM flir_catalog_append_canonical
            OUTER_TEXT_SPRINT flir_catalog_append_value ~%flir_source_birth_campaign%~
            LAM flir_catalog_append_canonical
            OUTER_TEXT_SPRINT flir_catalog_append_value ~%flir_source_birth_tier%~
            LAM flir_catalog_append_canonical
            OUTER_TEXT_SPRINT flir_catalog_append_value $flir_source_decl_item("%flir_source_birth_key%")
            LAM flir_catalog_append_canonical
            OUTER_TEXT_SPRINT flir_catalog_append_value $flir_source_decl_replacement("%flir_source_birth_key%")
            LAM flir_catalog_append_canonical
            OUTER_TEXT_SPRINT flir_catalog_append_value $flir_source_decl_source("%flir_source_birth_key%")
            LAM flir_catalog_append_canonical
            OUTER_TEXT_SPRINT flir_catalog_append_value $flir_source_decl_chance("%flir_source_birth_key%")
            LAM flir_catalog_append_canonical
            OUTER_TEXT_SPRINT flir_catalog_append_value $flir_source_decl_source_kind("%flir_source_birth_key%")
            LAM flir_catalog_append_canonical
            OUTER_TEXT_SPRINT flir_catalog_append_value $flir_source_decl_object_or_slot("%flir_source_birth_key%")
            LAM flir_catalog_append_canonical
            OUTER_TEXT_SPRINT flir_catalog_append_value $flir_source_decl_virtual_policy("%flir_source_birth_key%")
            LAM flir_catalog_append_canonical
            OUTER_TEXT_SPRINT flir_catalog_append_value $flir_source_decl_declared_charge1("%flir_source_birth_key%")
            LAM flir_catalog_append_canonical
            OUTER_TEXT_SPRINT flir_catalog_append_value $flir_source_decl_declared_charge2("%flir_source_birth_key%")
            LAM flir_catalog_append_canonical
            OUTER_TEXT_SPRINT flir_catalog_append_value $flir_source_decl_declared_charge3("%flir_source_birth_key%")
            LAM flir_catalog_append_canonical
            OUTER_TEXT_SPRINT flir_catalog_append_value $flir_source_decl_expected_quantity("%flir_source_birth_key%")
            LAM flir_catalog_append_canonical
            LAF flir_registry_hash_text STR_VAR text = EVAL ~%flir_catalog_canonical%~ RET flir_source_birth_fingerprint = hash END
            ACTION_IF VARIABLE_IS_SET $flir_source_birth_hash_canonical("%flir_source_birth_campaign%" "%flir_source_birth_tier%" "%flir_source_birth_fingerprint%") BEGIN
              OUTER_TEXT_SPRINT flir_source_birth_existing_canonical $flir_source_birth_hash_canonical("%flir_source_birth_campaign%" "%flir_source_birth_tier%" "%flir_source_birth_fingerprint%")
              ACTION_IF NOT ("%flir_source_birth_existing_canonical%" STRING_EQUAL "%flir_catalog_canonical%") BEGIN
                LAF flir_removal_fail STR_VAR code = ~SOURCE_ID_HASH_COLLISION~ tier = EVAL ~%flir_source_birth_tier%~ token = $flir_source_decl_token("%flir_source_birth_key%") ident = ~x~ END
              END
            END ELSE BEGIN
              OUTER_TEXT_SPRINT $flir_source_birth_hash_canonical("%flir_source_birth_campaign%" "%flir_source_birth_tier%" "%flir_source_birth_fingerprint%") ~%flir_catalog_canonical%~
            END
            ACTION_IF VARIABLE_IS_SET $flir_source_birth_occurrence("%flir_source_birth_campaign%" "%flir_source_birth_tier%" "%flir_source_birth_fingerprint%") BEGIN
              OUTER_SET $flir_source_birth_occurrence("%flir_source_birth_campaign%" "%flir_source_birth_tier%" "%flir_source_birth_fingerprint%") += 1
            END ELSE BEGIN
              OUTER_SET $flir_source_birth_occurrence("%flir_source_birth_campaign%" "%flir_source_birth_tier%" "%flir_source_birth_fingerprint%") = 1
            END
            OUTER_SET flir_source_birth_occurrence_value = $flir_source_birth_occurrence("%flir_source_birth_campaign%" "%flir_source_birth_tier%" "%flir_source_birth_fingerprint%")
            OUTER_SPRINT flir_source_birth_stable ~legacy:unit-%flir_source_birth_campaign%-%flir_source_birth_tier%-anon-%flir_source_birth_fingerprint%-%flir_source_birth_occurrence_value%~
            OUTER_SPRINT $flir_source_decl_birth_fingerprint("%flir_source_birth_key%") ~%flir_source_birth_fingerprint%~
          END
          OUTER_SPRINT $flir_source_decl_birth_campaign("%flir_source_birth_key%") ~%flir_source_birth_campaign%~
          OUTER_SPRINT $flir_source_decl_birth_tier("%flir_source_birth_key%") ~%flir_source_birth_tier%~
          OUTER_SPRINT $flir_source_decl_birth_stable("%flir_source_birth_key%") ~%flir_source_birth_stable%~
        END
      END
    END
  END
END

DEFINE_ACTION_FUNCTION flir_removal_fail
  STR_VAR
    code = ~~
    tier = ~~
    token = ~~
    ident = ~~
BEGIN
  FAIL ~FLIR_REMOVAL_ERR %code% tier=%tier% token=%token% ident=%ident%~
END

DEFINE_PATCH_FUNCTION flir_removal_hash_buffer
  RET
    hash
BEGIN
  hash = 0x811c9dc5
  FOR (flir_hash_i = 0; flir_hash_i < BUFFER_LENGTH; ++flir_hash_i) BEGIN
    hash = (hash BXOR BYTE_AT flir_hash_i) * 16777619
  END
  hash = ((hash BAND 2147483647) MODULO 2147483646) + 1
END

DEFINE_PATCH_FUNCTION flir_removal_hash_slice
  INT_VAR
    offset = 0
    length = 0
  RET
    hash
BEGIN
  hash = 0x811c9dc5
  FOR (flir_hash_i = 0; flir_hash_i < length; ++flir_hash_i) BEGIN
    hash = (hash BXOR BYTE_AT (offset + flir_hash_i)) * 16777619
  END
  hash = ((hash BAND 2147483647) MODULO 2147483646) + 1
END

DEFINE_PATCH_FUNCTION flir_removal_count_empty_cre_slots
  RET
    empty_slots
BEGIN
  READ_LONG 0x2b8 flir_capacity_slots_off ELSE 0
  SET empty_slots = 0
  FOR (flir_capacity_i = 0; flir_capacity_i < 37; ++flir_capacity_i) BEGIN
    READ_SHORT flir_capacity_slots_off + 2 * flir_capacity_i flir_capacity_slot ELSE 0
    PATCH_IF flir_capacity_slot = 0xffff BEGIN
      SET empty_slots += 1
    END
  END
END

DEFINE_PATCH_MACRO flir_removal_stuff_cre_patch BEGIN
  READ_LONG 0x2b8 stuff_itm_slt
  READ_LONG 0x2bc stuff_itm_off
  READ_LONG 0x2c0 stuff_num_itm
  INSERT_BYTES stuff_itm_off + 0x14*stuff_num_itm 0x14
  WRITE_ASCIIE stuff_itm_off + 0x14*stuff_num_itm "%itm_to_stuff%"
  SPRINT $removed_item_array("%removed_tier%" "%removed_token%" "%removed_ident%") ""
  SPRINT $plugintierandtokenandgetitem("%removed_tier%" "%removed_token%") "%itm_to_del%"
  WRITE_LONG 0x2c0 stuff_num_itm + 1
  stuff_itm_slt += 0x14
  WRITE_LONG 0x2b8 stuff_itm_slt
  FOR (stuff=0;stuff<37;stuff+=1) BEGIN
    READ_SSHORT stuff_itm_slt + 0x2*stuff stuff_slt_ref
    PATCH_IF stuff_slt_ref = "-1" BEGIN
      WRITE_SHORT stuff_itm_slt + 0x2*stuff stuff_num_itm
      stuff = 37
    END
  END
END

DEFINE_ACTION_MACRO flir_removal_stuff_cre BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME "%cre%.cre" BEGIN
    COPY_EXISTING "%cre%.cre" override
      LPM flir_removal_stuff_cre_patch
    BUT_ONLY
  END ELSE BEGIN
    COPY "override/%cre%.cre" "override"
      LPM flir_removal_stuff_cre_patch
    BUT_ONLY
  END
END

DEFINE_PATCH_MACRO flir_source_decl_make_key BEGIN
  PATCH_IF "%ident%" STRING_COMPARE_CASE "x" BEGIN
    SPRINT flir_source_decl_key "ident:%ident%"
  END ELSE BEGIN
    SPRINT flir_source_decl_key "anon:%tier%:%token%:%item%:%flir_source_decl_count%"
  END
END

DEFINE_PATCH_MACRO flir_source_decl_derive_kind BEGIN
  PATCH_IF "%source_kind%" STRING_EQUAL_CASE "auto"
        OR "%source_kind%" STRING_EQUAL_CASE "none"
        OR "%source_kind%" STRING_EQUAL_CASE "blank"
        OR "%source_kind%" STRING_EQUAL_CASE "" BEGIN
    PATCH_IF "%source%" STRING_EQUAL_CASE "blank" BEGIN
      SPRINT source_kind "virtual"
      PATCH_IF "%object_or_slot%" STRING_EQUAL_CASE "*"
            OR "%object_or_slot%" STRING_EQUAL_CASE "none"
            OR "%object_or_slot%" STRING_EQUAL_CASE "" BEGIN
        SPRINT object_or_slot "legacy_blank"
      END
      PATCH_IF "%virtual_policy%" STRING_EQUAL_CASE "none"
            OR "%virtual_policy%" STRING_EQUAL_CASE "" BEGIN
        SPRINT virtual_policy "legacy_blank"
      END
    END ELSE PATCH_IF "%source%" STRING_MATCHES_REGEXP ".*\.are$" = 0 BEGIN
      SPRINT source_kind "area_container"
    END ELSE PATCH_IF "%source%" STRING_MATCHES_REGEXP ".*\.cre$" = 0 BEGIN
      SPRINT source_kind "cre_inventory"
    END ELSE PATCH_IF "%source%" STRING_MATCHES_REGEXP ".*\.sto$" = 0 BEGIN
      SPRINT source_kind "store"
    END ELSE PATCH_IF "%source%" STRING_MATCHES_REGEXP ".*\.bcs$" = 0 BEGIN
      SPRINT source_kind "script"
    END ELSE BEGIN
      SPRINT source_kind "legacy_adapter"
    END
  END
  PATCH_IF "%object_or_slot%" STRING_EQUAL_CASE "none"
        OR "%object_or_slot%" STRING_EQUAL_CASE "" BEGIN
    SPRINT object_or_slot "*"
  END
  PATCH_IF "%virtual_policy%" STRING_EQUAL_CASE "none" BEGIN
    SPRINT virtual_policy ""
  END
END

DEFINE_PATCH_MACRO flir_source_decl_store_current BEGIN
  PATCH_IF !VARIABLE_IS_SET match_policy
        OR "%match_policy%" STRING_EQUAL_CASE "" BEGIN
    SPRINT match_policy "single"
  END
  PATCH_IF !VARIABLE_IS_SET expected_matches BEGIN
    SET expected_matches = 1
  END
  LPM flir_source_decl_make_key
  LPM flir_source_decl_derive_kind

  PATCH_IF "%flir_source_decl_update_mode%" STRING_EQUAL_CASE "replace" BEGIN
    PATCH_IF !VARIABLE_IS_SET $flir_source_decl_exists("%flir_source_decl_key%") BEGIN
      PATCH_FAIL ~FLIR_REMOVAL_ERR HOOK_REPLACE_MISSING tier=%tier% token=%token% ident=%ident%~
    END
  END ELSE BEGIN
    PATCH_IF VARIABLE_IS_SET $flir_source_decl_exists("%flir_source_decl_key%") BEGIN
      PATCH_FAIL ~FLIR_REMOVAL_ERR HOOK_DUPLICATE tier=%tier% token=%token% ident=%ident%~
    END
    SET flir_source_decl_count += 1
    SPRINT $flir_source_decl_order("%flir_source_decl_count%") "%flir_source_decl_key%"
  END

  // Raw rows retain the campaign-local tier array that was active while their
  // source list was staged. Extension replacements keep that ownership; a new
  // row must name a tier already owned by exactly one campaign until the public
  // catalog grows an explicit campaign field.
  SPRINT flir_source_decl_row_tier_hook "%tier_hook%"
  PATCH_IF "%flir_source_decl_update_mode%" STRING_EQUAL_CASE "replace"
        AND VARIABLE_IS_SET $flir_source_decl_tier_hook("%flir_source_decl_key%") BEGIN
    SPRINT flir_source_decl_row_tier_hook $flir_source_decl_tier_hook("%flir_source_decl_key%")
  END ELSE PATCH_IF flir_source_extension_active = 1 BEGIN
    SET flir_source_decl_bg1_tier = 0
    SET flir_source_decl_bg2_tier = 0
    PATCH_IF VARIABLE_IS_SET $bg1_tiers("%tier%") BEGIN
      SET flir_source_decl_bg1_tier = 1
    END
    PATCH_IF VARIABLE_IS_SET $bg2_tiers("%tier%") BEGIN
      SET flir_source_decl_bg2_tier = 1
    END
    PATCH_IF flir_source_decl_bg1_tier + flir_source_decl_bg2_tier != 1 BEGIN
      PATCH_FAIL ~FLIR_REMOVAL_ERR HOOK_CAMPAIGN_TIER tier=%tier% token=%token% ident=%ident%~
    END ELSE PATCH_IF flir_source_decl_bg1_tier = 1 BEGIN
      SPRINT flir_source_decl_row_tier_hook "bg1_tiers"
    END ELSE BEGIN
      SPRINT flir_source_decl_row_tier_hook "bg2_tiers"
    END
  END
  PATCH_IF flir_source_extension_active = 1
        AND "%flir_source_decl_update_mode%" STRING_EQUAL_CASE "replace" BEGIN
    SET flir_source_decl_bg1_tier = 0
    SET flir_source_decl_bg2_tier = 0
    PATCH_IF VARIABLE_IS_SET $bg1_tiers("%tier%") BEGIN
      SET flir_source_decl_bg1_tier = 1
    END
    PATCH_IF VARIABLE_IS_SET $bg2_tiers("%tier%") BEGIN
      SET flir_source_decl_bg2_tier = 1
    END
    PATCH_IF "%flir_source_decl_row_tier_hook%" STRING_EQUAL_CASE "bg1_tiers" BEGIN
      PATCH_IF flir_source_decl_bg1_tier != 1 OR flir_source_decl_bg2_tier != 0 BEGIN
        PATCH_FAIL ~FLIR_REMOVAL_ERR HOOK_CAMPAIGN_TIER tier=%tier% token=%token% ident=%ident%~
      END
    END ELSE PATCH_IF "%flir_source_decl_row_tier_hook%" STRING_EQUAL_CASE "bg2_tiers" BEGIN
      PATCH_IF flir_source_decl_bg2_tier != 1 OR flir_source_decl_bg1_tier != 0 BEGIN
        PATCH_FAIL ~FLIR_REMOVAL_ERR HOOK_CAMPAIGN_TIER tier=%tier% token=%token% ident=%ident%~
      END
    END
  END
  PATCH_IF "%flir_source_decl_row_tier_hook%" STRING_EQUAL_CASE "" BEGIN
    PATCH_FAIL ~FLIR_REMOVAL_ERR SOURCE_CAMPAIGN_MISSING tier=%tier% token=%token% ident=%ident%~
  END

  SPRINT $flir_source_decl_exists("%flir_source_decl_key%") "1"
  SPRINT $flir_source_decl_enabled("%flir_source_decl_key%") "%flir_source_decl_enabled_value%"
  SPRINT $flir_source_decl_item("%flir_source_decl_key%") "%item%"
  SPRINT $flir_source_decl_replacement("%flir_source_decl_key%") "%replacement%"
  SPRINT $flir_source_decl_source("%flir_source_decl_key%") "%source%"
  SPRINT $flir_source_decl_tier("%flir_source_decl_key%") "%tier%"
  SPRINT $flir_source_decl_token("%flir_source_decl_key%") "%token%"
  SPRINT $flir_source_decl_ident("%flir_source_decl_key%") "%ident%"
  SPRINT $flir_source_decl_chance("%flir_source_decl_key%") "%chance%"
  SPRINT $flir_source_decl_source_kind("%flir_source_decl_key%") "%source_kind%"
  SPRINT $flir_source_decl_object_or_slot("%flir_source_decl_key%") "%object_or_slot%"
  SPRINT $flir_source_decl_virtual_policy("%flir_source_decl_key%") "%virtual_policy%"
  SPRINT $flir_source_decl_declared_charge1("%flir_source_decl_key%") "%declared_charge1%"
  SPRINT $flir_source_decl_declared_charge2("%flir_source_decl_key%") "%declared_charge2%"
  SPRINT $flir_source_decl_declared_charge3("%flir_source_decl_key%") "%declared_charge3%"
  SPRINT $flir_source_decl_expected_quantity("%flir_source_decl_key%") "%expected_quantity%"
  SPRINT $flir_source_decl_match_policy("%flir_source_decl_key%") "%match_policy%"
  SPRINT $flir_source_decl_expected_matches("%flir_source_decl_key%") "%expected_matches%"
  SPRINT $flir_source_decl_tier_hook("%flir_source_decl_key%") "%flir_source_decl_row_tier_hook%"
END

DEFINE_PATCH_MACRO flir_source_stage1_raw BEGIN
  LOCAL_SPRINT item ""
  LOCAL_SPRINT replacement ""
  LOCAL_SPRINT source ""
  LOCAL_SPRINT tier ""
  LOCAL_SPRINT token ""
  LOCAL_SPRINT ident ""
  LOCAL_SET chance = 100
  LOCAL_SPRINT source_kind "auto"
  LOCAL_SPRINT object_or_slot "*"
  LOCAL_SPRINT virtual_policy ""
  LOCAL_SET declared_charge1 = 0
  LOCAL_SET declared_charge2 = 0
  LOCAL_SET declared_charge3 = 0
  LOCAL_SET expected_quantity = 1
  LOCAL_SPRINT match_policy "single"
  LOCAL_SET expected_matches = 1
  LOCAL_SPRINT flir_source_decl_update_mode "add"
  LOCAL_SPRINT flir_source_decl_enabled_value "1"

  READ_2DA_ENTRIES_NOW cia_file 7
  FOR (i = 1; i < cia_file; ++i) BEGIN
    LPM create_item_array#read_row
    LPM create_item_array#convert_resrefs
    SPRINT source_kind "auto"
    SPRINT object_or_slot "*"
    SPRINT virtual_policy ""
    SET declared_charge1 = 0
    SET declared_charge2 = 0
    SET declared_charge3 = 0
    SET expected_quantity = 1
    SPRINT match_policy "single"
    SET expected_matches = 1
    SPRINT flir_source_decl_update_mode "add"
    SPRINT flir_source_decl_enabled_value "1"
    LPM flir_source_decl_store_current
  END
END

// Checked-in match-policy tables describe the small audited set of authored
// legacy rows whose source legitimately contains more than one matching item
// instance. Apply these defaults before filtering; the later extension hook
// may still replace the complete declaration with the strict single-match
// default.
DEFINE_ACTION_MACRO flir_source_apply_internal_selector_table BEGIN
  ACTION_IF !VARIABLE_IS_SET flir_source_internal_selector_table
        OR "%flir_source_internal_selector_table%" STRING_EQUAL_CASE ""
        OR NOT FILE_EXISTS "%flir_source_internal_selector_table%" BEGIN
    LAF flir_removal_fail STR_VAR code = ~INTERNAL_SELECTOR_TABLE_MISSING~ END
  END

  ACTION_CLEAR_ARRAY flir_source_internal_selector_seen
  COPY - "%flir_source_internal_selector_table%" "flir-removal-read/internal-source-selectors.2da"
    READ_2DA_ENTRIES_NOW flir_source_internal_selector_rows 4
    FOR (i = 1; i < flir_source_internal_selector_rows; ++i) BEGIN
      READ_2DA_ENTRY_FORMER flir_source_internal_selector_rows i 0 flir_source_internal_selector_ident
      READ_2DA_ENTRY_FORMER flir_source_internal_selector_rows i 1 flir_source_internal_selector_value
      READ_2DA_ENTRY_FORMER flir_source_internal_selector_rows i 2 flir_source_internal_match_policy
      READ_2DA_ENTRY_FORMER flir_source_internal_selector_rows i 3 flir_source_internal_expected_matches
      TO_LOWER flir_source_internal_selector_ident
      TO_LOWER flir_source_internal_selector_value
      TO_LOWER flir_source_internal_match_policy
      INNER_PATCH_SAVE flir_source_internal_selector_value "%flir_source_internal_selector_value%" BEGIN
        REPLACE_TEXTUALLY " " ""
      END

      PATCH_IF "%flir_source_internal_selector_ident%" STRING_EQUAL_CASE ""
            OR "%flir_source_internal_selector_ident%" STRING_EQUAL_CASE "x" BEGIN
        PATCH_FAIL ~FLIR_REMOVAL_ERR INTERNAL_SELECTOR_TARGET tier= token= ident=%flir_source_internal_selector_ident%~
      END
      PATCH_IF "%flir_source_internal_selector_ident%" STRING_MATCHES_REGEXP "^[a-z0-9_.:-]+$" != 0
            OR "%flir_source_internal_selector_value%" STRING_MATCHES_REGEXP "^[a-z0-9_.:*-]+$" != 0 BEGIN
        PATCH_FAIL ~FLIR_REMOVAL_ERR INTERNAL_SELECTOR_FORMAT tier= token= ident=%flir_source_internal_selector_ident%~
      END
      PATCH_IF VARIABLE_IS_SET $flir_source_internal_selector_seen("%flir_source_internal_selector_ident%") BEGIN
        PATCH_FAIL ~FLIR_REMOVAL_ERR INTERNAL_SELECTOR_DUPLICATE tier= token= ident=%flir_source_internal_selector_ident%~
      END
      SPRINT $flir_source_internal_selector_seen("%flir_source_internal_selector_ident%") "1"

      PATCH_IF "%flir_source_internal_expected_matches%" STRING_MATCHES_REGEXP "^[0-9]+$" != 0 BEGIN
        PATCH_FAIL ~FLIR_REMOVAL_ERR INTERNAL_MATCH_COUNT tier= token= ident=%flir_source_internal_selector_ident%~
      END
      SET flir_source_internal_expected_matches_value = flir_source_internal_expected_matches

      SPRINT flir_source_internal_selector_key "ident:%flir_source_internal_selector_ident%"
      PATCH_IF !VARIABLE_IS_SET $flir_source_decl_exists("%flir_source_internal_selector_key%") BEGIN
        PATCH_FAIL ~FLIR_REMOVAL_ERR INTERNAL_SELECTOR_TARGET tier= token= ident=%flir_source_internal_selector_ident%~
      END
      PATCH_IF "%flir_source_internal_match_policy%" STRING_EQUAL_CASE "single" BEGIN
        PATCH_IF "%flir_source_internal_selector_value%" STRING_EQUAL_CASE ""
              OR "%flir_source_internal_selector_value%" STRING_EQUAL_CASE "*"
              OR "%flir_source_internal_selector_value%" STRING_EQUAL_CASE "any"
              OR "%flir_source_internal_selector_value%" STRING_EQUAL_CASE "none" BEGIN
          PATCH_FAIL ~FLIR_REMOVAL_ERR INTERNAL_SELECTOR_EMPTY tier= token= ident=%flir_source_internal_selector_ident%~
        END
        PATCH_IF flir_source_internal_expected_matches_value != 1 BEGIN
          PATCH_FAIL ~FLIR_REMOVAL_ERR INTERNAL_MATCH_COUNT tier= token= ident=%flir_source_internal_selector_ident%~
        END
      END ELSE PATCH_IF "%flir_source_internal_match_policy%" STRING_EQUAL_CASE "all_one_unit" BEGIN
        PATCH_IF flir_source_internal_expected_matches_value < 2 BEGIN
          PATCH_FAIL ~FLIR_REMOVAL_ERR INTERNAL_MATCH_COUNT tier= token= ident=%flir_source_internal_selector_ident%~
        END
        PATCH_IF NOT ("%flir_source_internal_selector_value%" STRING_EQUAL_CASE "*")
              AND NOT ("%flir_source_internal_selector_value%" STRING_EQUAL_CASE "any") BEGIN
          PATCH_FAIL ~FLIR_REMOVAL_ERR INTERNAL_MATCH_SELECTOR tier= token= ident=%flir_source_internal_selector_ident%~
        END
        SPRINT flir_source_internal_kind $flir_source_decl_source_kind("%flir_source_internal_selector_key%")
        PATCH_IF NOT ("%flir_source_internal_kind%" STRING_EQUAL_CASE "cre_inventory") BEGIN
          PATCH_FAIL ~FLIR_REMOVAL_ERR MATCH_POLICY_KIND tier= token= ident=%flir_source_internal_selector_ident%~
        END
        SPRINT flir_source_internal_selector_value "*"
      END ELSE BEGIN
        PATCH_FAIL ~FLIR_REMOVAL_ERR INTERNAL_MATCH_POLICY tier= token= ident=%flir_source_internal_selector_ident%~
      END
      SPRINT $flir_source_decl_object_or_slot("%flir_source_internal_selector_key%") "%flir_source_internal_selector_value%"
      SPRINT $flir_source_decl_match_policy("%flir_source_internal_selector_key%") "%flir_source_internal_match_policy%"
      SPRINT $flir_source_decl_expected_matches("%flir_source_internal_selector_key%") "%flir_source_internal_expected_matches_value%"
    END
END

DEFINE_ACTION_MACRO flir_source_apply_extension_hook BEGIN
  ACTION_IF VARIABLE_IS_SET flir_source_extension_fixture
        AND FILE_EXISTS "%flir_source_extension_fixture%" BEGIN
    OUTER_SET flir_source_extension_active = 1
    COPY - "%flir_source_extension_fixture%" "flir-removal-read/source-extension.2da"
      READ_2DA_ENTRIES_NOW flir_source_extension_rows 15
      FOR (i = 1; i < flir_source_extension_rows; ++i) BEGIN
        READ_2DA_ENTRY_FORMER flir_source_extension_rows i 0 flir_source_extension_op
        READ_2DA_ENTRY_FORMER flir_source_extension_rows i 1 item
        READ_2DA_ENTRY_FORMER flir_source_extension_rows i 2 replacement
        READ_2DA_ENTRY_FORMER flir_source_extension_rows i 3 source
        READ_2DA_ENTRY_FORMER flir_source_extension_rows i 4 tier
        READ_2DA_ENTRY_FORMER flir_source_extension_rows i 5 token
        READ_2DA_ENTRY_FORMER flir_source_extension_rows i 6 ident
        READ_2DA_ENTRY_FORMER flir_source_extension_rows i 7 chance
        READ_2DA_ENTRY_FORMER flir_source_extension_rows i 8 source_kind
        READ_2DA_ENTRY_FORMER flir_source_extension_rows i 9 object_or_slot
        READ_2DA_ENTRY_FORMER flir_source_extension_rows i 10 virtual_policy
        READ_2DA_ENTRY_FORMER flir_source_extension_rows i 11 declared_charge1
        READ_2DA_ENTRY_FORMER flir_source_extension_rows i 12 declared_charge2
        READ_2DA_ENTRY_FORMER flir_source_extension_rows i 13 declared_charge3
        READ_2DA_ENTRY_FORMER flir_source_extension_rows i 14 expected_quantity
        TO_LOWER flir_source_extension_op
        TO_LOWER item
        TO_LOWER replacement
        TO_LOWER source
        TO_LOWER tier
        TO_LOWER token
        TO_LOWER ident
        TO_LOWER source_kind
        TO_LOWER object_or_slot
        TO_LOWER virtual_policy
        SPRINT match_policy "single"
        SET expected_matches = 1
        SPRINT flir_source_decl_enabled_value "1"
        PATCH_IF "%flir_source_extension_op%" STRING_EQUAL_CASE "replace" BEGIN
          SPRINT flir_source_decl_update_mode "replace"
          LPM flir_source_decl_store_current
        END ELSE PATCH_IF "%flir_source_extension_op%" STRING_EQUAL_CASE "add" BEGIN
          SPRINT flir_source_decl_update_mode "add"
          LPM flir_source_decl_store_current
        END ELSE PATCH_IF "%flir_source_extension_op%" STRING_EQUAL_CASE "disable" BEGIN
          SPRINT flir_source_decl_update_mode "replace"
          SPRINT flir_source_decl_enabled_value "0"
          LPM flir_source_decl_store_current
        END ELSE BEGIN
          PATCH_FAIL ~FLIR_REMOVAL_ERR HOOK_OPERATION tier=%tier% token=%token% ident=%ident%~
        END
      END
    OUTER_SET flir_source_extension_active = 0
  END
END

DEFINE_ACTION_MACRO flir_source_build_filter_signature BEGIN
  OUTER_SPRINT flir_source_filter_signature ~%flir_source_enabled%|%item%|%source%|%tier%|%ident%|%chance%|%flir_filter_allow_override_availability%|%RandomNotRandom%~
END

DEFINE_ACTION_MACRO flir_source_legacy_snapshot_reset BEGIN
  OUTER_SET flir_source_legacy_snapshot_initialized = 0
  OUTER_SET flir_source_legacy_cursor = 0
  ACTION_CLEAR_ARRAY flir_registry_legacy_ident_filter
  ACTION_CLEAR_ARRAY flir_source_legacy_filter_signature
  ACTION_CLEAR_ARRAY flir_source_legacy_filter_skip
  ACTION_CLEAR_ARRAY flir_source_legacy_stage1
  ACTION_CLEAR_ARRAY flir_source_legacy_item_array
  ACTION_CLEAR_ARRAY flir_source_legacy_row_key
  ACTION_CLEAR_ARRAY flir_source_legacy_decl_source_kind
  ACTION_CLEAR_ARRAY flir_source_legacy_decl_object_or_slot
  ACTION_CLEAR_ARRAY flir_source_legacy_decl_virtual_policy
  ACTION_CLEAR_ARRAY flir_source_legacy_decl_declared_charge1
  ACTION_CLEAR_ARRAY flir_source_legacy_decl_declared_charge2
  ACTION_CLEAR_ARRAY flir_source_legacy_decl_declared_charge3
  ACTION_CLEAR_ARRAY flir_source_legacy_decl_expected_quantity
  ACTION_CLEAR_ARRAY flir_source_legacy_decl_match_policy
  ACTION_CLEAR_ARRAY flir_source_legacy_decl_expected_matches
END

DEFINE_ACTION_MACRO flir_source_filter_stage1 BEGIN
  LAM flir_source_prepare_birth_identities
  OUTER_FOR (flir_source_i = 1; flir_source_i <= flir_source_decl_count; ++flir_source_i) BEGIN
    ACTION_IF VARIABLE_IS_SET $flir_source_decl_order("%flir_source_i%") BEGIN
      OUTER_SPRINT flir_source_key $flir_source_decl_order("%flir_source_i%")
      OUTER_SPRINT item $flir_source_decl_item("%flir_source_key%")
      OUTER_SPRINT replacement $flir_source_decl_replacement("%flir_source_key%")
      OUTER_SPRINT source $flir_source_decl_source("%flir_source_key%")
      OUTER_SPRINT tier $flir_source_decl_tier("%flir_source_key%")
      OUTER_SPRINT token $flir_source_decl_token("%flir_source_key%")
      OUTER_SPRINT ident $flir_source_decl_ident("%flir_source_key%")
      OUTER_SET chance = $flir_source_decl_chance("%flir_source_key%")
      OUTER_SET flir_source_enabled = $flir_source_decl_enabled("%flir_source_key%")
      OUTER_SPRINT flir_source_row_tier_hook ~%tier_hook%~
      ACTION_IF VARIABLE_IS_SET $flir_source_decl_tier_hook("%flir_source_key%") BEGIN
        OUTER_SPRINT flir_source_row_tier_hook $flir_source_decl_tier_hook("%flir_source_key%")
      END
      OUTER_SET flir_filter_allow_override_availability = 0
      ACTION_IF VARIABLE_IS_SET flir_source_allow_override_availability BEGIN
        OUTER_SET flir_filter_allow_override_availability = flir_source_allow_override_availability
      END
      LAM flir_source_build_filter_signature

      ACTION_IF flir_source_enabled = 0 BEGIN
        ACTION_IF "%ident%" STRING_COMPARE_CASE "x" BEGIN
          OUTER_SPRINT $ident_filter("%ident%") ""
        END
      END ELSE BEGIN
        OUTER_SET flir_source_use_cached_filter = 0
        ACTION_IF VARIABLE_IS_SET $flir_source_legacy_filter_signature("%flir_source_key%") BEGIN
          OUTER_SPRINT flir_source_cached_signature $flir_source_legacy_filter_signature("%flir_source_key%")
          ACTION_IF "%flir_source_cached_signature%" STRING_EQUAL "%flir_source_filter_signature%" BEGIN
            OUTER_SET flir_source_use_cached_filter = 1
            OUTER_SET skip = $flir_source_legacy_filter_skip("%flir_source_key%")
          END
        END
        ACTION_IF flir_source_use_cached_filter = 0 BEGIN
          OUTER_PATCH "" BEGIN
            LPF create_item_array#stage1#filter
              INT_VAR
                global_chance = RandomNotRandom
                chance
                allow_override_availability = flir_filter_allow_override_availability
              STR_VAR
                item source tier ident
              RET
                skip
                skip_reason
            END
          END
        END
        ACTION_IF skip BEGIN
          ACTION_IF "%ident%" STRING_COMPARE_CASE "x" BEGIN
            OUTER_SPRINT $ident_filter("%ident%") ""
          END
        END ELSE BEGIN
          ACTION_IF "%ident%" STRING_COMPARE_CASE "x" BEGIN
            OUTER_SPRINT $identitem("%ident%") "%item%"
          END
          OUTER_SPRINT $item_array#stage1("%item%" "%replacement%" "%source%" "%tier%" "%token%" "%ident%") ""
          OUTER_SPRINT flir_source_unbalanced_tier ~%tier%~
          OUTER_SPRINT flir_source_unbalanced_token ~%token%~
          LAM create_item_array#rebalance
          ACTION_IF VARIABLE_IS_SET $flir_source_current_row_key("%item%" "%replacement%" "%source%" "%tier%" "%token%" "%ident%") BEGIN
            OUTER_SPRINT flir_source_existing_row_key $flir_source_current_row_key("%item%" "%replacement%" "%source%" "%tier%" "%token%" "%ident%")
            ACTION_IF NOT ("%flir_source_existing_row_key%" STRING_EQUAL "%flir_source_key%") BEGIN
              LAF flir_removal_fail STR_VAR code = ~ROW_IDENTITY_COLLISION~ tier = EVAL ~%tier%~ token = EVAL ~%token%~ ident = EVAL ~%ident%~ END
            END
          END ELSE BEGIN
            OUTER_SPRINT $flir_source_current_row_key("%item%" "%replacement%" "%source%" "%tier%" "%token%" "%ident%") ~%flir_source_key%~
          END
          OUTER_SPRINT tier ~%flir_source_unbalanced_tier%~
          OUTER_SPRINT token ~%flir_source_unbalanced_token%~
          OUTER_SPRINT $EVAL "%flir_source_row_tier_hook%"("%tier%") ""
        END
      END
    END
  END
END

// Every Mode 1 origin consumes base-item filter RNG at the historical
// per-campaign seam, before that campaign's location rows. Cache those neutral
// decisions for the current tail; only preserve installs build migration-only
// snapshots. Keep both paths out of shared ident_filter until the tail so
// extensions can still replace or re-enable rows.
DEFINE_ACTION_MACRO flir_source_filter_stage1_legacy_ident_filter BEGIN
  LAM flir_source_prepare_birth_identities
  ACTION_IF flir_source_legacy_snapshot_initialized = 0 BEGIN
    LAM flir_source_legacy_snapshot_reset
    OUTER_SET flir_source_legacy_snapshot_initialized = 1
    ACTION_IF "%Preserve%" STRING_EQUAL_CASE "y" BEGIN
      ACTION_PHP_EACH ident_filter AS flir_source_legacy_ident => blank BEGIN
        OUTER_SPRINT $flir_registry_legacy_ident_filter("%flir_source_legacy_ident%") ~~
      END
    END
  END
  OUTER_FOR (flir_source_i = flir_source_legacy_cursor + 1; flir_source_i <= flir_source_decl_count; ++flir_source_i) BEGIN
    ACTION_IF VARIABLE_IS_SET $flir_source_decl_order("%flir_source_i%") BEGIN
        OUTER_SPRINT flir_source_key $flir_source_decl_order("%flir_source_i%")
        OUTER_SPRINT item $flir_source_decl_item("%flir_source_key%")
        OUTER_SPRINT replacement $flir_source_decl_replacement("%flir_source_key%")
        OUTER_SPRINT source $flir_source_decl_source("%flir_source_key%")
        OUTER_SPRINT tier $flir_source_decl_tier("%flir_source_key%")
        OUTER_SPRINT token $flir_source_decl_token("%flir_source_key%")
        OUTER_SPRINT ident $flir_source_decl_ident("%flir_source_key%")
        OUTER_SET chance = $flir_source_decl_chance("%flir_source_key%")
        OUTER_SET flir_source_enabled = $flir_source_decl_enabled("%flir_source_key%")
        OUTER_SPRINT flir_source_row_tier_hook ~%tier_hook%~
        ACTION_IF VARIABLE_IS_SET $flir_source_decl_tier_hook("%flir_source_key%") BEGIN
          OUTER_SPRINT flir_source_row_tier_hook $flir_source_decl_tier_hook("%flir_source_key%")
        END
        OUTER_SET flir_filter_allow_override_availability = 0
        ACTION_IF VARIABLE_IS_SET flir_source_allow_override_availability BEGIN
          OUTER_SET flir_filter_allow_override_availability = flir_source_allow_override_availability
        END
        LAM flir_source_build_filter_signature
        OUTER_SET skip = 0

        ACTION_IF flir_source_enabled = 0 BEGIN
          OUTER_SET skip = 1
        END ELSE BEGIN
          OUTER_PATCH "" BEGIN
            LPF create_item_array#stage1#filter
              INT_VAR
                global_chance = RandomNotRandom
                chance
                allow_override_availability = flir_filter_allow_override_availability
              STR_VAR
                item source tier ident
              RET
                skip
                skip_reason
            END
          END
        END
        OUTER_SPRINT $flir_source_legacy_filter_signature("%flir_source_key%") ~%flir_source_filter_signature%~
        OUTER_SPRINT $flir_source_legacy_filter_skip("%flir_source_key%") ~%skip%~
        ACTION_IF "%Preserve%" STRING_EQUAL_CASE "y" BEGIN
          ACTION_IF skip AND "%ident%" STRING_COMPARE_CASE "x" BEGIN
            OUTER_SPRINT $flir_registry_legacy_ident_filter("%ident%") ~~
          END ELSE ACTION_IF skip = 0 BEGIN
            OUTER_SPRINT $flir_source_legacy_stage1("%item%" "%replacement%" "%source%" "%tier%" "%token%" "%ident%") ~%flir_source_key%~
            OUTER_SPRINT $EVAL "%flir_source_row_tier_hook%"("%tier%") ""
            OUTER_SPRINT $flir_source_legacy_decl_source_kind("%flir_source_key%") ~auto~
            OUTER_SPRINT $flir_source_legacy_decl_object_or_slot("%flir_source_key%") ~*~
            OUTER_SPRINT $flir_source_legacy_decl_virtual_policy("%flir_source_key%") ~~
            OUTER_SET $flir_source_legacy_decl_declared_charge1("%flir_source_key%") = 0
            OUTER_SET $flir_source_legacy_decl_declared_charge2("%flir_source_key%") = 0
            OUTER_SET $flir_source_legacy_decl_declared_charge3("%flir_source_key%") = 0
            OUTER_SET $flir_source_legacy_decl_expected_quantity("%flir_source_key%") = 1
            OUTER_SPRINT $flir_source_legacy_decl_match_policy("%flir_source_key%") ~single~
            OUTER_SET $flir_source_legacy_decl_expected_matches("%flir_source_key%") = 1
            ACTION_IF VARIABLE_IS_SET $flir_source_decl_source_kind("%flir_source_key%") BEGIN
              OUTER_SPRINT $flir_source_legacy_decl_source_kind("%flir_source_key%") $flir_source_decl_source_kind("%flir_source_key%")
            END
            ACTION_IF VARIABLE_IS_SET $flir_source_decl_object_or_slot("%flir_source_key%") BEGIN
              OUTER_SPRINT $flir_source_legacy_decl_object_or_slot("%flir_source_key%") $flir_source_decl_object_or_slot("%flir_source_key%")
            END
            ACTION_IF VARIABLE_IS_SET $flir_source_decl_virtual_policy("%flir_source_key%") BEGIN
              OUTER_SPRINT $flir_source_legacy_decl_virtual_policy("%flir_source_key%") $flir_source_decl_virtual_policy("%flir_source_key%")
            END
            ACTION_IF VARIABLE_IS_SET $flir_source_decl_declared_charge1("%flir_source_key%") BEGIN
              OUTER_SET $flir_source_legacy_decl_declared_charge1("%flir_source_key%") = $flir_source_decl_declared_charge1("%flir_source_key%")
            END
            ACTION_IF VARIABLE_IS_SET $flir_source_decl_declared_charge2("%flir_source_key%") BEGIN
              OUTER_SET $flir_source_legacy_decl_declared_charge2("%flir_source_key%") = $flir_source_decl_declared_charge2("%flir_source_key%")
            END
            ACTION_IF VARIABLE_IS_SET $flir_source_decl_declared_charge3("%flir_source_key%") BEGIN
              OUTER_SET $flir_source_legacy_decl_declared_charge3("%flir_source_key%") = $flir_source_decl_declared_charge3("%flir_source_key%")
            END
            ACTION_IF VARIABLE_IS_SET $flir_source_decl_expected_quantity("%flir_source_key%") BEGIN
              OUTER_SET $flir_source_legacy_decl_expected_quantity("%flir_source_key%") = $flir_source_decl_expected_quantity("%flir_source_key%")
            END
            ACTION_IF VARIABLE_IS_SET $flir_source_decl_match_policy("%flir_source_key%") BEGIN
              OUTER_SPRINT $flir_source_legacy_decl_match_policy("%flir_source_key%") $flir_source_decl_match_policy("%flir_source_key%")
            END
            ACTION_IF VARIABLE_IS_SET $flir_source_decl_expected_matches("%flir_source_key%") BEGIN
              OUTER_SET $flir_source_legacy_decl_expected_matches("%flir_source_key%") = $flir_source_decl_expected_matches("%flir_source_key%")
            END
          END
        END
      END
    END
  OUTER_SET flir_source_legacy_cursor = flir_source_decl_count
END

DEFINE_ACTION_MACRO flir_source_finalize_legacy_snapshot BEGIN
  ACTION_IF "%Preserve%" STRING_EQUAL_CASE "y" BEGIN
    ACTION_PHP_EACH ident_filter AS flir_source_legacy_ident => blank BEGIN
      OUTER_SPRINT $flir_registry_legacy_ident_filter("%flir_source_legacy_ident%") ~~
    END
    ACTION_CLEAR_ARRAY flir_source_legacy_item_array
    ACTION_CLEAR_ARRAY flir_source_legacy_row_key
    ACTION_PHP_EACH flir_source_legacy_stage1 AS flir_source_legacy_entry => flir_source_key BEGIN
      OUTER_SPRINT item ~%flir_source_legacy_entry_0%~
      OUTER_SPRINT replacement ~%flir_source_legacy_entry_1%~
      OUTER_SPRINT source ~%flir_source_legacy_entry_2%~
      OUTER_SPRINT tier ~%flir_source_legacy_entry_3%~
      OUTER_SPRINT token ~%flir_source_legacy_entry_4%~
      OUTER_SPRINT ident ~%flir_source_legacy_entry_5%~
      ACTION_IF !VARIABLE_IS_SET $flir_registry_legacy_ident_filter("%ident%") BEGIN
        LAM create_item_array#rebalance
        ACTION_IF VARIABLE_IS_SET $flir_source_legacy_row_key("%item%" "%replacement%" "%source%" "%tier%" "%token%" "%ident%") BEGIN
          OUTER_SPRINT flir_source_existing_row_key $flir_source_legacy_row_key("%item%" "%replacement%" "%source%" "%tier%" "%token%" "%ident%")
          ACTION_IF NOT ("%flir_source_existing_row_key%" STRING_EQUAL "%flir_source_key%") BEGIN
            LAF flir_removal_fail STR_VAR code = ~LEGACY_ROW_IDENTITY_COLLISION~ tier = EVAL ~%tier%~ token = EVAL ~%token%~ ident = EVAL ~%ident%~ END
          END
        END ELSE BEGIN
          OUTER_SPRINT $flir_source_legacy_row_key("%item%" "%replacement%" "%source%" "%tier%" "%token%" "%ident%") ~%flir_source_key%~
          OUTER_SPRINT $flir_source_legacy_item_array("%item%" "%replacement%" "%source%" "%tier%" "%token%" "%ident%") ~~
        END
      END
    END
  END
END

// Some historical integrations add virtual rows directly to item_array after
// authored source staging. Adopt those rows at the exact pre-extension seam:
// they consumed no source-filter RNG, but still need stable identity and
// explicit virtual metadata in both the legacy and current plan views.
DEFINE_ACTION_MACRO flir_source_adopt_direct_virtual_rows BEGIN
  ACTION_IF weidu_action = 0 BEGIN
    ACTION_PHP_EACH item_array AS flir_source_direct => blank BEGIN
      OUTER_SPRINT flir_source_direct_item ~%flir_source_direct_0%~
      OUTER_SPRINT flir_source_direct_replacement ~%flir_source_direct_1%~
      OUTER_SPRINT flir_source_direct_source ~%flir_source_direct_2%~
      OUTER_SPRINT flir_source_direct_tier ~%flir_source_direct_3%~
      OUTER_SPRINT flir_source_direct_token ~%flir_source_direct_4%~
      OUTER_SPRINT flir_source_direct_ident ~%flir_source_direct_5%~
      ACTION_IF "%flir_source_direct_source%" STRING_EQUAL_CASE "blank" BEGIN
        ACTION_IF "%flir_source_direct_ident%" STRING_EQUAL_CASE "x"
              AND "%flir_source_direct_token%" STRING_MATCHES_REGEXP "^[xy][0-9]+$" = 0 BEGIN
          LAF flir_removal_fail STR_VAR code = ~DIRECT_EXTRA_NAMESPACE~ tier = EVAL ~%flir_source_direct_tier%~ token = EVAL ~%flir_source_direct_token%~ ident = EVAL ~%flir_source_direct_ident%~ END
        END
        OUTER_SET flir_source_direct_bg1 = 0
        OUTER_SET flir_source_direct_bg2 = 0
        ACTION_IF VARIABLE_IS_SET $bg1_tiers("%flir_source_direct_tier%") BEGIN
          OUTER_SET flir_source_direct_bg1 = 1
        END
        ACTION_IF VARIABLE_IS_SET $bg2_tiers("%flir_source_direct_tier%") BEGIN
          OUTER_SET flir_source_direct_bg2 = 1
        END
        ACTION_IF flir_source_direct_bg1 + flir_source_direct_bg2 != 1 BEGIN
          LAF flir_removal_fail STR_VAR code = ~SOURCE_CAMPAIGN_MISSING~ tier = EVAL ~%flir_source_direct_tier%~ token = EVAL ~%flir_source_direct_token%~ ident = EVAL ~%flir_source_direct_ident%~ END
        END ELSE ACTION_IF flir_source_direct_bg1 = 1 BEGIN
          OUTER_SPRINT flir_source_direct_campaign ~bg1~
        END ELSE BEGIN
          OUTER_SPRINT flir_source_direct_campaign ~bg2~
        END
        ACTION_IF VARIABLE_IS_SET $flir_source_direct_occurrence("%flir_source_direct_campaign%" "%flir_source_direct_tier%" "%flir_source_direct_item%") BEGIN
          OUTER_SET $flir_source_direct_occurrence("%flir_source_direct_campaign%" "%flir_source_direct_tier%" "%flir_source_direct_item%") += 1
        END ELSE BEGIN
          OUTER_SET $flir_source_direct_occurrence("%flir_source_direct_campaign%" "%flir_source_direct_tier%" "%flir_source_direct_item%") = 1
        END
        OUTER_SET flir_source_direct_occurrence_value = $flir_source_direct_occurrence("%flir_source_direct_campaign%" "%flir_source_direct_tier%" "%flir_source_direct_item%")
        OUTER_SPRINT flir_source_direct_key ~direct:%flir_source_direct_campaign%:%flir_source_direct_tier%:%flir_source_direct_item%:%flir_source_direct_occurrence_value%~
        OUTER_SPRINT flir_source_direct_stable ~legacy:unit-%flir_source_direct_campaign%-%flir_source_direct_tier%-direct-%flir_source_direct_item%-%flir_source_direct_occurrence_value%~

        ACTION_IF VARIABLE_IS_SET $flir_source_current_row_key("%flir_source_direct_item%" "%flir_source_direct_replacement%" "%flir_source_direct_source%" "%flir_source_direct_tier%" "%flir_source_direct_token%" "%flir_source_direct_ident%") BEGIN
          OUTER_SPRINT flir_source_direct_existing $flir_source_current_row_key("%flir_source_direct_item%" "%flir_source_direct_replacement%" "%flir_source_direct_source%" "%flir_source_direct_tier%" "%flir_source_direct_token%" "%flir_source_direct_ident%")
          ACTION_IF NOT ("%flir_source_direct_existing%" STRING_EQUAL "%flir_source_direct_key%") BEGIN
            LAF flir_removal_fail STR_VAR code = ~ROW_IDENTITY_COLLISION~ tier = EVAL ~%flir_source_direct_tier%~ token = EVAL ~%flir_source_direct_token%~ ident = EVAL ~%flir_source_direct_ident%~ END
          END
        END ELSE BEGIN
          OUTER_SPRINT $flir_source_current_row_key("%flir_source_direct_item%" "%flir_source_direct_replacement%" "%flir_source_direct_source%" "%flir_source_direct_tier%" "%flir_source_direct_token%" "%flir_source_direct_ident%") ~%flir_source_direct_key%~
        END
        OUTER_SPRINT $flir_source_decl_source_kind("%flir_source_direct_key%") ~virtual~
        OUTER_SPRINT $flir_source_decl_object_or_slot("%flir_source_direct_key%") ~legacy_blank~
        OUTER_SPRINT $flir_source_decl_virtual_policy("%flir_source_direct_key%") ~legacy_blank~
        OUTER_SET $flir_source_decl_declared_charge1("%flir_source_direct_key%") = 0
        OUTER_SET $flir_source_decl_declared_charge2("%flir_source_direct_key%") = 0
        OUTER_SET $flir_source_decl_declared_charge3("%flir_source_direct_key%") = 0
        OUTER_SET $flir_source_decl_expected_quantity("%flir_source_direct_key%") = 1
        OUTER_SPRINT $flir_source_decl_match_policy("%flir_source_direct_key%") ~single~
        OUTER_SET $flir_source_decl_expected_matches("%flir_source_direct_key%") = 1
        OUTER_SPRINT $flir_source_decl_birth_campaign("%flir_source_direct_key%") ~%flir_source_direct_campaign%~
        OUTER_SPRINT $flir_source_decl_birth_tier("%flir_source_direct_key%") ~%flir_source_direct_tier%~
        OUTER_SPRINT $flir_source_decl_birth_stable("%flir_source_direct_key%") ~%flir_source_direct_stable%~

        ACTION_IF flir_registry_old_unmarked_migration = 1 BEGIN
          OUTER_SPRINT $flir_source_legacy_item_array("%flir_source_direct_item%" "%flir_source_direct_replacement%" "%flir_source_direct_source%" "%flir_source_direct_tier%" "%flir_source_direct_token%" "%flir_source_direct_ident%") ~~
          OUTER_SPRINT $flir_source_legacy_row_key("%flir_source_direct_item%" "%flir_source_direct_replacement%" "%flir_source_direct_source%" "%flir_source_direct_tier%" "%flir_source_direct_token%" "%flir_source_direct_ident%") ~%flir_source_direct_key%~
          OUTER_SPRINT $flir_source_legacy_decl_source_kind("%flir_source_direct_key%") ~virtual~
          OUTER_SPRINT $flir_source_legacy_decl_object_or_slot("%flir_source_direct_key%") ~legacy_blank~
          OUTER_SPRINT $flir_source_legacy_decl_virtual_policy("%flir_source_direct_key%") ~legacy_blank~
          OUTER_SET $flir_source_legacy_decl_declared_charge1("%flir_source_direct_key%") = 0
          OUTER_SET $flir_source_legacy_decl_declared_charge2("%flir_source_direct_key%") = 0
          OUTER_SET $flir_source_legacy_decl_declared_charge3("%flir_source_direct_key%") = 0
          OUTER_SET $flir_source_legacy_decl_expected_quantity("%flir_source_direct_key%") = 1
          OUTER_SPRINT $flir_source_legacy_decl_match_policy("%flir_source_direct_key%") ~single~
          OUTER_SET $flir_source_legacy_decl_expected_matches("%flir_source_direct_key%") = 1
        END
      END
    END
  END
END

DEFINE_ACTION_MACRO flir_removal_plan_reset BEGIN
  OUTER_SET flir_removal_plan_count = 0
  OUTER_SET flir_removal_plan_disabled_count = 0
  OUTER_SET flir_removal_plan_applied_count = 0
  ACTION_CLEAR_ARRAY flir_removal_plan_kind
  ACTION_CLEAR_ARRAY flir_removal_plan_source
  ACTION_CLEAR_ARRAY flir_removal_plan_resource
  ACTION_CLEAR_ARRAY flir_removal_plan_item
  ACTION_CLEAR_ARRAY flir_removal_plan_replacement
  ACTION_CLEAR_ARRAY flir_removal_plan_tier
  ACTION_CLEAR_ARRAY flir_removal_plan_token
  ACTION_CLEAR_ARRAY flir_removal_plan_ident
  ACTION_CLEAR_ARRAY flir_removal_plan_stable
  ACTION_CLEAR_ARRAY flir_removal_plan_record_index
  ACTION_CLEAR_ARRAY flir_removal_plan_record_offset
  ACTION_CLEAR_ARRAY flir_removal_plan_record_size
  ACTION_CLEAR_ARRAY flir_removal_plan_record_hash
  ACTION_CLEAR_ARRAY flir_removal_plan_whole_size
  ACTION_CLEAR_ARRAY flir_removal_plan_whole_hash
  ACTION_CLEAR_ARRAY flir_removal_plan_container
  ACTION_CLEAR_ARRAY flir_removal_plan_slot
  ACTION_CLEAR_ARRAY flir_removal_plan_quantity
  ACTION_CLEAR_ARRAY flir_removal_plan_flags
  ACTION_CLEAR_ARRAY flir_removal_plan_charge1
  ACTION_CLEAR_ARRAY flir_removal_plan_charge2
  ACTION_CLEAR_ARRAY flir_removal_plan_charge3
  ACTION_CLEAR_ARRAY flir_removal_plan_category
  ACTION_CLEAR_ARRAY flir_removal_plan_adapter
  ACTION_CLEAR_ARRAY flir_removal_plan_emit
  ACTION_CLEAR_ARRAY flir_removal_plan_emit_count
  ACTION_CLEAR_ARRAY flir_removal_plan_resource_key
  ACTION_CLEAR_ARRAY flir_removal_plan_applied
  ACTION_CLEAR_ARRAY flir_removal_adapter_post_done
  ACTION_CLEAR_ARRAY flir_removal_item_category
  ACTION_CLEAR_ARRAY flir_removal_item_charge1
  ACTION_CLEAR_ARRAY flir_removal_item_charge2
  ACTION_CLEAR_ARRAY flir_removal_item_charge3
END

DEFINE_ACTION_MACRO flir_removal_plan_load_preserve BEGIN
  ACTION_CLEAR_ARRAY removed_item_array
  ACTION_CLEAR_ARRAY flir_removal_history_array
  ACTION_IF "%Preserve%" STRING_EQUAL_CASE y
        AND NOT FILE_EXISTS_IN_GAME "fl#removeditems.2da"
        AND NOT FILE_EXISTS "override/fl#removeditems.2da" BEGIN
    LAF flir_removal_fail STR_VAR code = ~PRESERVE_STATE_MISSING~ END
  END
  ACTION_IF "%Preserve%" STRING_EQUAL_CASE y
        AND (FILE_EXISTS_IN_GAME "fl#removeditems.2da"
          OR FILE_EXISTS "override/fl#removeditems.2da") BEGIN
    COPY_EXISTING "fl#removeditems.2da" override
      READ_2DA_ENTRIES_NOW r2en_removeditems 3
      FOR (i=1;i<r2en_removeditems;++i) BEGIN
        READ_2DA_ENTRY_FORMER r2en_removeditems i 0 Tier
        READ_2DA_ENTRY_FORMER r2en_removeditems i 1 Token
        READ_2DA_ENTRY_FORMER r2en_removeditems i 2 Ident
        TO_LOWER Tier
        TO_LOWER Token
        TO_LOWER Ident
        SPRINT $removed_item_array("%Tier%" "%Token%" "%Ident%") ""
        SPRINT $flir_removal_history_array("%Tier%" "%Token%" "%Ident%") ""
      END
    BUT_ONLY
  END
END

DEFINE_ACTION_MACRO flir_removal_read_item_metadata BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME "%itm_to_del%.itm" BEGIN
    COPY_EXISTING "%itm_to_del%.itm" override
      READ_SHORT 0x1c flir_item_category ELSE 0
      SET flir_item_charge1 = 0
      SET flir_item_charge2 = 0
      SET flir_item_charge3 = 0
      SET flir_item_charge_counter = 0
      PATCH_IF SOURCE_SIZE > 0x71 BEGIN
        READ_LONG 0x64 flir_item_ability_offset ELSE 0
        READ_SHORT 0x68 flir_item_ability_count ELSE 0
        FOR (flir_item_i = 0; flir_item_i < flir_item_ability_count AND flir_item_i < 3; ++flir_item_i) BEGIN
          SET flir_item_charge_counter += 1
          READ_SHORT (flir_item_ability_offset + 0x38 * flir_item_i + 0x22) "flir_item_charge%flir_item_charge_counter%" ELSE 0
        END
      END
      SPRINT $flir_removal_item_category("%itm_to_del%") "%flir_item_category%"
      SPRINT $flir_removal_item_charge1("%itm_to_del%") "%flir_item_charge1%"
      SPRINT $flir_removal_item_charge2("%itm_to_del%") "%flir_item_charge2%"
      SPRINT $flir_removal_item_charge3("%itm_to_del%") "%flir_item_charge3%"
    BUT_ONLY
  END ELSE BEGIN
    COPY "override/%itm_to_del%.itm" "flir-removal-read/%itm_to_del%.itm"
      READ_SHORT 0x1c flir_item_category ELSE 0
      SET flir_item_charge1 = 0
      SET flir_item_charge2 = 0
      SET flir_item_charge3 = 0
      SET flir_item_charge_counter = 0
      PATCH_IF SOURCE_SIZE > 0x71 BEGIN
        READ_LONG 0x64 flir_item_ability_offset ELSE 0
        READ_SHORT 0x68 flir_item_ability_count ELSE 0
        FOR (flir_item_i = 0; flir_item_i < flir_item_ability_count AND flir_item_i < 3; ++flir_item_i) BEGIN
          SET flir_item_charge_counter += 1
          READ_SHORT (flir_item_ability_offset + 0x38 * flir_item_i + 0x22) "flir_item_charge%flir_item_charge_counter%" ELSE 0
        END
      END
      SPRINT $flir_removal_item_category("%itm_to_del%") "%flir_item_category%"
      SPRINT $flir_removal_item_charge1("%itm_to_del%") "%flir_item_charge1%"
      SPRINT $flir_removal_item_charge2("%itm_to_del%") "%flir_item_charge2%"
      SPRINT $flir_removal_item_charge3("%itm_to_del%") "%flir_item_charge3%"
    BUT_ONLY
  END
END

DEFINE_PATCH_MACRO flir_removal_plan_add_current BEGIN
  SET flir_removal_plan_count += 1
  SPRINT flir_plan_id "%flir_removal_plan_count%"
  SPRINT $flir_removal_plan_kind("%flir_plan_id%") "%flir_plan_kind%"
  SPRINT $flir_removal_plan_source("%flir_plan_id%") "%sourcefile%"
  SPRINT $flir_removal_plan_item("%flir_plan_id%") "%itm_to_del%"
  SPRINT $flir_removal_plan_replacement("%flir_plan_id%") "%replace_itm%"
  SPRINT $flir_removal_plan_tier("%flir_plan_id%") "%removed_tier%"
  SPRINT $flir_removal_plan_token("%flir_plan_id%") "%removed_token%"
  SPRINT $flir_removal_plan_ident("%flir_plan_id%") "%removed_ident%"
  SPRINT $flir_removal_plan_stable("%flir_plan_id%") "%flir_plan_stable%"
  SPRINT $flir_removal_plan_record_index("%flir_plan_id%") "%flir_record_index%"
  SPRINT $flir_removal_plan_record_offset("%flir_plan_id%") "%flir_record_offset%"
  SPRINT $flir_removal_plan_record_size("%flir_plan_id%") "%flir_record_size%"
  SPRINT $flir_removal_plan_record_hash("%flir_plan_id%") "%flir_record_hash%"
  SET flir_buffer_length = BUFFER_LENGTH
  SPRINT $flir_removal_plan_whole_size("%flir_plan_id%") "%flir_buffer_length%"
  SPRINT $flir_removal_plan_whole_hash("%flir_plan_id%") "%flir_whole_hash%"
  SPRINT $flir_removal_plan_container("%flir_plan_id%") "%flir_container_identity%"
  SPRINT $flir_removal_plan_slot("%flir_plan_id%") "%flir_slot_identity%"
  SPRINT $flir_removal_plan_quantity("%flir_plan_id%") "%flir_quantity%"
  SPRINT $flir_removal_plan_flags("%flir_plan_id%") "%flir_flags%"
  SPRINT $flir_removal_plan_charge1("%flir_plan_id%") "%flir_charge1%"
  SPRINT $flir_removal_plan_charge2("%flir_plan_id%") "%flir_charge2%"
  SPRINT $flir_removal_plan_charge3("%flir_plan_id%") "%flir_charge3%"
  SPRINT $flir_removal_plan_category("%flir_plan_id%") "%flir_category%"
  SPRINT $flir_removal_plan_adapter("%flir_plan_id%") "%flir_plan_adapter%"
  PATCH_IF flir_emit_unit = 1 BEGIN
    SET flir_plan_emit_count = 1
    PATCH_IF "%flir_plan_kind%" STRING_EQUAL_CASE "store" AND flir_quantity > 1 BEGIN
      SET flir_plan_emit_count = flir_quantity
    END ELSE PATCH_IF (flir_category = 9 OR flir_category = 11) AND flir_charge1 > 1 BEGIN
      SET flir_plan_emit_count = flir_charge1
    END
  END ELSE BEGIN
    SET flir_plan_emit_count = 0
  END
  SPRINT $flir_removal_plan_emit("%flir_plan_id%") "%flir_emit_unit%"
  SPRINT $flir_removal_plan_emit_count("%flir_plan_id%") "%flir_plan_emit_count%"
  PATCH_IF "%flir_plan_kind%" STRING_COMPARE_CASE "virtual"
        AND "%flir_plan_kind%" STRING_COMPARE_CASE "script" BEGIN
    SPRINT $flir_removal_plan_resource_key("%flir_plan_kind%" "%sourcefile%") ""
  END
END

DEFINE_PATCH_MACRO flir_removal_scan_cre BEGIN
  LPF flir_removal_hash_buffer RET flir_whole_hash = hash END
  READ_LONG 0x2b8 flir_cre_slots_off ELSE 0
  READ_LONG 0x2bc flir_cre_items_off ELSE 0
  READ_LONG 0x2c0 flir_cre_items_count ELSE 0
  SET flir_match_count = 0
  SET flir_group_signature_set = 0
  FOR (flir_i = 0; flir_i < flir_cre_items_count; ++flir_i) BEGIN
    READ_ASCII (flir_cre_items_off + 0x14 * flir_i) flir_candidate ELSE blank
    PATCH_IF "%flir_candidate%" STRING_EQUAL_CASE "%itm_to_del%" BEGIN
      SET flir_slot_ok = 1
      SPRINT flir_slot_identity "*"
      PATCH_IF "%flir_object_or_slot%" STRING_MATCHES_REGEXP "^slot[:0-9]" = 0 BEGIN
        SET flir_slot_wanted = 0
        INNER_PATCH_SAVE flir_slot_text "%flir_object_or_slot%" BEGIN
          REPLACE_TEXTUALLY CASE_INSENSITIVE "slot:" ""
          REPLACE_TEXTUALLY CASE_INSENSITIVE "slot" ""
        END
        SET flir_slot_wanted = flir_slot_text
        SET flir_slot_ok = 0
      END
      FOR (flir_slot = 0; flir_slot < 37; ++flir_slot) BEGIN
        READ_SHORT (flir_cre_slots_off + 2 * flir_slot) flir_slot_ref ELSE 0xffff
        PATCH_IF flir_slot_ref = flir_i BEGIN
          SPRINT flir_slot_identity "slot:%flir_slot%"
          PATCH_IF "%flir_object_or_slot%" STRING_MATCHES_REGEXP "^slot[:0-9]" = 0
                AND flir_slot = flir_slot_wanted BEGIN
            SET flir_slot_ok = 1
          END
        END
      END
      PATCH_IF flir_slot_ok = 1 BEGIN
        SET flir_match_count += 1
        SET flir_record_index = flir_i
        SET flir_record_offset = flir_cre_items_off + 0x14 * flir_i
        SET flir_record_size = 0x14
        LPF flir_removal_hash_slice INT_VAR offset = flir_record_offset length = flir_record_size RET flir_record_hash = hash END
        READ_SHORT flir_record_offset + 0x08 flir_expiration ELSE 0
        READ_SHORT flir_record_offset + 0x0a flir_charge1 ELSE 0
        READ_SHORT flir_record_offset + 0x0c flir_charge2 ELSE 0
        READ_SHORT flir_record_offset + 0x0e flir_charge3 ELSE 0
        READ_LONG flir_record_offset + 0x10 flir_flags ELSE 0
        SET flir_quantity = 1
        SPRINT flir_container_identity "*"
        PATCH_IF "%flir_match_policy%" STRING_EQUAL_CASE "all_one_unit" BEGIN
          PATCH_IF flir_group_signature_set = 0 BEGIN
            SET flir_group_signature_expiration = flir_expiration
            SET flir_group_signature_charge1 = flir_charge1
            SET flir_group_signature_charge2 = flir_charge2
            SET flir_group_signature_charge3 = flir_charge3
            SET flir_group_signature_flags = flir_flags
            SET flir_group_signature_set = 1
          END ELSE PATCH_IF flir_expiration != flir_group_signature_expiration
                OR flir_charge1 != flir_group_signature_charge1
                OR flir_charge2 != flir_group_signature_charge2
                OR flir_charge3 != flir_group_signature_charge3
                OR flir_flags != flir_group_signature_flags BEGIN
            PATCH_FAIL ~FLIR_REMOVAL_ERR MATCH_SIGNATURE_MISMATCH tier=%removed_tier% token=%removed_token% ident=%removed_ident%~
          END
        END
      END
    END
  END
  PATCH_IF "%flir_match_policy%" STRING_EQUAL_CASE "all_one_unit" BEGIN
    PATCH_IF flir_match_count != flir_expected_matches BEGIN
      PATCH_FAIL ~FLIR_REMOVAL_ERR MATCH_COUNT_MISMATCH tier=%removed_tier% token=%removed_token% ident=%removed_ident%~
    END

    // Re-scan only after the exact-count and signature preconditions pass.
    // Each physical record gets a plan, but only the first logical record is
    // allowed to emit a registry unit/token. Apply removes records from the
    // highest index downward, so every captured offset remains valid.
    SET flir_group_emit_index = 0
    FOR (flir_i = 0; flir_i < flir_cre_items_count; ++flir_i) BEGIN
      READ_ASCII (flir_cre_items_off + 0x14 * flir_i) flir_candidate ELSE blank
      PATCH_IF "%flir_candidate%" STRING_EQUAL_CASE "%itm_to_del%" BEGIN
        SET flir_record_index = flir_i
        SET flir_record_offset = flir_cre_items_off + 0x14 * flir_i
        SET flir_record_size = 0x14
        LPF flir_removal_hash_slice INT_VAR offset = flir_record_offset length = flir_record_size RET flir_record_hash = hash END
        READ_SHORT flir_record_offset + 0x0a flir_charge1 ELSE 0
        READ_SHORT flir_record_offset + 0x0c flir_charge2 ELSE 0
        READ_SHORT flir_record_offset + 0x0e flir_charge3 ELSE 0
        READ_LONG flir_record_offset + 0x10 flir_flags ELSE 0
        SET flir_quantity = 1
        SPRINT flir_container_identity "*"
        SPRINT flir_slot_identity "*"
        FOR (flir_slot = 0; flir_slot < 37; ++flir_slot) BEGIN
          READ_SHORT (flir_cre_slots_off + 2 * flir_slot) flir_slot_ref ELSE 0xffff
          PATCH_IF flir_slot_ref = flir_i BEGIN
            SPRINT flir_slot_identity "slot:%flir_slot%"
          END
        END
        SET flir_group_emit_index += 1
        SET flir_emit_unit = 0
        PATCH_IF flir_group_emit_index = 1 BEGIN
          SET flir_emit_unit = 1
        END
        LPM flir_removal_plan_add_current
      END
    END
  END ELSE BEGIN
    PATCH_IF flir_match_count = 0 BEGIN
      SET flir_removal_plan_disabled_count += 1
    END ELSE PATCH_IF flir_match_count > 1 BEGIN
      PATCH_FAIL ~FLIR_REMOVAL_ERR AMBIGUOUS_SOURCE tier=%removed_tier% token=%removed_token% ident=%removed_ident%~
    END ELSE BEGIN
      LPM flir_removal_plan_add_current
    END
  END
END

DEFINE_PATCH_MACRO flir_removal_scan_are BEGIN
  LPF flir_removal_hash_buffer RET flir_whole_hash = hash END
  READ_LONG 0x70 flir_are_con_off ELSE 0
  READ_SHORT 0x74 flir_are_con_count ELSE 0
  READ_SHORT 0x76 flir_are_items_count ELSE 0
  READ_LONG 0x78 flir_are_items_off ELSE 0
  SET flir_match_count = 0
  FOR (flir_con = 0; flir_con < flir_are_con_count; ++flir_con) BEGIN
    SET flir_con_off = flir_are_con_off + 0xc0 * flir_con
    READ_ASCII flir_con_off flir_container_name (32) NULL
    SPRINT flir_container_compare "%flir_container_name%"
    INNER_PATCH_SAVE flir_container_compare "%flir_container_compare%" BEGIN
      REPLACE_TEXTUALLY " " ""
    END
    SET flir_container_ok = 1
    PATCH_IF "%flir_object_or_slot%" STRING_COMPARE_CASE "*"
          AND "%flir_object_or_slot%" STRING_COMPARE_CASE "any" BEGIN
      SPRINT flir_object_compare "%flir_object_or_slot%"
      INNER_PATCH_SAVE flir_object_compare "%flir_object_compare%" BEGIN
        REPLACE_TEXTUALLY " " ""
      END
      SET flir_container_ok = ("%flir_container_compare%" STRING_EQUAL_CASE "%flir_object_compare%")
    END
    PATCH_IF flir_container_ok BEGIN
      READ_LONG flir_con_off + 0x40 flir_first ELSE 0
      READ_LONG flir_con_off + 0x44 flir_count ELSE 0
      FOR (flir_j = 0; flir_j < flir_count; ++flir_j) BEGIN
        SET flir_idx = flir_first + flir_j
        READ_ASCII (flir_are_items_off + 0x14 * flir_idx) flir_candidate ELSE blank
        PATCH_IF "%flir_candidate%" STRING_EQUAL_CASE "%itm_to_del%" BEGIN
          SET flir_match_count += 1
          SET flir_record_index = flir_idx
          SET flir_record_offset = flir_are_items_off + 0x14 * flir_idx
          SET flir_record_size = 0x14
          LPF flir_removal_hash_slice INT_VAR offset = flir_record_offset length = flir_record_size RET flir_record_hash = hash END
          READ_SHORT flir_record_offset + 0x0a flir_charge1 ELSE 0
          READ_SHORT flir_record_offset + 0x0c flir_charge2 ELSE 0
          READ_SHORT flir_record_offset + 0x0e flir_charge3 ELSE 0
          READ_LONG flir_record_offset + 0x10 flir_flags ELSE 0
          SET flir_quantity = 1
          SPRINT flir_container_identity "%flir_container_name%"
          SPRINT flir_slot_identity "container:%flir_j%"
        END
      END
    END
  END
  PATCH_IF flir_match_count = 0 BEGIN
    SET flir_removal_plan_disabled_count += 1
  END ELSE PATCH_IF flir_match_count > 1 BEGIN
    PATCH_FAIL ~FLIR_REMOVAL_ERR AMBIGUOUS_SOURCE tier=%removed_tier% token=%removed_token% ident=%removed_ident%~
  END ELSE BEGIN
    LPM flir_removal_plan_add_current
  END
END

DEFINE_PATCH_MACRO flir_removal_scan_store BEGIN
  LPF flir_removal_hash_buffer RET flir_whole_hash = hash END
  READ_LONG 0x34 flir_store_sale_off ELSE 0
  READ_LONG 0x38 flir_store_sale_count ELSE 0
  SET flir_match_count = 0
  FOR (flir_i = 0; flir_i < flir_store_sale_count; ++flir_i) BEGIN
    SET flir_offset = flir_store_sale_off + 0x1c * flir_i
    READ_ASCII flir_offset flir_candidate ELSE blank
    READ_LONG flir_offset + 0x14 flir_stock ELSE 0
    PATCH_IF "%flir_candidate%" STRING_EQUAL_CASE "%itm_to_del%" AND flir_stock > 0 BEGIN
      SET flir_match_count += 1
      SET flir_record_index = flir_i
      SET flir_record_offset = flir_offset
      SET flir_record_size = 0x1c
      LPF flir_removal_hash_slice INT_VAR offset = flir_record_offset length = flir_record_size RET flir_record_hash = hash END
      READ_SHORT flir_record_offset + 0x0a flir_charge1 ELSE 0
      READ_SHORT flir_record_offset + 0x0c flir_charge2 ELSE 0
      READ_SHORT flir_record_offset + 0x0e flir_charge3 ELSE 0
      READ_LONG flir_record_offset + 0x10 flir_flags ELSE 0
      SET flir_quantity = flir_stock
      SPRINT flir_container_identity "sale"
      SPRINT flir_slot_identity "sale:%flir_i%"
    END
  END
  PATCH_IF flir_match_count = 0 BEGIN
    SET flir_removal_plan_disabled_count += 1
  END ELSE PATCH_IF flir_match_count > 1 BEGIN
    PATCH_FAIL ~FLIR_REMOVAL_ERR AMBIGUOUS_SOURCE tier=%removed_tier% token=%removed_token% ident=%removed_ident%~
  END ELSE BEGIN
    LPM flir_removal_plan_add_current
  END
END

DEFINE_ACTION_MACRO flir_removal_plan_add_virtual_current BEGIN
  OUTER_SET flir_removal_plan_count += 1
  OUTER_SPRINT flir_plan_id "%flir_removal_plan_count%"
  OUTER_SPRINT $flir_removal_plan_kind("%flir_plan_id%") "%flir_plan_kind%"
  OUTER_SPRINT $flir_removal_plan_source("%flir_plan_id%") "%sourcefile%"
  OUTER_SPRINT $flir_removal_plan_item("%flir_plan_id%") "%itm_to_del%"
  OUTER_SPRINT $flir_removal_plan_replacement("%flir_plan_id%") "%replace_itm%"
  OUTER_SPRINT $flir_removal_plan_tier("%flir_plan_id%") "%removed_tier%"
  OUTER_SPRINT $flir_removal_plan_token("%flir_plan_id%") "%removed_token%"
  OUTER_SPRINT $flir_removal_plan_ident("%flir_plan_id%") "%removed_ident%"
  OUTER_SPRINT $flir_removal_plan_stable("%flir_plan_id%") "%flir_plan_stable%"
  OUTER_SPRINT $flir_removal_plan_record_index("%flir_plan_id%") "-1"
  OUTER_SPRINT $flir_removal_plan_record_offset("%flir_plan_id%") "0"
  OUTER_SPRINT $flir_removal_plan_record_size("%flir_plan_id%") "0"
  OUTER_SPRINT $flir_removal_plan_record_hash("%flir_plan_id%") "0"
  OUTER_SPRINT $flir_removal_plan_whole_size("%flir_plan_id%") "%flir_virtual_whole_size%"
  OUTER_SPRINT $flir_removal_plan_whole_hash("%flir_plan_id%") "%flir_virtual_whole_hash%"
  OUTER_SPRINT $flir_removal_plan_container("%flir_plan_id%") "%flir_virtual_policy%"
  OUTER_SPRINT $flir_removal_plan_slot("%flir_plan_id%") "%flir_virtual_policy%"
  OUTER_SPRINT $flir_removal_plan_quantity("%flir_plan_id%") "%flir_virtual_quantity%"
  OUTER_SPRINT $flir_removal_plan_flags("%flir_plan_id%") "0"
  OUTER_SPRINT $flir_removal_plan_charge1("%flir_plan_id%") "%flir_virtual_charge1%"
  OUTER_SPRINT $flir_removal_plan_charge2("%flir_plan_id%") "%flir_virtual_charge2%"
  OUTER_SPRINT $flir_removal_plan_charge3("%flir_plan_id%") "%flir_virtual_charge3%"
  OUTER_SPRINT $flir_removal_plan_category("%flir_plan_id%") "%flir_item_category_value%"
  OUTER_SPRINT $flir_removal_plan_adapter("%flir_plan_id%") "%flir_plan_adapter%"
  OUTER_SPRINT $flir_removal_plan_emit("%flir_plan_id%") "1"
  OUTER_SET flir_virtual_emit_count = flir_virtual_quantity
  ACTION_IF (flir_item_category_value = 9 OR flir_item_category_value = 11)
        AND flir_virtual_charge1 > flir_virtual_emit_count BEGIN
    OUTER_SET flir_virtual_emit_count = flir_virtual_charge1
  END
  OUTER_SPRINT $flir_removal_plan_emit_count("%flir_plan_id%") "%flir_virtual_emit_count%"
END

DEFINE_ACTION_MACRO flir_removal_legacy_adapter_pre_unshey BEGIN
  LAF fl#bg1pal STR_VAR file = "ogreunsh.cre" RET flir_legacy_unshey_cre = file END
  OUTER_SPRINT sourcefile "%flir_legacy_unshey_cre%"
  OUTER_SPRINT flir_source_kind "cre_inventory"
  OUTER_SPRINT flir_object_or_slot "*"
  OUTER_SPRINT flir_virtual_policy ""
  OUTER_SPRINT flir_plan_adapter "unshey"
END

DEFINE_ACTION_MACRO flir_removal_legacy_adapter_pre BEGIN
  ACTION_IF "%sourcefile%" STRING_EQUAL_CASE "unshey.fl"
        AND BG1 = 1 BEGIN
    LAM flir_removal_legacy_adapter_pre_unshey
  END ELSE BEGIN
    LAF flir_removal_fail STR_VAR code = ~UNKNOWN_LEGACY_ADAPTER~ tier = EVAL ~%removed_tier%~ token = EVAL ~%removed_token%~ ident = EVAL ~%removed_ident%~ END
  END
END

DEFINE_ACTION_MACRO flir_removal_legacy_adapter_post_unshey BEGIN
  ACTION_IF !VARIABLE_IS_SET flir_removal_skip_legacy_adapter_post BEGIN
    COPY "randomiser/copy/flrbelt1.itm" override
      SAY 0x8 @114
      SAY 0xc @114
      SAY 0x50 @115
    LAF fl#bg1pal STR_VAR file = "ogreunsh.cre" RET unsheyogre = file END
    ACTION_IF FILE_EXISTS_IN_GAME "%unsheyogre%" BEGIN
      COPY_EXISTING "%unsheyogre%" override
        ADD_CRE_ITEM flrbelt1 #0 #0 #0 none inv1
      BUT_ONLY
    END ELSE ACTION_IF FILE_EXISTS "override/%unsheyogre%" BEGIN
      COPY "override/%unsheyogre%" "override"
        ADD_CRE_ITEM flrbelt1 #0 #0 #0 none inv1
      BUT_ONLY
    END
    ADD_JOURNAL EXISTING TITLE (#31285) @113
    LAF fl#bg1pal STR_VAR file = "unshey.dlg" RET unshey = resource unsheydlg = file END
    ACTION_IF Tutu = 1 OR BGT = 1 OR GAME_IS ~bgee~ BEGIN
      LAF fl#bg1pal STR_VAR file = "book32.itm" RET unsheybook = resource END
      LAF fl#bg1pal STR_VAR file = "belt04.itm" RET unsheybelt = resource END
      COMPILE EVALUATE_BUFFER "randomiser/d/unshey.d"
    END ELSE BEGIN
      COMPILE "randomiser/d/bg1unshey.d"
    END
    ACTION_IF FILE_CONTAINS_EVALUATED ("%unsheydlg%" "UBHelpUnshey") BEGIN
      COMPILE "randomiser/d/bg1ubunshey.d"
    END
  END
END

DEFINE_ACTION_MACRO flir_removal_run_legacy_adapter_post_hooks BEGIN
  ACTION_PHP_EACH flir_removal_plan_adapter AS plan_id => adapter BEGIN
    ACTION_IF "%adapter%" STRING_COMPARE_CASE ""
          AND VARIABLE_IS_SET $flir_removal_plan_applied("%plan_id%")
          AND !VARIABLE_IS_SET $flir_removal_adapter_post_done("%adapter%") BEGIN
      ACTION_IF "%adapter%" STRING_EQUAL_CASE "unshey" BEGIN
        LAM flir_removal_legacy_adapter_post_unshey
        OUTER_SPRINT $flir_removal_adapter_post_done("%adapter%") "1"
      END ELSE BEGIN
        OUTER_SPRINT removed_tier $flir_removal_plan_tier("%plan_id%")
        OUTER_SPRINT removed_token $flir_removal_plan_token("%plan_id%")
        OUTER_SPRINT removed_ident $flir_removal_plan_ident("%plan_id%")
        LAF flir_removal_fail STR_VAR code = ~UNKNOWN_LEGACY_ADAPTER~ tier = EVAL ~%removed_tier%~ token = EVAL ~%removed_token%~ ident = EVAL ~%removed_ident%~ END
      END
    END
  END
END

DEFINE_ACTION_MACRO flir_removal_plan_build_duplicate_current BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME "%itm_to_del%.itm"
        OR FILE_EXISTS "override/%itm_to_del%.itm" BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME "%sourcefile%"
          OR FILE_EXISTS "override/%sourcefile%" BEGIN
      OUTER_SPRINT flir_plan_adapter ""
      ACTION_IF "%sourcefile%" STRING_MATCHES_REGEXP ".*\.are$" = 0 BEGIN
        OUTER_SPRINT flir_plan_kind "area_container"
      END ELSE ACTION_IF "%sourcefile%" STRING_MATCHES_REGEXP ".*\.cre$" = 0 BEGIN
        OUTER_SPRINT flir_plan_kind "cre_inventory"
      END ELSE ACTION_IF "%sourcefile%" STRING_MATCHES_REGEXP ".*\.sto$" = 0 BEGIN
        OUTER_SPRINT flir_plan_kind "store"
      END ELSE BEGIN
        OUTER_SPRINT flir_plan_kind "legacy_adapter"
      END

      ACTION_IF "%flir_plan_kind%" STRING_EQUAL_CASE "area_container"
            OR "%flir_plan_kind%" STRING_EQUAL_CASE "cre_inventory"
            OR "%flir_plan_kind%" STRING_EQUAL_CASE "store" BEGIN
        OUTER_SPRINT flir_object_or_slot "*"
        OUTER_SPRINT flir_match_policy "single"
        OUTER_SET flir_expected_matches = 1
        OUTER_SET flir_category = 0
        OUTER_SET flir_emit_unit = 0
        OUTER_SET flir_emit_count = 0
        OUTER_SPRINT replace_itm "%replacement_itm%"
        ACTION_IF FILE_EXISTS_IN_GAME "%sourcefile%" BEGIN
          COPY_EXISTING "%sourcefile%" "flir-removal-read/%sourcefile%"
            PATCH_IF "%flir_plan_kind%" STRING_EQUAL_CASE "cre_inventory" BEGIN
              LPM flir_removal_scan_cre
            END ELSE PATCH_IF "%flir_plan_kind%" STRING_EQUAL_CASE "area_container" BEGIN
              LPM flir_removal_scan_are
            END ELSE PATCH_IF "%flir_plan_kind%" STRING_EQUAL_CASE "store" BEGIN
              LPM flir_removal_scan_store
            END
          BUT_ONLY
        END ELSE BEGIN
          COPY "override/%sourcefile%" "flir-removal-read/%sourcefile%"
            PATCH_IF "%flir_plan_kind%" STRING_EQUAL_CASE "cre_inventory" BEGIN
              LPM flir_removal_scan_cre
            END ELSE PATCH_IF "%flir_plan_kind%" STRING_EQUAL_CASE "area_container" BEGIN
              LPM flir_removal_scan_are
            END ELSE PATCH_IF "%flir_plan_kind%" STRING_EQUAL_CASE "store" BEGIN
              LPM flir_removal_scan_store
            END
          BUT_ONLY
        END
      END ELSE BEGIN
        LAF flir_removal_fail STR_VAR code = ~UNKNOWN_LEGACY_ADAPTER~ tier = EVAL ~%removed_tier%~ token = EVAL ~%removed_token%~ ident = EVAL ~%removed_ident%~ END
      END
    END ELSE BEGIN
      OUTER_SET flir_removal_plan_disabled_count += 1
    END
  END ELSE BEGIN
    OUTER_SET flir_removal_plan_disabled_count += 1
  END
END

DEFINE_ACTION_MACRO flir_removal_plan_build_item BEGIN
  OUTER_SET flir_preserve_allowed = 1
  ACTION_IF flir_removal_building_legacy_snapshot = 1
        AND "%Preserve%" STRING_EQUAL_CASE y
        AND !VARIABLE_IS_SET $flir_removal_history_array("%removed_tier%" "%removed_token%" "%removed_ident%") BEGIN
    OUTER_SET flir_preserve_allowed = 0
  END

  ACTION_IF flir_preserve_allowed = 1 BEGIN
    ACTION_IF !FILE_EXISTS_IN_GAME "%itm_to_del%.itm"
          AND !FILE_EXISTS "override/%itm_to_del%.itm" BEGIN
      OUTER_SET flir_removal_plan_disabled_count += 1
    END ELSE BEGIN
      LAM flir_removal_read_item_metadata
      OUTER_SET flir_item_category_value = $flir_removal_item_category("%itm_to_del%")
      OUTER_SET flir_item_default_charge1 = $flir_removal_item_charge1("%itm_to_del%")
      OUTER_SET flir_item_default_charge2 = $flir_removal_item_charge2("%itm_to_del%")
      OUTER_SET flir_item_default_charge3 = $flir_removal_item_charge3("%itm_to_del%")
      OUTER_SPRINT flir_plan_stable ~~

      ACTION_PHP_EACH duplicate_item_array AS dia_entry => blank BEGIN
        ACTION_IF "%dia_entry_3%" STRING_EQUAL_CASE "%removed_ident%" BEGIN
          OUTER_SPRINT flir_main_item "%itm_to_del%"
          OUTER_SPRINT flir_main_replacement "%replacement_itm%"
          OUTER_SPRINT flir_main_source "%sourcefile%"
          OUTER_SPRINT itm_to_del "%dia_entry_0%"
          OUTER_SPRINT replacement_itm "%dia_entry_2%"
          OUTER_SPRINT sourcefile "%dia_entry_1%"
          LAM flir_removal_plan_build_duplicate_current
          OUTER_SPRINT itm_to_del "%flir_main_item%"
          OUTER_SPRINT replacement_itm "%flir_main_replacement%"
          OUTER_SPRINT sourcefile "%flir_main_source%"
        END
      END

      OUTER_SPRINT flir_source_key "ident:%removed_ident%"
      ACTION_IF flir_removal_building_legacy_snapshot = 1
            AND VARIABLE_IS_SET $flir_source_legacy_row_key("%itm_to_del%" "%replacement_itm%" "%sourcefile%" "%removed_tier%" "%removed_token%" "%removed_ident%") BEGIN
        OUTER_SPRINT flir_source_key $flir_source_legacy_row_key("%itm_to_del%" "%replacement_itm%" "%sourcefile%" "%removed_tier%" "%removed_token%" "%removed_ident%")
      END ELSE ACTION_IF flir_removal_building_legacy_snapshot = 0
            AND VARIABLE_IS_SET $flir_source_current_row_key("%itm_to_del%" "%replacement_itm%" "%sourcefile%" "%removed_tier%" "%removed_token%" "%removed_ident%") BEGIN
        OUTER_SPRINT flir_source_key $flir_source_current_row_key("%itm_to_del%" "%replacement_itm%" "%sourcefile%" "%removed_tier%" "%removed_token%" "%removed_ident%")
      END
      ACTION_IF VARIABLE_IS_SET $flir_source_decl_birth_stable("%flir_source_key%") BEGIN
        OUTER_SPRINT flir_plan_stable $flir_source_decl_birth_stable("%flir_source_key%")
      END
      OUTER_SPRINT flir_source_kind "auto"
      OUTER_SPRINT flir_object_or_slot "*"
      OUTER_SPRINT flir_virtual_policy ""
      OUTER_SPRINT flir_match_policy "single"
      OUTER_SET flir_expected_matches = 1
      OUTER_SPRINT flir_plan_adapter ""
      OUTER_SET flir_virtual_quantity = 1
      OUTER_SET flir_virtual_charge1 = flir_item_default_charge1
      OUTER_SET flir_virtual_charge2 = flir_item_default_charge2
      OUTER_SET flir_virtual_charge3 = flir_item_default_charge3
      ACTION_IF flir_removal_building_legacy_snapshot = 1 BEGIN
        ACTION_IF VARIABLE_IS_SET $flir_source_legacy_decl_source_kind("%flir_source_key%") BEGIN
          OUTER_SPRINT flir_source_kind $flir_source_legacy_decl_source_kind("%flir_source_key%")
        END
        ACTION_IF VARIABLE_IS_SET $flir_source_legacy_decl_object_or_slot("%flir_source_key%") BEGIN
          OUTER_SPRINT flir_object_or_slot $flir_source_legacy_decl_object_or_slot("%flir_source_key%")
        END
        ACTION_IF VARIABLE_IS_SET $flir_source_legacy_decl_virtual_policy("%flir_source_key%") BEGIN
          OUTER_SPRINT flir_virtual_policy $flir_source_legacy_decl_virtual_policy("%flir_source_key%")
        END
        ACTION_IF VARIABLE_IS_SET $flir_source_legacy_decl_match_policy("%flir_source_key%") BEGIN
          OUTER_SPRINT flir_match_policy $flir_source_legacy_decl_match_policy("%flir_source_key%")
        END
        ACTION_IF VARIABLE_IS_SET $flir_source_legacy_decl_expected_matches("%flir_source_key%") BEGIN
          OUTER_SET flir_expected_matches = $flir_source_legacy_decl_expected_matches("%flir_source_key%")
        END
        ACTION_IF "%flir_virtual_policy%" STRING_EQUAL_CASE "explicit" BEGIN
          ACTION_IF VARIABLE_IS_SET $flir_source_legacy_decl_expected_quantity("%flir_source_key%") BEGIN
            OUTER_SET flir_virtual_quantity = $flir_source_legacy_decl_expected_quantity("%flir_source_key%")
          END
          ACTION_IF VARIABLE_IS_SET $flir_source_legacy_decl_declared_charge1("%flir_source_key%") BEGIN
            OUTER_SET flir_virtual_charge1 = $flir_source_legacy_decl_declared_charge1("%flir_source_key%")
          END
          ACTION_IF VARIABLE_IS_SET $flir_source_legacy_decl_declared_charge2("%flir_source_key%") BEGIN
            OUTER_SET flir_virtual_charge2 = $flir_source_legacy_decl_declared_charge2("%flir_source_key%")
          END
          ACTION_IF VARIABLE_IS_SET $flir_source_legacy_decl_declared_charge3("%flir_source_key%") BEGIN
            OUTER_SET flir_virtual_charge3 = $flir_source_legacy_decl_declared_charge3("%flir_source_key%")
          END
        END
      END ELSE BEGIN
        ACTION_IF VARIABLE_IS_SET $flir_source_decl_source_kind("%flir_source_key%") BEGIN
          OUTER_SPRINT flir_source_kind $flir_source_decl_source_kind("%flir_source_key%")
        END
        ACTION_IF VARIABLE_IS_SET $flir_source_decl_object_or_slot("%flir_source_key%") BEGIN
          OUTER_SPRINT flir_object_or_slot $flir_source_decl_object_or_slot("%flir_source_key%")
        END
        ACTION_IF VARIABLE_IS_SET $flir_source_decl_virtual_policy("%flir_source_key%") BEGIN
          OUTER_SPRINT flir_virtual_policy $flir_source_decl_virtual_policy("%flir_source_key%")
        END
        ACTION_IF VARIABLE_IS_SET $flir_source_decl_match_policy("%flir_source_key%") BEGIN
          OUTER_SPRINT flir_match_policy $flir_source_decl_match_policy("%flir_source_key%")
        END
        ACTION_IF VARIABLE_IS_SET $flir_source_decl_expected_matches("%flir_source_key%") BEGIN
          OUTER_SET flir_expected_matches = $flir_source_decl_expected_matches("%flir_source_key%")
        END
        ACTION_IF "%flir_virtual_policy%" STRING_EQUAL_CASE "explicit" BEGIN
          ACTION_IF VARIABLE_IS_SET $flir_source_decl_expected_quantity("%flir_source_key%") BEGIN
            OUTER_SET flir_virtual_quantity = $flir_source_decl_expected_quantity("%flir_source_key%")
          END
          ACTION_IF VARIABLE_IS_SET $flir_source_decl_declared_charge1("%flir_source_key%") BEGIN
            OUTER_SET flir_virtual_charge1 = $flir_source_decl_declared_charge1("%flir_source_key%")
          END
          ACTION_IF VARIABLE_IS_SET $flir_source_decl_declared_charge2("%flir_source_key%") BEGIN
            OUTER_SET flir_virtual_charge2 = $flir_source_decl_declared_charge2("%flir_source_key%")
          END
          ACTION_IF VARIABLE_IS_SET $flir_source_decl_declared_charge3("%flir_source_key%") BEGIN
            OUTER_SET flir_virtual_charge3 = $flir_source_decl_declared_charge3("%flir_source_key%")
          END
        END
      END
      ACTION_IF "%flir_source_kind%" STRING_EQUAL_CASE "auto" BEGIN
        ACTION_IF "%sourcefile%" STRING_EQUAL_CASE "blank" BEGIN
          OUTER_SPRINT flir_source_kind "virtual"
        END ELSE ACTION_IF "%sourcefile%" STRING_MATCHES_REGEXP ".*\.are$" = 0 BEGIN
          OUTER_SPRINT flir_source_kind "area_container"
        END ELSE ACTION_IF "%sourcefile%" STRING_MATCHES_REGEXP ".*\.cre$" = 0 BEGIN
          OUTER_SPRINT flir_source_kind "cre_inventory"
        END ELSE ACTION_IF "%sourcefile%" STRING_MATCHES_REGEXP ".*\.sto$" = 0 BEGIN
          OUTER_SPRINT flir_source_kind "store"
        END ELSE ACTION_IF "%sourcefile%" STRING_MATCHES_REGEXP ".*\.bcs$" = 0 BEGIN
          OUTER_SPRINT flir_source_kind "script"
        END ELSE BEGIN
          OUTER_SPRINT flir_source_kind "legacy_adapter"
        END
      END
      ACTION_IF "%flir_source_kind%" STRING_EQUAL_CASE "legacy_adapter" BEGIN
        LAM flir_removal_legacy_adapter_pre
      END

      ACTION_IF "%flir_match_policy%" STRING_EQUAL_CASE "single" BEGIN
        ACTION_IF flir_expected_matches != 1 BEGIN
          LAF flir_removal_fail STR_VAR code = ~MATCH_COUNT_POLICY~ tier = EVAL ~%removed_tier%~ token = EVAL ~%removed_token%~ ident = EVAL ~%removed_ident%~ END
        END
      END ELSE ACTION_IF "%flir_match_policy%" STRING_EQUAL_CASE "all_one_unit" BEGIN
        ACTION_IF flir_expected_matches < 2
              OR NOT ("%flir_source_kind%" STRING_EQUAL_CASE "cre_inventory") BEGIN
          LAF flir_removal_fail STR_VAR code = ~MATCH_POLICY_KIND~ tier = EVAL ~%removed_tier%~ token = EVAL ~%removed_token%~ ident = EVAL ~%removed_ident%~ END
        END
        ACTION_IF NOT ("%flir_object_or_slot%" STRING_EQUAL_CASE "*")
              AND NOT ("%flir_object_or_slot%" STRING_EQUAL_CASE "any") BEGIN
          LAF flir_removal_fail STR_VAR code = ~MATCH_POLICY_SELECTOR~ tier = EVAL ~%removed_tier%~ token = EVAL ~%removed_token%~ ident = EVAL ~%removed_ident%~ END
        END
      END ELSE BEGIN
        LAF flir_removal_fail STR_VAR code = ~MATCH_POLICY~ tier = EVAL ~%removed_tier%~ token = EVAL ~%removed_token%~ ident = EVAL ~%removed_ident%~ END
      END

      ACTION_IF "%flir_source_kind%" STRING_EQUAL_CASE "virtual" BEGIN
        ACTION_IF NOT ("%flir_virtual_policy%" STRING_EQUAL_CASE "explicit")
              AND NOT ("%flir_virtual_policy%" STRING_EQUAL_CASE "legacy_blank") BEGIN
          LAF flir_removal_fail STR_VAR code = ~VIRTUAL_SOURCE_POLICY~ tier = EVAL ~%removed_tier%~ token = EVAL ~%removed_token%~ ident = EVAL ~%removed_ident%~ END
        END
        ACTION_IF flir_virtual_quantity < 1
              OR flir_virtual_charge1 < 0
              OR flir_virtual_charge2 < 0
              OR flir_virtual_charge3 < 0 BEGIN
          LAF flir_removal_fail STR_VAR code = ~VIRTUAL_SOURCE_METADATA~ tier = EVAL ~%removed_tier%~ token = EVAL ~%removed_token%~ ident = EVAL ~%removed_ident%~ END
        END
        OUTER_SET flir_virtual_whole_size = 0
        OUTER_SET flir_virtual_whole_hash = 0
        OUTER_SPRINT flir_plan_kind "virtual"
        LAM flir_removal_plan_add_virtual_current
      END ELSE ACTION_IF "%flir_source_kind%" STRING_EQUAL_CASE "script" BEGIN
        ACTION_IF FILE_EXISTS_IN_GAME "%sourcefile%"
              OR FILE_EXISTS "override/%sourcefile%" BEGIN
          OUTER_SET flir_virtual_whole_size = 0
          OUTER_SET flir_virtual_whole_hash = 0
          ACTION_IF FILE_EXISTS_IN_GAME "%sourcefile%" BEGIN
            COPY_EXISTING "%sourcefile%" "flir-removal-read/%sourcefile%"
              LPF flir_removal_hash_buffer RET flir_script_hash = hash END
              SET flir_script_size = BUFFER_LENGTH
              SPRINT $flir_removal_script_size("%sourcefile%") "%flir_script_size%"
              SPRINT $flir_removal_script_hash("%sourcefile%") "%flir_script_hash%"
            BUT_ONLY
          END ELSE BEGIN
            COPY "override/%sourcefile%" "flir-removal-read/%sourcefile%"
              LPF flir_removal_hash_buffer RET flir_script_hash = hash END
              SET flir_script_size = BUFFER_LENGTH
              SPRINT $flir_removal_script_size("%sourcefile%") "%flir_script_size%"
              SPRINT $flir_removal_script_hash("%sourcefile%") "%flir_script_hash%"
            BUT_ONLY
          END
          OUTER_SET flir_virtual_whole_size = $flir_removal_script_size("%sourcefile%")
          OUTER_SET flir_virtual_whole_hash = $flir_removal_script_hash("%sourcefile%")
          OUTER_SPRINT flir_plan_kind "script"
          LAM flir_removal_plan_add_virtual_current
        END ELSE BEGIN
          OUTER_SET flir_removal_plan_disabled_count += 1
        END
      END ELSE ACTION_IF "%flir_source_kind%" STRING_EQUAL_CASE "area_container"
            OR "%flir_source_kind%" STRING_EQUAL_CASE "cre_inventory"
            OR "%flir_source_kind%" STRING_EQUAL_CASE "store" BEGIN
        ACTION_IF FILE_EXISTS_IN_GAME "%sourcefile%"
              OR FILE_EXISTS "override/%sourcefile%" BEGIN
          OUTER_SPRINT flir_plan_kind "%flir_source_kind%"
          OUTER_SPRINT flir_object_or_slot "%flir_object_or_slot%"
          OUTER_SET flir_category = flir_item_category_value
          OUTER_SET flir_emit_unit = 1
          OUTER_SET flir_emit_count = 1
          OUTER_SPRINT replace_itm "%replacement_itm%"
          ACTION_IF FILE_EXISTS_IN_GAME "%sourcefile%" BEGIN
            COPY_EXISTING "%sourcefile%" "flir-removal-read/%sourcefile%"
              PATCH_IF "%flir_plan_kind%" STRING_EQUAL_CASE "cre_inventory" BEGIN
                LPM flir_removal_scan_cre
              END ELSE PATCH_IF "%flir_plan_kind%" STRING_EQUAL_CASE "area_container" BEGIN
                LPM flir_removal_scan_are
              END ELSE PATCH_IF "%flir_plan_kind%" STRING_EQUAL_CASE "store" BEGIN
                LPM flir_removal_scan_store
              END
            BUT_ONLY
          END ELSE BEGIN
            COPY "override/%sourcefile%" "flir-removal-read/%sourcefile%"
              PATCH_IF "%flir_plan_kind%" STRING_EQUAL_CASE "cre_inventory" BEGIN
                LPM flir_removal_scan_cre
              END ELSE PATCH_IF "%flir_plan_kind%" STRING_EQUAL_CASE "area_container" BEGIN
                LPM flir_removal_scan_are
              END ELSE PATCH_IF "%flir_plan_kind%" STRING_EQUAL_CASE "store" BEGIN
                LPM flir_removal_scan_store
              END
            BUT_ONLY
          END
        END ELSE BEGIN
          OUTER_SET flir_removal_plan_disabled_count += 1
        END
      END ELSE BEGIN
        OUTER_SET flir_removal_plan_disabled_count += 1
      END
    END
  END
END

DEFINE_ACTION_MACRO flir_removal_validate_future_hooks BEGIN
  // Task 4 exposes these validation seams before the registry/endpoint modules
  // exist. They intentionally do nothing unless a test injects a failure.
  ACTION_IF VARIABLE_IS_SET flir_removal_force_validator_failure BEGIN
    LAF flir_removal_fail STR_VAR code = ~VALIDATOR_HOOK~ tier = ~~ token = ~~ ident = ~~ END
  END
  ACTION_IF VARIABLE_IS_SET flir_registry_available BEGIN
    LAM flir_registry_validate_planned_units
  END
  ACTION_IF VARIABLE_IS_SET flir_endpoints_available
        AND VARIABLE_IS_SET flir_delivery_backend
        AND "%flir_delivery_backend%" STRING_EQUAL_CASE ~eeex-manifest-v1~ BEGIN
    LAM flir_endpoints_validate_planned_units
  END
END

DEFINE_ACTION_MACRO flir_removal_plan_build_selected_array BEGIN
  LAM flir_removal_plan_reset
  ACTION_PHP_EACH "%flir_removal_plan_build_array%" AS entry => int BEGIN
    OUTER_SPRINT itm_to_del     "%entry_0%"
    OUTER_SPRINT replacement_itm "%entry_1%"
    OUTER_SPRINT sourcefile     "%entry_2%"
    OUTER_SPRINT removed_tier   "%entry_3%"
    OUTER_SPRINT removed_token  "%entry_4%"
    OUTER_SPRINT removed_ident  "%entry_5%"
    LAM flir_removal_plan_build_item
  END
END

DEFINE_ACTION_MACRO flir_removal_plan_build BEGIN
  LAM flir_removal_plan_load_preserve
  ACTION_IF flir_registry_old_unmarked_migration = 1 BEGIN
    OUTER_SET flir_removal_building_legacy_snapshot = 1
    OUTER_SPRINT flir_removal_plan_build_array ~flir_source_legacy_item_array~
    LAM flir_removal_plan_build_selected_array
    LAM flir_registry_capture_old_unmarked_legacy_units
  END

  OUTER_SET flir_removal_building_legacy_snapshot = 0
  OUTER_SPRINT flir_removal_plan_build_array ~item_array~
  LAM flir_removal_plan_build_selected_array
  LAM flir_removal_validate_future_hooks
  LAM flir_removal_validate_token_capacity
  // From this point onward removed_item_array means this install's successfully
  // applied removals. Preserve history remains available only in the dedicated
  // history array and is never registered as current catalog content.
  ACTION_CLEAR_ARRAY removed_item_array
END

DEFINE_ACTION_MACRO flir_removal_validate_token_capacity BEGIN
  ACTION_PHP_EACH flir_removal_capacity_required AS stale_tier => stale_required_count BEGIN
    OUTER_SET $flir_removal_capacity_required("%stale_tier%") = 0
  END
  ACTION_CLEAR_ARRAY flir_removal_capacity_required
  ACTION_PHP_EACH flir_removal_plan_emit_count AS plan_id => emit_count BEGIN
    ACTION_IF $flir_removal_plan_emit("%plan_id%") = 1 BEGIN
      OUTER_SPRINT cap_tier $flir_removal_plan_tier("%plan_id%")
      ACTION_IF VARIABLE_IS_SET $flir_removal_capacity_required("%cap_tier%") BEGIN
        OUTER_SET $flir_removal_capacity_required("%cap_tier%") += emit_count
      END ELSE BEGIN
        OUTER_SET $flir_removal_capacity_required("%cap_tier%") = emit_count
      END
    END
  END
  ACTION_PHP_EACH flir_removal_capacity_required AS tier => required_count BEGIN
    OUTER_SPRINT cap_cre "fltier%tier%.cre"
    OUTER_SET cap_checked = 0
    ACTION_IF FILE_EXISTS_IN_GAME "%cap_cre%" BEGIN
      COPY_EXISTING "%cap_cre%" "flir-removal-read/%cap_cre%"
        LPF flir_removal_count_empty_cre_slots RET cap_empty = empty_slots END
        PATCH_IF cap_empty < required_count BEGIN
          PATCH_FAIL ~FLIR_REMOVAL_ERR TOKEN_CAPACITY tier=%tier% token= ident=~
        END
      BUT_ONLY
      OUTER_SET cap_checked = 1
    END ELSE ACTION_IF FILE_EXISTS "override/%cap_cre%" BEGIN
      COPY "override/%cap_cre%" "flir-removal-read/%cap_cre%"
        LPF flir_removal_count_empty_cre_slots RET cap_empty = empty_slots END
        PATCH_IF cap_empty < required_count BEGIN
          PATCH_FAIL ~FLIR_REMOVAL_ERR TOKEN_CAPACITY tier=%tier% token= ident=~
        END
      BUT_ONLY
      OUTER_SET cap_checked = 1
    END ELSE ACTION_IF VARIABLE_IS_SET flir_removal_token_template BEGIN
      ACTION_IF FILE_EXISTS "%flir_removal_token_template%" BEGIN
        COPY "%flir_removal_token_template%" "flir-removal-read/token-template-%tier%.cre"
          LPF flir_removal_count_empty_cre_slots RET cap_empty = empty_slots END
          PATCH_IF cap_empty < required_count BEGIN
            PATCH_FAIL ~FLIR_REMOVAL_ERR TOKEN_CAPACITY tier=%tier% token= ident=~
          END
        BUT_ONLY
        OUTER_SET cap_checked = 1
      END
    END
    ACTION_IF cap_checked = 0 BEGIN
      LAF flir_removal_fail STR_VAR code = ~TOKEN_CAPACITY~ tier = EVAL ~%tier%~ token = ~~ ident = ~~ END
    END
  END
END

DEFINE_ACTION_MACRO flir_removal_emit_extra_token BEGIN
  OUTER_SPRINT flir_extra_saved_token "%removed_token%"
  OUTER_SPRINT flir_extra_saved_ident "%removed_ident%"
  OUTER_SPRINT flir_extra_stable ~~
  ACTION_IF VARIABLE_IS_SET flir_extra_base_token BEGIN
    OUTER_SPRINT flir_extra_base "%flir_extra_base_token%"
  END ELSE BEGIN
    OUTER_SPRINT flir_extra_base "%removed_token%"
  END
  OUTER_SET flir_extra_found = 0
  ACTION_IF VARIABLE_IS_SET $flir_registry_planned_extra_compact("%flir_emit_plan_id%" "%flir_extra_prefix%" "%flir_extra_i%") BEGIN
    OUTER_SPRINT flir_extra_token $flir_registry_planned_extra_compact("%flir_emit_plan_id%" "%flir_extra_prefix%" "%flir_extra_i%")
    ACTION_IF VARIABLE_IS_SET $extra_tokens("%removed_tier%" "%flir_extra_token%") BEGIN
      LAF flir_registry_fail STR_VAR code = ~COMPACT_COLLISION~ kind = ~unit~ id = EVAL ~%flir_extra_token%~ END
    END
    OUTER_SET flir_extra_found = 1
    OUTER_SPRINT flir_extra_stable $flir_registry_planned_extra_stable("%flir_emit_plan_id%" "%flir_extra_prefix%" "%flir_extra_i%")
  END ELSE BEGIN
    OUTER_SET flir_extra_slot = 0
    OUTER_WHILE flir_extra_found = 0 AND flir_extra_slot < 100 BEGIN
      OUTER_SPRINT flir_extra_token "%flir_extra_prefix%%flir_extra_slot%"
      ACTION_IF !VARIABLE_IS_SET $extra_tokens("%removed_tier%" "%flir_extra_token%") BEGIN
        OUTER_SET flir_extra_found = 1
      END ELSE BEGIN
        OUTER_SET flir_extra_slot += 1
      END
    END
  END
  ACTION_IF flir_extra_found = 0 BEGIN
    LAF flir_removal_fail STR_VAR code = ~EXTRA_TOKEN_EXHAUSTED~ tier = EVAL ~%removed_tier%~ token = EVAL ~%removed_token%~ ident = EVAL ~%removed_ident%~ END
  END
  OUTER_SPRINT $extra_tokens("%removed_tier%" "%flir_extra_token%") "%flir_extra_base%"
  ACTION_IF "%flir_extra_stable%" STRING_COMPARE_CASE "" BEGIN
    OUTER_SPRINT $flir_registry_applied_extra_stable("%removed_tier%" "%flir_extra_token%") ~%flir_extra_stable%~
  END
  OUTER_SPRINT removed_token "%flir_extra_token%"
  OUTER_SPRINT removed_ident "x"
  OUTER_SPRINT itm_to_stuff "fl%removed_tier%t%flir_extra_token%"
  LAM flir_removal_stuff_cre
  OUTER_SPRINT removed_token "%flir_extra_saved_token%"
  OUTER_SPRINT removed_ident "%flir_extra_saved_ident%"
END

DEFINE_ACTION_MACRO flir_removal_recheck_script_precondition BEGIN
  OUTER_SPRINT flir_script_source $flir_removal_plan_source("%flir_emit_plan_id%")
  OUTER_SET flir_script_expected_size = $flir_removal_plan_whole_size("%flir_emit_plan_id%")
  OUTER_SET flir_script_expected_hash = $flir_removal_plan_whole_hash("%flir_emit_plan_id%")
  OUTER_SET flir_script_checked = 0

  ACTION_IF FILE_EXISTS_IN_GAME "%flir_script_source%" BEGIN
    COPY_EXISTING "%flir_script_source%" "flir-removal-read/%flir_script_source%"
      LPF flir_removal_hash_buffer RET flir_script_current_hash = hash END
      PATCH_IF BUFFER_LENGTH != flir_script_expected_size OR flir_script_current_hash != flir_script_expected_hash BEGIN
        PATCH_FAIL ~FLIR_REMOVAL_ERR PRECONDITION_DRIFT tier=%removed_tier% token=%removed_token% ident=%removed_ident%~
      END
    BUT_ONLY
    OUTER_SET flir_script_checked = 1
  END ELSE ACTION_IF FILE_EXISTS "override/%flir_script_source%" BEGIN
    COPY "override/%flir_script_source%" "flir-removal-read/%flir_script_source%"
      LPF flir_removal_hash_buffer RET flir_script_current_hash = hash END
      PATCH_IF BUFFER_LENGTH != flir_script_expected_size OR flir_script_current_hash != flir_script_expected_hash BEGIN
        PATCH_FAIL ~FLIR_REMOVAL_ERR PRECONDITION_DRIFT tier=%removed_tier% token=%removed_token% ident=%removed_ident%~
      END
    BUT_ONLY
    OUTER_SET flir_script_checked = 1
  END

  ACTION_IF flir_script_checked = 0 BEGIN
    LAF flir_removal_fail STR_VAR code = ~PRECONDITION_DRIFT~ tier = EVAL ~%removed_tier%~ token = EVAL ~%removed_token%~ ident = EVAL ~%removed_ident%~ END
  END
END

DEFINE_ACTION_MACRO flir_removal_emit_plan BEGIN
  OUTER_SPRINT removed_tier $flir_removal_plan_tier("%flir_emit_plan_id%")
  OUTER_SPRINT removed_token $flir_removal_plan_token("%flir_emit_plan_id%")
  OUTER_SPRINT removed_ident $flir_removal_plan_ident("%flir_emit_plan_id%")
  OUTER_SPRINT itm_to_del $flir_removal_plan_item("%flir_emit_plan_id%")
  OUTER_SPRINT sourcefile $flir_removal_plan_source("%flir_emit_plan_id%")
  OUTER_SPRINT flir_emit_kind $flir_removal_plan_kind("%flir_emit_plan_id%")
  OUTER_SPRINT flir_emit_stable ~~
  ACTION_IF VARIABLE_IS_SET $flir_removal_plan_stable("%flir_emit_plan_id%") BEGIN
    OUTER_SPRINT flir_emit_stable $flir_removal_plan_stable("%flir_emit_plan_id%")
  END
  OUTER_SPRINT cre "fltier%removed_tier%"
  OUTER_SPRINT itm_to_stuff "fl%removed_tier%t%removed_token%"
  OUTER_SET flir_emit_category = $flir_removal_plan_category("%flir_emit_plan_id%")
  OUTER_SET flir_emit_charge1 = $flir_removal_plan_charge1("%flir_emit_plan_id%")
  OUTER_SET flir_emit_charge2 = $flir_removal_plan_charge2("%flir_emit_plan_id%")
  OUTER_SET flir_emit_charge3 = $flir_removal_plan_charge3("%flir_emit_plan_id%")
  ACTION_IF (flir_emit_category = 9 OR flir_emit_category = 11) BEGIN
    OUTER_SET flir_emit_base_charge1 = 1
  END ELSE BEGIN
    OUTER_SET flir_emit_base_charge1 = flir_emit_charge1
  END
  LAM flir_removal_stuff_cre
  ACTION_IF "%flir_emit_stable%" STRING_COMPARE_CASE "" BEGIN
    OUTER_SPRINT $flir_registry_applied_unit_stable("%removed_tier%" "%removed_token%" "%removed_ident%") ~%flir_emit_stable%~
  END
  OUTER_SPRINT $charge_array("%removed_token%" "%removed_tier%" "%flir_emit_base_charge1%" "%flir_emit_charge2%" "%flir_emit_charge3%") ""
  OUTER_SET flir_removal_plan_applied_count += 1

  ACTION_IF "%sourcefile%" STRING_MATCHES_REGEXP ".*\.bcs$" = 0 BEGIN
    OUTER_SPRINT $bcs_source_array("%sourcefile%") ""
  END

  OUTER_SET flir_emit_quantity = $flir_removal_plan_quantity("%flir_emit_plan_id%")
  ACTION_IF ("%flir_emit_kind%" STRING_EQUAL_CASE "store"
          OR "%flir_emit_kind%" STRING_EQUAL_CASE "virtual")
        AND flir_emit_quantity > 1
        AND ((flir_emit_category != 9 AND flir_emit_category != 11)
          OR flir_emit_quantity >= flir_emit_charge1) BEGIN
    OUTER_SPRINT flir_extra_prefix "x"
    OUTER_SPRINT flir_extra_base_token "%removed_token%"
    OUTER_FOR (flir_extra_i = 1; flir_extra_i < flir_emit_quantity; ++flir_extra_i) BEGIN
      LAM flir_removal_emit_extra_token
    END
  END

  ACTION_IF (flir_emit_category = 9 OR flir_emit_category = 11)
        AND flir_emit_charge1 > 1
        AND NOT ("%flir_emit_kind%" STRING_EQUAL_CASE "store")
        AND (NOT ("%flir_emit_kind%" STRING_EQUAL_CASE "virtual")
          OR flir_emit_charge1 > flir_emit_quantity) BEGIN
    OUTER_SPRINT flir_extra_prefix "y"
    OUTER_SPRINT flir_extra_base_token "%removed_token%"
    OUTER_FOR (flir_extra_i = 1; flir_extra_i < flir_emit_charge1; ++flir_extra_i) BEGIN
      LAM flir_removal_emit_extra_token
    END
  END
END

DEFINE_PATCH_MACRO flir_removal_assert_resource_precondition BEGIN
  LPF flir_removal_hash_buffer RET flir_apply_whole_hash = hash END
  SET flir_checked = 0
  PHP_EACH flir_removal_plan_kind AS plan_id => plan_kind BEGIN
    SPRINT flir_plan_source $flir_removal_plan_source("%plan_id%")
    PATCH_IF flir_checked = 0
          AND "%plan_kind%" STRING_EQUAL_CASE "%flir_apply_kind%"
          AND "%flir_plan_source%" STRING_EQUAL_CASE "%flir_apply_source%" BEGIN
      SET flir_expected_size = $flir_removal_plan_whole_size("%plan_id%")
      SET flir_expected_hash = $flir_removal_plan_whole_hash("%plan_id%")
      PATCH_IF BUFFER_LENGTH != flir_expected_size OR flir_apply_whole_hash != flir_expected_hash BEGIN
        SPRINT flir_drift_tier $flir_removal_plan_tier("%plan_id%")
        SPRINT flir_drift_token $flir_removal_plan_token("%plan_id%")
        SPRINT flir_drift_ident $flir_removal_plan_ident("%plan_id%")
        PATCH_FAIL ~FLIR_REMOVAL_ERR PRECONDITION_DRIFT tier=%flir_drift_tier% token=%flir_drift_token% ident=%flir_drift_ident%~
      END
      SET flir_checked = 1
    END
  END
END

DEFINE_PATCH_MACRO flir_removal_select_next_plan BEGIN
  SET flir_best_plan = 0
  SET flir_best_index = 0 - 2
  PHP_EACH flir_removal_plan_kind AS plan_id => plan_kind BEGIN
    SPRINT flir_plan_source $flir_removal_plan_source("%plan_id%")
    PATCH_IF "%plan_kind%" STRING_EQUAL_CASE "%flir_apply_kind%"
          AND "%flir_plan_source%" STRING_EQUAL_CASE "%flir_apply_source%"
          AND !VARIABLE_IS_SET $flir_removal_plan_applied("%plan_id%") BEGIN
      SET flir_candidate_index = $flir_removal_plan_record_index("%plan_id%")
      PATCH_IF flir_candidate_index > flir_best_index BEGIN
        SET flir_best_index = flir_candidate_index
        SET flir_best_plan = plan_id
      END
    END
  END
END

DEFINE_PATCH_MACRO flir_removal_recheck_record BEGIN
  SET flir_record_offset = $flir_removal_plan_record_offset("%flir_best_plan%")
  SET flir_record_size = $flir_removal_plan_record_size("%flir_best_plan%")
  SET flir_expected_record_hash = $flir_removal_plan_record_hash("%flir_best_plan%")
  LPF flir_removal_hash_slice
    INT_VAR offset = flir_record_offset length = flir_record_size
    RET flir_current_record_hash = hash
  END
  PATCH_IF flir_current_record_hash != flir_expected_record_hash BEGIN
    SPRINT flir_drift_tier $flir_removal_plan_tier("%flir_best_plan%")
    SPRINT flir_drift_token $flir_removal_plan_token("%flir_best_plan%")
    SPRINT flir_drift_ident $flir_removal_plan_ident("%flir_best_plan%")
    PATCH_FAIL ~FLIR_REMOVAL_ERR PRECONDITION_DRIFT tier=%flir_drift_tier% token=%flir_drift_token% ident=%flir_drift_ident%~
  END
END

DEFINE_PATCH_MACRO flir_removal_apply_cre_resource BEGIN
  LPM flir_removal_assert_resource_precondition
  READ_LONG 0x2b8 flir_cre_slots_off ELSE 0
  READ_LONG 0x2bc flir_cre_items_off ELSE 0
  READ_LONG 0x2c0 flir_cre_items_count ELSE 0
  SET flir_more = 1
  WHILE flir_more BEGIN
    LPM flir_removal_select_next_plan
    PATCH_IF flir_best_plan = 0 BEGIN
      SET flir_more = 0
    END ELSE BEGIN
      LPM flir_removal_recheck_record
      SET flir_idx = $flir_removal_plan_record_index("%flir_best_plan%")
      SPRINT flir_replace $flir_removal_plan_replacement("%flir_best_plan%")
      PATCH_IF "%flir_replace%" STRING_COMPARE_CASE "blank" BEGIN
        WRITE_ASCIIE flir_record_offset "%flir_replace%" #8
      END ELSE BEGIN
        DELETE_BYTES flir_record_offset 0x14
        SET flir_cre_items_count -= 1
        WRITE_LONG 0x2c0 flir_cre_items_count
        PATCH_IF flir_cre_slots_off > flir_cre_items_off BEGIN
          SET flir_cre_slots_off -= 0x14
          WRITE_LONG 0x2b8 flir_cre_slots_off
        END
        FOR (flir_slot = 0; flir_slot < 37; ++flir_slot) BEGIN
          READ_SHORT flir_cre_slots_off + 2 * flir_slot flir_slot_ref ELSE 0xffff
          PATCH_IF flir_slot_ref = flir_idx BEGIN
            WRITE_SHORT flir_cre_slots_off + 2 * flir_slot 0xffff
          END ELSE PATCH_IF flir_slot_ref > flir_idx AND flir_slot_ref < 0xffff BEGIN
            WRITE_SHORT flir_cre_slots_off + 2 * flir_slot flir_slot_ref - 1
          END
        END
        PATCH_FOR_EACH flir_off IN 0x2a0 0x2a8 0x2b0 0x2b8 0x2c4 BEGIN
          READ_LONG flir_off flir_value ELSE 0
          PATCH_IF flir_value > flir_cre_items_off BEGIN
            WRITE_LONG flir_off flir_value - 0x14
          END
        END
      END
      SPRINT $flir_removal_plan_applied("%flir_best_plan%") "1"
      PATCH_IF $flir_removal_plan_emit("%flir_best_plan%") = 1 BEGIN
        INNER_ACTION BEGIN
          OUTER_SPRINT flir_emit_plan_id "%flir_best_plan%"
          LAM flir_removal_emit_plan
        END
      END
    END
  END
END

DEFINE_PATCH_MACRO flir_removal_apply_are_resource BEGIN
  LPM flir_removal_assert_resource_precondition
  READ_LONG 0x70 flir_are_con_off ELSE 0
  READ_SHORT 0x74 flir_are_con_count ELSE 0
  READ_SHORT 0x76 flir_are_items_count ELSE 0
  READ_LONG 0x78 flir_are_items_off ELSE 0
  SET flir_more = 1
  WHILE flir_more BEGIN
    LPM flir_removal_select_next_plan
    PATCH_IF flir_best_plan = 0 BEGIN
      SET flir_more = 0
    END ELSE BEGIN
      LPM flir_removal_recheck_record
      SET flir_idx = $flir_removal_plan_record_index("%flir_best_plan%")
      DELETE_BYTES flir_record_offset 0x14
      SET flir_are_items_count -= 1
      WRITE_SHORT 0x76 flir_are_items_count
      FOR (flir_con = 0; flir_con < flir_are_con_count; ++flir_con) BEGIN
        SET flir_con_off = flir_are_con_off + 0xc0 * flir_con
        READ_LONG flir_con_off + 0x40 flir_first ELSE 0
        READ_LONG flir_con_off + 0x44 flir_count ELSE 0
        PATCH_IF flir_idx >= flir_first AND flir_idx < flir_first + flir_count BEGIN
          WRITE_LONG flir_con_off + 0x44 flir_count - 1
        END ELSE PATCH_IF flir_first > flir_idx BEGIN
          WRITE_LONG flir_con_off + 0x40 flir_first - 1
        END
      END
      SET flir_adjust = 0 - 0x14
      PATCH_FOR_EACH flir_off IN 0x54 0x5c 0x60 0x68 0x70 0x7c 0x84 0x88 0xa0 0xa8 0xb0 0xb8 0xbc 0xc0 0xc4 0xcc BEGIN
        READ_LONG flir_off flir_value ELSE 0
        PATCH_IF flir_value > flir_are_items_off BEGIN
          WRITE_LONG flir_off flir_value + flir_adjust
        END
      END
      SPRINT $flir_removal_plan_applied("%flir_best_plan%") "1"
      PATCH_IF $flir_removal_plan_emit("%flir_best_plan%") = 1 BEGIN
        INNER_ACTION BEGIN
          OUTER_SPRINT flir_emit_plan_id "%flir_best_plan%"
          LAM flir_removal_emit_plan
        END
      END
    END
  END
END

DEFINE_PATCH_MACRO flir_removal_apply_store_resource BEGIN
  LPM flir_removal_assert_resource_precondition
  READ_LONG 0x34 flir_store_sale_off ELSE 0
  READ_LONG 0x38 flir_store_sale_count ELSE 0
  SET flir_more = 1
  WHILE flir_more BEGIN
    LPM flir_removal_select_next_plan
    PATCH_IF flir_best_plan = 0 BEGIN
      SET flir_more = 0
    END ELSE BEGIN
      LPM flir_removal_recheck_record
      DELETE_BYTES flir_record_offset 0x1c
      SET flir_store_sale_count -= 1
      WRITE_LONG 0x38 flir_store_sale_count
      PATCH_FOR_EACH flir_off IN 0x2c 0x4c 0x70 BEGIN
        READ_LONG flir_off flir_value ELSE 0
        PATCH_IF flir_value > flir_store_sale_off BEGIN
          WRITE_LONG flir_off flir_value - 0x1c
        END
      END
      SPRINT $flir_removal_plan_applied("%flir_best_plan%") "1"
      PATCH_IF $flir_removal_plan_emit("%flir_best_plan%") = 1 BEGIN
        INNER_ACTION BEGIN
          OUTER_SPRINT flir_emit_plan_id "%flir_best_plan%"
          LAM flir_removal_emit_plan
        END
      END
    END
  END
END

DEFINE_ACTION_MACRO flir_removal_plan_apply BEGIN
  ACTION_IF weidu_action = 0 BEGIN
    LAM flir_removal_validate_token_capacity

    ACTION_PHP_EACH flir_removal_plan_kind AS plan_id => plan_kind BEGIN
      ACTION_IF ("%plan_kind%" STRING_EQUAL_CASE "virtual"
              OR "%plan_kind%" STRING_EQUAL_CASE "script")
            AND !VARIABLE_IS_SET $flir_removal_plan_applied("%plan_id%") BEGIN
        OUTER_SPRINT flir_emit_plan_id "%plan_id%"
        OUTER_SPRINT removed_tier $flir_removal_plan_tier("%plan_id%")
        OUTER_SPRINT removed_token $flir_removal_plan_token("%plan_id%")
        OUTER_SPRINT removed_ident $flir_removal_plan_ident("%plan_id%")
        ACTION_IF "%plan_kind%" STRING_EQUAL_CASE "script" BEGIN
          LAM flir_removal_recheck_script_precondition
        END
        LAM flir_removal_emit_plan
        OUTER_SPRINT $flir_removal_plan_applied("%plan_id%") "1"
      END
    END

    ACTION_PHP_EACH flir_removal_plan_resource_key AS entry => blank BEGIN
      OUTER_SPRINT flir_apply_kind "%entry_0%"
      OUTER_SPRINT flir_apply_source "%entry_1%"
      ACTION_IF FILE_EXISTS_IN_GAME "%flir_apply_source%" BEGIN
        COPY_EXISTING "%flir_apply_source%" override
          PATCH_IF "%flir_apply_kind%" STRING_EQUAL_CASE "cre_inventory" BEGIN
            LPM flir_removal_apply_cre_resource
          END ELSE PATCH_IF "%flir_apply_kind%" STRING_EQUAL_CASE "area_container" BEGIN
            LPM flir_removal_apply_are_resource
          END ELSE PATCH_IF "%flir_apply_kind%" STRING_EQUAL_CASE "store" BEGIN
            LPM flir_removal_apply_store_resource
          END
        BUT_ONLY
      END ELSE BEGIN
        COPY "override/%flir_apply_source%" "override"
          PATCH_IF "%flir_apply_kind%" STRING_EQUAL_CASE "cre_inventory" BEGIN
            LPM flir_removal_apply_cre_resource
          END ELSE PATCH_IF "%flir_apply_kind%" STRING_EQUAL_CASE "area_container" BEGIN
            LPM flir_removal_apply_are_resource
          END ELSE PATCH_IF "%flir_apply_kind%" STRING_EQUAL_CASE "store" BEGIN
            LPM flir_removal_apply_store_resource
          END
        BUT_ONLY
      END
    END
    LAM flir_removal_run_legacy_adapter_post_hooks
    LAM flir_removal_plan_write_state
  END
END

DEFINE_ACTION_MACRO flir_removal_plan_publish_state BEGIN
  ACTION_IF flir_removal_state_ready != 1 BEGIN
    FAIL ~FLIR_REMOVAL_ERR STATE_NOT_READY tier= token= ident=~
  END
  COPY + "...blank" "override/fl#removeditems.2da"
    INSERT_BYTES 0 STRING_LENGTH ~%flir_removed_state%~
    WRITE_ASCIIE 0 ~%flir_removed_state%~ (STRING_LENGTH ~%flir_removed_state%~)
  BUT_ONLY
END

DEFINE_ACTION_MACRO flir_removal_plan_write_state BEGIN
  ACTION_IF weidu_action = 0 AND "%Preserve%" STRING_EQUAL_CASE "n" BEGIN
    OUTER_TEXT_SPRINT flir_removed_state ~Tier Token Ident%WNL%~
    ACTION_SORT_ARRAY_INDICES removed_item_array LEXICOGRAPHICALLY
    ACTION_PHP_EACH removed_item_array AS flir_removed_state_entry => blank BEGIN
      OUTER_TEXT_SPRINT flir_removed_state ~%flir_removed_state%%flir_removed_state_entry_0% %flir_removed_state_entry_1% %flir_removed_state_entry_2%%WNL%~
    END
    OUTER_SET flir_removal_state_ready = 1
    ACTION_IF !VARIABLE_IS_SET flir_mode1_defer_state_publication
          OR flir_mode1_defer_state_publication = 0 BEGIN
      LAM flir_removal_plan_publish_state
    END
  END
END
