// Retained legacy delivery adapters for the three authored script transforms.
//
// These are deliberately separate from ordinary actor delivery.  Both Mode 1
// backends must apply them after their ordinary-delivery branch, preserving the
// legacy tier/location iteration context and process_script_for_m1 semantics.

DEFINE_ACTION_MACRO flir_delivery_special_apply BEGIN
  ACTION_PHP_EACH tier_array AS flir_delivery_special_tier => blank BEGIN
    OUTER_SET flir_delivery_special_value = 0
    ACTION_PHP_EACH location_array AS flir_delivery_special_location => int BEGIN
      ACTION_IF "%flir_delivery_special_tier%" STRING_EQUAL_CASE "%flir_delivery_special_location_1%" BEGIN
        // Value remains the ordinal in the complete effective tier.  Invalid
        // or missing rows still consume their historical position.
        OUTER_SET flir_delivery_special_value += 1
        OUTER_SET Value = flir_delivery_special_value
        OUTER_SPRINT Tier "%flir_delivery_special_location_1%"
        OUTER_SPRINT res "%flir_delivery_special_location_2%"
        OUTER_SPRINT area "%flir_delivery_special_location_3%"

        ACTION_IF "%res%" STRING_EQUAL_CASE blpool.bcs
              AND FILE_EXISTS_IN_GAME blpool.bcs
              AND (BG1 = 0 OR BGT = 1) BEGIN
          OUTER_SPRINT target_bcs "%res%"
          OUTER_SPRINT baf flpool
          OUTER_SPRINT replace_trigger ~Global(\"Pool\",\"AR0801\",1)~
          LAUNCH_ACTION_FUNCTION process_script_for_m1
            INT_VAR Get_Tra = 1
            STR_VAR tra_array = blpool_item_tra
          END
          EXTEND_BOTTOM "%res%" "randomiser/baf/pool_out_of_items.baf"
        END

        ACTION_IF "%res%" STRING_EQUAL_CASE ppbook.bcs
              AND FILE_EXISTS_IN_GAME ppbook.bcs
              AND (BG1 = 0 OR BGT = 1) BEGIN
          OUTER_SPRINT target_bcs "%res%"
          OUTER_SPRINT baf flbook
          OUTER_SPRINT replace_trigger ~Global(\"page\",\"AR1513\",5)~
          LAUNCH_ACTION_FUNCTION process_script_for_m1 END
          EXTEND_BOTTOM "%res%" "randomiser/baf/book_out_of_items.baf"
        END

        ACTION_IF "%res%" STRING_EQUAL_CASE troalt.bcs
              AND FILE_EXISTS_IN_GAME troalt.bcs
              AND (BG1 = 0 OR BGT = 1) BEGIN
          OUTER_SPRINT target_bcs "%res%"
          OUTER_SPRINT baf fltroalt
          OUTER_SPRINT replace_trigger ~Contains(\"MISC9D\",Myself)~
          LAUNCH_ACTION_FUNCTION process_script_for_m1 END
          EXTEND_BOTTOM "%res%" "randomiser/baf/altar_out_of_items.baf"
        END
      END
    END
  END
END
