BEGIN ~anonymous virtual source retains declaration metadata~ DESIGNATED 92
  LAM flir_registry_harness_reset
  OUTER_SPRINT Preserve ~n~
  LAM flir_registry_preload_state
  LAM flir_registry_harness_reset_sources
  ACTION_CLEAR_ARRAY bg1_tiers
  ACTION_CLEAR_ARRAY bg2_tiers
  ACTION_CLEAR_ARRAY removed_item_array
  OUTER_SPRINT $bg2_tiers("1") ~~
  OUTER_SET flir_source_allow_override_availability = 1
  OUTER_SET flir_source_decl_count = 1
  OUTER_SPRINT flir_source_key ~anon:1:av0:anon0001:0~
  OUTER_SPRINT $flir_source_decl_order("1") ~%flir_source_key%~
  OUTER_SPRINT $flir_source_decl_exists("%flir_source_key%") ~1~
  OUTER_SET $flir_source_decl_enabled("%flir_source_key%") = 1
  OUTER_SPRINT $flir_source_decl_item("%flir_source_key%") ~anon0001~
  OUTER_SPRINT $flir_source_decl_replacement("%flir_source_key%") ~blank~
  OUTER_SPRINT $flir_source_decl_source("%flir_source_key%") ~blank~
  OUTER_SPRINT $flir_source_decl_tier("%flir_source_key%") ~1~
  OUTER_SPRINT $flir_source_decl_token("%flir_source_key%") ~av0~
  OUTER_SPRINT $flir_source_decl_ident("%flir_source_key%") ~x~
  OUTER_SET $flir_source_decl_chance("%flir_source_key%") = 100
  OUTER_SPRINT $flir_source_decl_source_kind("%flir_source_key%") ~virtual~
  OUTER_SPRINT $flir_source_decl_object_or_slot("%flir_source_key%") ~legacy_blank~
  OUTER_SPRINT $flir_source_decl_virtual_policy("%flir_source_key%") ~legacy_blank~
  OUTER_SET $flir_source_decl_expected_quantity("%flir_source_key%") = 1
  OUTER_SET flir_source_decl_count = 2
  OUTER_SPRINT flir_source_key ~anon:1:rawav:anon0002:1~
  OUTER_SPRINT $flir_source_decl_order("2") ~%flir_source_key%~
  OUTER_SPRINT $flir_source_decl_exists("%flir_source_key%") ~1~
  OUTER_SET $flir_source_decl_enabled("%flir_source_key%") = 1
  OUTER_SPRINT $flir_source_decl_item("%flir_source_key%") ~anon0002~
  OUTER_SPRINT $flir_source_decl_replacement("%flir_source_key%") ~blank~
  OUTER_SPRINT $flir_source_decl_source("%flir_source_key%") ~shop0001.sto~
  OUTER_SPRINT $flir_source_decl_tier("%flir_source_key%") ~1~
  OUTER_SPRINT $flir_source_decl_token("%flir_source_key%") ~rawav~
  OUTER_SPRINT $flir_source_decl_ident("%flir_source_key%") ~x~
  OUTER_SET $flir_source_decl_chance("%flir_source_key%") = 100
  OUTER_SPRINT $flir_source_decl_source_kind("%flir_source_key%") ~virtual~
  OUTER_SPRINT $flir_source_decl_object_or_slot("%flir_source_key%") ~explicit~
  OUTER_SPRINT $flir_source_decl_virtual_policy("%flir_source_key%") ~explicit~
  OUTER_SET $flir_source_decl_expected_quantity("%flir_source_key%") = 1
  OUTER_SPRINT $rebalance_tier("anon0002") ~1~
  OUTER_SPRINT $rebalance_token("anon0002") ~av1~
  LAM flir_source_filter_stage1
  LAM create_item_array#finalise
  LAM flir_removal_plan_build
  OUTER_TEXT_SPRINT h_plan_report ~PLAN_COUNT %flir_removal_plan_count%%WNL%~
  OUTER_FOR (h_plan_i = 1; h_plan_i <= flir_removal_plan_count; ++h_plan_i) BEGIN
    OUTER_SPRINT h_plan_kind $flir_removal_plan_kind("%h_plan_i%")
    OUTER_SPRINT h_plan_source $flir_removal_plan_source("%h_plan_i%")
    OUTER_SPRINT h_plan_token $flir_removal_plan_token("%h_plan_i%")
    OUTER_SPRINT h_plan_ident $flir_removal_plan_ident("%h_plan_i%")
    OUTER_SPRINT h_plan_policy $flir_removal_plan_container("%h_plan_i%")
    OUTER_TEXT_SPRINT h_plan_report ~%h_plan_report%PLANMETA %h_plan_token% %h_plan_ident% %h_plan_kind% %h_plan_source% %h_plan_policy%%WNL%~
  END
  COPY + "...blank" "%argv[1]%"
    INSERT_BYTES 0 STRING_LENGTH ~%h_plan_report%~
    WRITE_ASCIIE 0 ~%h_plan_report%~ (STRING_LENGTH ~%h_plan_report%~)
  BUT_ONLY

BEGIN ~legacy cursor preserves historical item location RNG order~ DESIGNATED 93
  LAM flir_registry_harness_reset
  OUTER_SET flir_registry_old_unmarked_migration = 1
  OUTER_SET flir_source_allow_override_availability = 1
  ACTION_CLEAR_ARRAY bg1_tiers
  ACTION_CLEAR_ARRAY bg2_tiers
  OUTER_SPRINT $bg2_tiers("1") ~~
  OUTER_FOR (h_seed = 1; h_seed <= 64; ++h_seed) BEGIN
    RANDOM_SEED "%h_seed%"
    OUTER_PATCH "" BEGIN
      LPF create_item_array#stage1#filter
        INT_VAR global_chance = 0 chance = 50 allow_override_availability = 1
        STR_VAR item = ~rng00001~ source = ~blank~ tier = ~1~ ident = ~blocked~
        RET h_hist_item1 = skip
      END
      LPF create_loc_array#filter
        INT_VAR chance = 50
        STR_VAR location = ~l1~ tier = ~1~ target = ~container~ area = ~blank~ ident = ~blocked~
        RET h_hist_loc1 = skip
      END
      LPF create_item_array#stage1#filter
        INT_VAR global_chance = 0 chance = 50 allow_override_availability = 1
        STR_VAR item = ~rng00002~ source = ~blank~ tier = ~1~ ident = ~second~
        RET h_hist_item2 = skip
      END
      LPF create_loc_array#filter
        INT_VAR chance = 50
        STR_VAR location = ~l2~ tier = ~1~ target = ~container~ area = ~blank~ ident = ~second~
        RET h_hist_loc2 = skip
      END
    END
    OUTER_SET h_hist_next = RANDOM(1 100)

    RANDOM_SEED "%h_seed%"
    LAM flir_registry_harness_reset_sources
    OUTER_SPRINT $ident_filter("blocked") ~~
    OUTER_SPRINT h_source_item ~rng00001~
    OUTER_SPRINT h_source_resource ~blank~
    OUTER_SPRINT h_source_tier ~1~
    OUTER_SPRINT h_source_token ~r1~
    OUTER_SPRINT h_source_ident ~blocked~
    OUTER_SET h_source_chance = 50
    OUTER_SPRINT h_source_kind ~virtual~
    OUTER_SPRINT h_source_virtual_policy ~legacy_blank~
    LAM flir_registry_harness_add_named_source
    LAM flir_source_filter_stage1_legacy_ident_filter
    OUTER_PATCH "" BEGIN
      LPF create_loc_array#filter
        INT_VAR chance = 50
        STR_VAR location = ~l1~ tier = ~1~ target = ~container~ area = ~blank~ ident = ~blocked~
        RET h_prod_loc1 = skip
      END
    END
    OUTER_SPRINT h_source_item ~rng00002~
    OUTER_SPRINT h_source_token ~r2~
    OUTER_SPRINT h_source_ident ~second~
    LAM flir_registry_harness_add_named_source
    LAM flir_source_filter_stage1_legacy_ident_filter
    OUTER_PATCH "" BEGIN
      LPF create_loc_array#filter
        INT_VAR chance = 50
        STR_VAR location = ~l2~ tier = ~1~ target = ~container~ area = ~blank~ ident = ~second~
        RET h_prod_loc2 = skip
      END
    END
    LAM flir_source_filter_stage1
    OUTER_SET h_prod_item1 = $flir_source_legacy_filter_skip("ident:blocked")
    OUTER_SET h_prod_item2 = $flir_source_legacy_filter_skip("ident:second")
    OUTER_SET h_prod_next = RANDOM(1 100)
    ACTION_IF h_hist_item1 != h_prod_item1
          OR h_hist_loc1 != h_prod_loc1
          OR h_hist_item2 != h_prod_item2
          OR h_hist_loc2 != h_prod_loc2
          OR h_hist_next != h_prod_next BEGIN
      LAF flir_registry_fail STR_VAR code = ~LEGACY_RNG_DRIFT~ kind = ~filter~ id = EVAL ~%h_seed%~ END
    END
  END
  OUTER_TEXT_SPRINT h_rng_report ~RNG_ORDER_OK 64%WNL%~
  COPY + "...blank" "%argv[1]%"
    INSERT_BYTES 0 STRING_LENGTH ~%h_rng_report%~
    WRITE_ASCIIE 0 ~%h_rng_report%~ (STRING_LENGTH ~%h_rng_report%~)
  BUT_ONLY

BEGIN ~final source filtering preserves campaign-local tier ownership~ DESIGNATED 94
  LAM flir_registry_harness_reset
  OUTER_SPRINT Preserve ~n~
  LAM flir_registry_preload_state
  LAM flir_registry_harness_reset_sources
  ACTION_CLEAR_ARRAY bg1_tiers
  ACTION_CLEAR_ARRAY bg2_tiers
  // Production location staging has already established the campaign tiers.
  OUTER_SPRINT $bg2_tiers("1") ~~
  OUTER_SPRINT $bg1_tiers("24") ~~
  OUTER_SET flir_source_allow_override_availability = 1

  OUTER_SPRINT h_source_campaign ~bg2~
  OUTER_SPRINT h_source_item ~synt0001~
  OUTER_SPRINT h_source_resource ~shop0001.sto~
  OUTER_SPRINT h_source_tier ~1~
  OUTER_SPRINT h_source_token ~1~
  OUTER_SPRINT h_source_ident ~alpha~
  OUTER_SET h_source_chance = 100
  OUTER_SPRINT h_source_kind ~store~
  OUTER_SPRINT h_source_virtual_policy ~~
  LAM flir_registry_harness_add_named_source

  OUTER_SPRINT h_source_campaign ~bg1~
  OUTER_SPRINT h_source_item ~synt0002~
  OUTER_SPRINT h_source_tier ~24~
  OUTER_SPRINT h_source_token ~1~
  OUTER_SPRINT h_source_ident ~beta~
  LAM flir_registry_harness_add_named_source

  OUTER_TEXT_SPRINT h_campaign_extension ~2DA V1.0%WNL%0%WNL%OP ITEM REPLACEMENT SOURCE TIER TOKEN IDENT CHANCE SOURCE_KIND OBJECT_OR_SLOT VIRTUAL_POLICY CHARGE1 CHARGE2 CHARGE3 EXPECTED_QUANTITY%WNL%ADD anon0001 blank blank 1 ax x 100 virtual legacy_blank legacy_blank 0 0 0 1%WNL%REPLACE synt0002 blank shop0001.sto 24 1 beta 100 store * none 0 0 0 1%WNL%~
  COPY + "...blank" "override/fl#campaign-ext.2da"
    INSERT_BYTES 0 STRING_LENGTH ~%h_campaign_extension%~
    WRITE_ASCIIE 0 ~%h_campaign_extension%~ (STRING_LENGTH ~%h_campaign_extension%~)
  BUT_ONLY
  OUTER_SPRINT flir_source_extension_fixture ~override/fl#campaign-ext.2da~
  LAM flir_source_apply_extension_hook

  // Match the real EET tail: BG1 was staged last before one all-catalog pass.
  OUTER_SPRINT tier_hook ~bg1_tiers~
  LAM flir_source_filter_stage1

  OUTER_SET h_bg2_tier_1 = 0
  OUTER_SET h_bg2_tier_24 = 0
  OUTER_SET h_bg1_tier_1 = 0
  OUTER_SET h_bg1_tier_24 = 0
  ACTION_IF VARIABLE_IS_SET $bg2_tiers("1") BEGIN OUTER_SET h_bg2_tier_1 = 1 END
  ACTION_IF VARIABLE_IS_SET $bg2_tiers("24") BEGIN OUTER_SET h_bg2_tier_24 = 1 END
  ACTION_IF VARIABLE_IS_SET $bg1_tiers("1") BEGIN OUTER_SET h_bg1_tier_1 = 1 END
  ACTION_IF VARIABLE_IS_SET $bg1_tiers("24") BEGIN OUTER_SET h_bg1_tier_24 = 1 END
  OUTER_SPRINT flir_registry_tier_for_campaign ~1~
  LAM flir_registry_campaign_for_tier
  OUTER_SPRINT h_tier_1_campaign ~%flir_registry_detected_campaign%~
  OUTER_SPRINT flir_registry_tier_for_campaign ~24~
  LAM flir_registry_campaign_for_tier
  OUTER_SPRINT h_tier_24_campaign ~%flir_registry_detected_campaign%~
  OUTER_SPRINT h_alpha_hook ~missing~
  OUTER_SPRINT h_beta_hook ~missing~
  OUTER_SPRINT h_anon_hook ~missing~
  ACTION_IF VARIABLE_IS_SET $flir_source_decl_tier_hook("ident:alpha") BEGIN
    OUTER_SPRINT h_alpha_hook $flir_source_decl_tier_hook("ident:alpha")
  END
  ACTION_IF VARIABLE_IS_SET $flir_source_decl_tier_hook("ident:beta") BEGIN
    OUTER_SPRINT h_beta_hook $flir_source_decl_tier_hook("ident:beta")
  END
  ACTION_IF VARIABLE_IS_SET $flir_source_decl_tier_hook("anon:1:ax:anon0001:2") BEGIN
    OUTER_SPRINT h_anon_hook $flir_source_decl_tier_hook("anon:1:ax:anon0001:2")
  END
  OUTER_TEXT_SPRINT h_campaign_report ~ROUTE bg2 1 %h_bg2_tier_1%%WNL%ROUTE bg2 24 %h_bg2_tier_24%%WNL%ROUTE bg1 1 %h_bg1_tier_1%%WNL%ROUTE bg1 24 %h_bg1_tier_24%%WNL%CAMPAIGN 1 %h_tier_1_campaign%%WNL%CAMPAIGN 24 %h_tier_24_campaign%%WNL%DECL ident:alpha %h_alpha_hook%%WNL%DECL ident:beta %h_beta_hook%%WNL%DECL anon:1:ax:anon0001:2 %h_anon_hook%%WNL%~
  COPY + "...blank" "%argv[1]%"
    INSERT_BYTES 0 STRING_LENGTH ~%h_campaign_report%~
    WRITE_ASCIIE 0 ~%h_campaign_report%~ (STRING_LENGTH ~%h_campaign_report%~)
  BUT_ONLY

