  OUTER_SPRINT $location_array#stage1("raw200" "1" "target-removed.cre" "area-removed" "removed") ~~
  LAM flir_registry_capture_old_unmarked_legacy_slots
  OUTER_SPRINT $location_array("raw050" "1" "target-added.cre" "area-added" "added") ~~
  OUTER_SPRINT $location_array("raw100" "1" "target-keep.cre" "area-keep" "keep") ~~
  LAM flir_registry_capture_final_slots
  LAM flir_registry_reconcile
  LAM flir_registry_write_state
  LAM flir_registry_harness_write_report

BEGIN ~old migration reuses chance filter decision~ DESIGNATED 66
  LAM flir_registry_harness_reset
  OUTER_SPRINT Preserve ~y~
  LAM flir_registry_harness_ensure_legacy_state
  LAM flir_registry_preload_state
  ACTION_CLEAR_ARRAY bg1_tiers
  ACTION_CLEAR_ARRAY bg2_tiers
  OUTER_SPRINT $bg2_tiers("1") ~~
  OUTER_SET flir_source_allow_override_availability = 1
  OUTER_SET flir_source_decl_count = 1
  OUTER_SPRINT $flir_source_decl_order("1") ~chance~
  OUTER_SET $flir_source_decl_enabled("chance") = 1
  OUTER_SPRINT $flir_source_decl_item("chance") ~synt0001~
  OUTER_SPRINT $flir_source_decl_replacement("chance") ~none~
  OUTER_SPRINT $flir_source_decl_source("chance") ~blank~
  OUTER_SPRINT $flir_source_decl_tier("chance") ~1~
  OUTER_SPRINT $flir_source_decl_token("chance") ~1~
  OUTER_SPRINT $flir_source_decl_ident("chance") ~chanceident~
  OUTER_SET $flir_source_decl_chance("chance") = 50
  OUTER_FOR (h_seed = 1; h_seed <= 32; ++h_seed) BEGIN
    ACTION_CLEAR_ARRAY ident_filter
    ACTION_CLEAR_ARRAY item_array#stage1
    LAM flir_source_legacy_snapshot_reset
    RANDOM_SEED "%h_seed%"
    LAM flir_source_filter_stage1_legacy_ident_filter
    OUTER_SET h_legacy_skip = 0
    ACTION_IF VARIABLE_IS_SET $flir_registry_legacy_ident_filter("chanceident") BEGIN
      OUTER_SET h_legacy_skip = 1
    END
    LAM flir_source_filter_stage1
    OUTER_SET h_final_skip = 0
    ACTION_IF VARIABLE_IS_SET $ident_filter("chanceident") BEGIN
      OUTER_SET h_final_skip = 1
    END
    ACTION_IF h_legacy_skip != h_final_skip BEGIN
      LAF flir_registry_fail STR_VAR code = ~FILTER_REROLL~ kind = ~unit~ id = ~chanceident~ END
    END
  END

