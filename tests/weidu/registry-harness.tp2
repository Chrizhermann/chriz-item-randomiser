  OUTER_SPRINT $location_array#stage1("raw005" "1" "target-old-b.cre" "area-old-b" "old_b") ~~
  LAM flir_registry_capture_old_unmarked_legacy_slots
  OUTER_SPRINT $location_array("raw001" "1" "target-new.cre" "area-new" "new") ~~
  OUTER_SPRINT $location_array("raw999" "1" "target-old-a.cre" "area-old-a" "old_a") ~~
  OUTER_SPRINT $location_array("raw005" "1" "target-old-b.cre" "area-old-b" "old_b") ~~
