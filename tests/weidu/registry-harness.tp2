BEGIN ~preserve after rebase follows fresh overflow ordering~ DESIGNATED 121
  LAM flir_registry_harness_reset
  OUTER_SPRINT Preserve ~y~
  LAM flir_registry_preload_state
  LAM flir_registry_harness_run_mixed_probe
  COPY + "...blank" "%argv[1]%"
    INSERT_BYTES 0 STRING_LENGTH ~%h_mixed_report%~
    WRITE_ASCIIE 0 ~%h_mixed_report%~ (STRING_LENGTH ~%h_mixed_report%~)
  BUT_ONLY

BEGIN ~authored identity sharing replay tuple remains overflow eligible~ DESIGNATED 122
  LAM flir_registry_harness_reset
  ACTION_CLEAR_ARRAY h_replay_tiers
  ACTION_CLEAR_ARRAY h_replay_units
  ACTION_CLEAR_ARRAY h_replay_locations
  OUTER_SPRINT $h_replay_tiers("1") ~~
  OUTER_SPRINT $h_replay_units("1" "1" "alpha") ~~
  OUTER_SPRINT $h_replay_units("1" "2" "beta") ~~
  OUTER_SPRINT $h_replay_units("1" "3" "gamma") ~~
  OUTER_SPRINT $h_replay_locations("150" "1" "same.cre" "same-area" "") ~~
  OUTER_SPRINT $h_replay_locations("150" "1" "same.cre" "same-area" "authored") ~~
  OUTER_SPRINT $flir_registry_legacy_overflow_location("150" "1" "same.cre" "same-area") ~~

  OUTER_SPRINT flir_registry_overflow_tier_array ~h_replay_tiers~
  OUTER_SPRINT flir_registry_overflow_unit_array ~h_replay_units~
  OUTER_SPRINT flir_registry_overflow_location_array ~h_replay_locations~
  OUTER_SET flir_registry_overflow_capture_cache = 0
  OUTER_SET flir_registry_overflow_continue_cache = 1
  OUTER_SET flir_registry_overflow_normalize_identity = 1
  RANDOM_SEED "122"
  LAM flir_registry_allocate_overflow_locations

  OUTER_SET h_replay_generated = 0
  ACTION_PHP_EACH h_replay_locations AS h_replay_location => blank BEGIN
    ACTION_IF "%h_replay_location_0%" STRING_EQUAL_CASE "101"
          AND "%h_replay_location_1%" STRING_EQUAL_CASE "1"
          AND "%h_replay_location_2%" STRING_EQUAL_CASE "same.cre"
          AND "%h_replay_location_3%" STRING_EQUAL_CASE "same-area"
          AND "%h_replay_location_4%" STRING_EQUAL_CASE "" BEGIN
      OUTER_SET h_replay_generated += 1
    END
  END
  OUTER_TEXT_SPRINT h_replay_report ~ELIGIBLE %flir_registry_overflow_eligible_count%%WNL%GENERATED %h_replay_generated%%WNL%~
  COPY + "...blank" "%argv[1]%"
    INSERT_BYTES 0 STRING_LENGTH ~%h_replay_report%~
    WRITE_ASCIIE 0 ~%h_replay_report%~ (STRING_LENGTH ~%h_replay_report%~)
  BUT_ONLY

BEGIN ~catalog finalization requires compact reconciliation~ DESIGNATED 123
  LAM flir_registry_harness_reset
  LAM flir_registry_finalize_catalog

BEGIN ~state writing requires catalog finalization~ DESIGNATED 124
  LAM flir_registry_harness_reset
  OUTER_SPRINT h_tier ~1~
  OUTER_SPRINT h_id ~core:slot-readiness~
  LAM flir_registry_harness_add_slot
  LAM flir_registry_reconcile_mappings
  LAM flir_registry_write_state

BEGIN ~slot registration API and split reconciliation~ DESIGNATED 125
  LAM flir_registry_harness_reset
  OUTER_SPRINT flir_registry_register_campaign ~bg2~
  OUTER_SPRINT flir_registry_register_tier ~1~
  OUTER_SPRINT flir_registry_register_stable ~core:slot-api~
  OUTER_SPRINT flir_registry_register_compact ~~
  LAM flir_registry_register_slot
  LAM flir_registry_reconcile_mappings
  LAM flir_registry_finalize_catalog
  LAM flir_registry_write_state
  LAF flir_registry_canonical_rows RET h_api_rows = rows END
  OUTER_SPRINT h_api_compact $flir_registry_catalog_slot_compact("bg2" "1" "core:slot-api")
  OUTER_TEXT_SPRINT h_api_report ~REGAPI compact=%h_api_compact% ready=%flir_registry_compacts_ready% finalized=%flir_registry_catalog_finalized%%WNL%%h_api_rows%~
  COPY + ~...blank~ ~%argv[1]%~
    INSERT_BYTES 0 STRING_LENGTH ~%h_api_report%~
    WRITE_ASCIIE 0 ~%h_api_report%~ (STRING_LENGTH ~%h_api_report%~)
  BUT_ONLY

BEGIN ~disabled slots persist as monotonic tombstones~ DESIGNATED 126
  LAM flir_registry_harness_reset
  OUTER_SET flir_registry_store_enabled = 1
  OUTER_SPRINT flir_registry_store_campaign ~bg2~
  OUTER_SPRINT flir_registry_store_tier ~1~
  OUTER_SPRINT flir_registry_store_kind ~slot~
  OUTER_SPRINT flir_registry_store_stable ~ext:slot-old-active~
  OUTER_SPRINT flir_registry_store_compact ~7~
  LAM flir_registry_store_row
  OUTER_SPRINT flir_registry_register_campaign ~bg2~
  OUTER_SPRINT flir_registry_register_tier ~1~
  OUTER_SPRINT flir_registry_register_stable ~ext:slot-old-active~
  OUTER_SPRINT flir_registry_register_compact ~~
  LAM flir_registry_register_slot_tombstone
  OUTER_SPRINT flir_registry_register_stable ~ext:slot-fresh-disabled~
  LAM flir_registry_register_slot_tombstone
  LAM flir_registry_reconcile_mappings
  LAM flir_registry_finalize_catalog
  LAF flir_registry_canonical_rows RET h_tombstone_rows = rows END
  OUTER_SPRINT h_tombstone_old_compact $flir_registry_compact("bg2" "1" "slot" "ext:slot-old-active")
  OUTER_SET h_tombstone_old_enabled = $flir_registry_enabled("bg2" "1" "slot" "ext:slot-old-active")
  OUTER_SPRINT h_tombstone_fresh_compact $flir_registry_compact("bg2" "1" "slot" "ext:slot-fresh-disabled")
  OUTER_SET h_tombstone_fresh_enabled = $flir_registry_enabled("bg2" "1" "slot" "ext:slot-fresh-disabled")
  OUTER_SET h_tombstone_max = $flir_registry_scope_max("bg2|1|slot")
  OUTER_TEXT_SPRINT h_tombstone_report ~TOMBSTONES old=%h_tombstone_old_compact%/%h_tombstone_old_enabled% fresh=%h_tombstone_fresh_compact%/%h_tombstone_fresh_enabled% max=%h_tombstone_max%%WNL%%h_tombstone_rows%~
  COPY + ~...blank~ ~%argv[1]%~
    INSERT_BYTES 0 STRING_LENGTH ~%h_tombstone_report%~
    WRITE_ASCIIE 0 ~%h_tombstone_report%~ (STRING_LENGTH ~%h_tombstone_report%~)
  BUT_ONLY

BEGIN ~disabled slot cannot be resurrected~ DESIGNATED 127
  LAM flir_registry_harness_reset
  OUTER_SET flir_registry_store_enabled = 0
  OUTER_SPRINT flir_registry_store_campaign ~bg2~
  OUTER_SPRINT flir_registry_store_tier ~1~
  OUTER_SPRINT flir_registry_store_kind ~slot~
  OUTER_SPRINT flir_registry_store_stable ~ext:slot-disabled~
