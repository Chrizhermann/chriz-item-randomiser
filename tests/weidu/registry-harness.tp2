  OUTER_SET flir_endpoint_slot_arg_value = 0
  OUTER_SET flir_endpoint_slot_arg_enabled = 0
  LAM flir_endpoints_add_slot
  LAM flir_endpoints_validate
  LAM flir_endpoints_register_registry_slots
  LAM flir_registry_reconcile_mappings
  LAM flir_endpoints_claim_slots
  LAM flir_endpoints_register_catalog_rows
  LAM flir_registry_finalize_catalog
  LAM flir_registry_write_state
  OUTER_SET h_endpoint_registry_compact = $flir_registry_compact("bg2" "1" "slot" "ext:slot-disabled")
  OUTER_SET h_endpoint_registry_enabled = $flir_registry_enabled("bg2" "1" "slot" "ext:slot-disabled")
  OUTER_SET h_endpoint_catalog_enabled = $flir_catalog_enabled("slot" "ext:slot-disabled")
  OUTER_TEXT_SPRINT h_endpoint_registry_report ~ENDPOINT_REGISTRY compact=%h_endpoint_registry_compact% registry=%h_endpoint_registry_enabled% catalog=%h_endpoint_catalog_enabled%%WNL%~
  COPY + ~...blank~ ~%argv[1]%~
    INSERT_BYTES 0 STRING_LENGTH ~%h_endpoint_registry_report%~
    WRITE_ASCIIE 0 ~%h_endpoint_registry_report%~ (STRING_LENGTH ~%h_endpoint_registry_report%~)
  BUT_ONLY

