  COPY + "...blank" "override/fl#mutated.mrk"
    INSERT_BYTES 0 7
    WRITE_ASCIIE 0 ~mutated~ #7
  BUT_ONLY

BEGIN ~deferred persistent state survives a later rollback~ DESIGNATED 111
