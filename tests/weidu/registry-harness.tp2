BEGIN ~planned base compact collision before mutation~ DESIGNATED 80
  LAM flir_registry_harness_reset
  OUTER_SPRINT h_schema ~flir-registry-v1~
  OUTER_SPRINT h_backend ~legacy-bcs-v1~
  OUTER_SET h_catalog = 11111
  OUTER_TEXT_SPRINT h_rows ~bg2 1 unit legacy:unit-bg2-1-1-other 1 1%WNL%~
  LAM flir_registry_harness_write_raw_fixture
  LAM flir_registry_harness_reset
  ACTION_CLEAR_ARRAY bg1_tiers
  ACTION_CLEAR_ARRAY bg2_tiers
  OUTER_SPRINT $bg2_tiers("1") ~~
  LAM flir_registry_preload_state
  OUTER_SET flir_removal_plan_count = 1
  OUTER_SET $flir_removal_plan_emit_count("1") = 1
  OUTER_SPRINT $flir_removal_plan_tier("1") ~1~
  OUTER_SPRINT $flir_removal_plan_token("1") ~1~
  OUTER_SPRINT $flir_removal_plan_ident("1") ~alpha~
