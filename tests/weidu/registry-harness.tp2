  BUT_ONLY

BEGIN ~migration filtered preextension contract~ DESIGNATED 60
  LAM flir_registry_harness_reset
  OUTER_SET flir_source_allow_override_availability = 1
  OUTER_SPRINT Preserve ~y~
  LAM flir_registry_harness_ensure_legacy_state
  LAM flir_registry_preload_state
  ACTION_CLEAR_ARRAY bg1_tiers
  ACTION_CLEAR_ARRAY bg2_tiers
  ACTION_CLEAR_ARRAY ident_filter
  ACTION_CLEAR_ARRAY location_array#stage1
  ACTION_CLEAR_ARRAY location_array
  ACTION_CLEAR_ARRAY flir_source_decl_order
  ACTION_CLEAR_ARRAY flir_source_decl_enabled
  ACTION_CLEAR_ARRAY flir_source_decl_item
  ACTION_CLEAR_ARRAY flir_source_decl_replacement
  ACTION_CLEAR_ARRAY flir_source_decl_source
  ACTION_CLEAR_ARRAY flir_source_decl_tier
  ACTION_CLEAR_ARRAY flir_source_decl_token
  ACTION_CLEAR_ARRAY flir_source_decl_ident
  ACTION_CLEAR_ARRAY flir_source_decl_chance
  OUTER_SPRINT $bg2_tiers("1") ~~
  OUTER_SET flir_source_decl_count = 2
  OUTER_SPRINT $flir_source_decl_order("1") ~keep~
  OUTER_SPRINT $flir_source_decl_enabled("keep") ~1~
  OUTER_SPRINT $flir_source_decl_item("keep") ~synt0001~
  OUTER_SPRINT $flir_source_decl_replacement("keep") ~none~
  OUTER_SPRINT $flir_source_decl_source("keep") ~blank~
  OUTER_SPRINT $flir_source_decl_tier("keep") ~1~
  OUTER_SPRINT $flir_source_decl_token("keep") ~1~
  OUTER_SPRINT $flir_source_decl_ident("keep") ~keepdyn~
  OUTER_SET $flir_source_decl_chance("keep") = 100
  OUTER_SPRINT $flir_source_decl_order("2") ~skip~
  OUTER_SET $flir_source_decl_enabled("skip") = 0
  OUTER_SPRINT $flir_source_decl_item("skip") ~synt0002~
  OUTER_SPRINT $flir_source_decl_replacement("skip") ~none~
  OUTER_SPRINT $flir_source_decl_source("skip") ~blank~
  OUTER_SPRINT $flir_source_decl_tier("skip") ~1~
  OUTER_SPRINT $flir_source_decl_token("skip") ~2~
  OUTER_SPRINT $flir_source_decl_ident("skip") ~skipdyn~
  OUTER_SET $flir_source_decl_chance("skip") = 100
  OUTER_SPRINT $location_array#stage1("raw100" "1" "target-a.cre" "area-a" "keepdyn") ~~
  OUTER_SPRINT $location_array#stage1("raw200" "1" "target-b.cre" "area-b" "skipdyn") ~~
  LAM flir_source_filter_stage1_legacy_ident_filter
  LAM flir_registry_capture_old_unmarked_legacy_slots
  OUTER_SPRINT $location_array("raw050" "1" "target-ext.cre" "area-ext" "extdyn") ~~
  OUTER_SPRINT $location_array("raw100" "1" "target-a.cre" "area-a" "keepdyn") ~~
  LAM flir_registry_capture_final_slots
  LAM flir_registry_reconcile
  LAM flir_registry_write_state
  LAM flir_registry_harness_write_report

