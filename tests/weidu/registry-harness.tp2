BEGIN ~generated slot extension disable persists first install~ DESIGNATED 130
  LAM flir_registry_harness_reset
  LAM flir_endpoints_reset
  LAM flir_registry_harness_generated_endpoint
  OUTER_SPRINT flir_endpoint_allocate_campaign ~bg2~
  OUTER_SPRINT flir_endpoint_allocate_tier ~1~
  OUTER_SPRINT flir_endpoint_allocate_band ~bg2:1~
  OUTER_SET flir_endpoint_allocate_demand = 1
  OUTER_SPRINT flir_endpoint_allocate_provider ~core~
  OUTER_SPRINT flir_endpoint_allocate_id ~generated-first~
  LAM flir_endpoints_allocate_rounds
  OUTER_SPRINT h_generated_slot $flir_endpoint_slot_order("1")
  OUTER_SET flir_endpoint_extension_expected_fingerprint = $flir_endpoint_slot_row_fingerprint("%h_generated_slot%")
  OUTER_SET h_generated_first_fingerprint = flir_endpoint_extension_expected_fingerprint
  COPY + ~...blank~ ~override/h#gfpr.dat~
    INSERT_BYTES 0 4
    WRITE_LONG 0 h_generated_first_fingerprint
  BUT_ONLY
  OUTER_SPRINT flir_endpoint_extension_kind ~slot~
  OUTER_SPRINT flir_endpoint_extension_operation ~DISABLE~
  OUTER_SPRINT flir_endpoint_extension_actor_provider ~compat~
  OUTER_SPRINT flir_endpoint_extension_provider ~flir~
  OUTER_SPRINT flir_endpoint_extension_id $flir_endpoint_slot_local_id("%h_generated_slot%")
  LAM flir_endpoints_apply
  LAM flir_endpoints_validate
  LAM flir_endpoints_register_registry_slots
  LAM flir_registry_reconcile_mappings
  LAM flir_endpoints_claim_slots
  LAM flir_endpoints_register_catalog_rows
  LAM flir_registry_finalize_catalog
  LAM flir_registry_write_state
  OUTER_SET h_generated_first_value = $flir_endpoint_slot_value("%h_generated_slot%")
  OUTER_TEXT_SPRINT h_generated_first_report ~GENERATED_DISABLE_FIRST enabled=0 value=%h_generated_first_value%%WNL%~
  COPY + ~...blank~ ~%argv[1]%~
    INSERT_BYTES 0 STRING_LENGTH ~%h_generated_first_report%~
    WRITE_ASCIIE 0 ~%h_generated_first_report%~ (STRING_LENGTH ~%h_generated_first_report%~)
  BUT_ONLY

BEGIN ~generated slot extension disable replays next install~ DESIGNATED 131
  LAM flir_registry_harness_reset
  OUTER_SPRINT Preserve ~y~
  LAM flir_registry_preload_state
  LAM flir_endpoints_reset
  LAM flir_registry_harness_generated_endpoint
  OUTER_SPRINT flir_endpoint_generated_campaign ~bg2~
  OUTER_SPRINT flir_endpoint_generated_tier ~1~
  OUTER_SPRINT flir_endpoint_generated_band ~bg2:1~
  OUTER_SPRINT flir_endpoint_generated_endpoint ~core:endpoint-generated~
  OUTER_SET flir_endpoint_generated_round = 1
  OUTER_SET flir_endpoint_generated_generation = 0
  LAM flir_endpoints_generated_slot_identity
  LAM flir_endpoints_rehydrate_generated_slots
  OUTER_SET h_generated_original_fingerprint = 0
  COPY_EXISTING - ~h#gfpr.dat~ ~.../randomiser/fl-inlined/h#gfpr.dat~
    LAUNCH_PATCH_MACRO flir_registry_harness_read_generated_fingerprint
  OUTER_SET h_generated_rehydrated_fingerprint = 0
  ACTION_IF VARIABLE_IS_SET $flir_endpoint_slot_present("%flir_endpoint_generated_qualified%") BEGIN
    OUTER_SET h_generated_rehydrated_fingerprint = $flir_endpoint_slot_row_fingerprint("%flir_endpoint_generated_qualified%")
  END
  ACTION_IF h_generated_original_fingerprint < 1
        OR h_generated_rehydrated_fingerprint != h_generated_original_fingerprint BEGIN
    FAIL ~FLIR_ENDPOINT_ERR FIXTURE_FINGERPRINT provider=test id=generated-replay~
  END
  OUTER_SET flir_endpoint_extension_expected_fingerprint = h_generated_original_fingerprint
  OUTER_SPRINT flir_endpoint_extension_kind ~slot~
  OUTER_SPRINT flir_endpoint_extension_operation ~DISABLE~
  OUTER_SPRINT flir_endpoint_extension_actor_provider ~compat~
  OUTER_SPRINT flir_endpoint_extension_provider ~flir~
  OUTER_SPRINT flir_endpoint_extension_id ~%flir_endpoint_generated_local%~
  LAM flir_endpoints_apply
  LAM flir_endpoints_validate
  LAM flir_endpoints_register_registry_slots
  LAM flir_registry_reconcile_mappings
  LAM flir_endpoints_claim_slots
  LAM flir_endpoints_register_catalog_rows
  LAM flir_registry_finalize_catalog
  LAM flir_registry_write_state
  OUTER_SET h_generated_replay_value = $flir_endpoint_slot_value("%flir_endpoint_generated_qualified%")
  OUTER_SET h_generated_replay_enabled = $flir_endpoint_slot_enabled("%flir_endpoint_generated_qualified%")
  OUTER_TEXT_SPRINT h_generated_replay_report ~GENERATED_DISABLE_REPLAY enabled=%h_generated_replay_enabled% value=%h_generated_replay_value%%WNL%~
  COPY + ~...blank~ ~%argv[1]%~
    INSERT_BYTES 0 STRING_LENGTH ~%h_generated_replay_report%~
    WRITE_ASCIIE 0 ~%h_generated_replay_report%~ (STRING_LENGTH ~%h_generated_replay_report%~)
  BUT_ONLY
