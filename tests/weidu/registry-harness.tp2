// Hermetic synthetic-game registry harness. Every ID and resource is synthetic.
// argv[0] = production registry.tpa
// argv[1] = output report path
// argv[2] = production removal_plan.tpa
// argv[3] = production lib.tpa (shared source-filter implementation)
// argv[4] = production catalog.tpa
// argv[5] = production endpoints.tpa

BACKUP ~backup~
AUTHOR ~BG2 Item Randomiser registry test harness~

ALWAYS
  INCLUDE ~%argv[3]%~
  INCLUDE ~%argv[4]%~
  INCLUDE ~%argv[0]%~
  INCLUDE ~%argv[5]%~
  INCLUDE ~%argv[2]%~
END

DEFINE_ACTION_MACRO flir_registry_harness_reset BEGIN
  OUTER_SET weidu_action = 0
  OUTER_SET RandomNotRandom = 0
  OUTER_SPRINT flir_registry_backend ~legacy-bcs-v1~
  OUTER_SPRINT h_origin ~fresh-postextension-v1~
  OUTER_SPRINT h_campaign ~bg2~
  LAM flir_registry_reset
END

DEFINE_ACTION_MACRO flir_registry_harness_ensure_legacy_state BEGIN
  ACTION_IF NOT FILE_EXISTS_IN_GAME "fl#randomseed.2da"
        AND NOT FILE_EXISTS "override/fl#randomseed.2da" BEGIN
    COPY + "...blank" "override/fl#randomseed.2da"
      INSERT_BYTES 0 6
      WRITE_LONG 0 1
      WRITE_BYTE 4 0
      WRITE_BYTE 5 0
    BUT_ONLY
  END
  ACTION_IF NOT FILE_EXISTS_IN_GAME "fl#removeditems.2da"
        AND NOT FILE_EXISTS "override/fl#removeditems.2da" BEGIN
    OUTER_TEXT_SPRINT h_legacy_removed_fixture ~Tier Token Ident%WNL%~
    COPY + "...blank" "override/fl#removeditems.2da"
      INSERT_BYTES 0 STRING_LENGTH ~%h_legacy_removed_fixture%~
      WRITE_ASCIIE 0 ~%h_legacy_removed_fixture%~ (STRING_LENGTH ~%h_legacy_removed_fixture%~)
    BUT_ONLY
  END
  ACTION_IF NOT FILE_EXISTS_IN_GAME "fl#randoptions.2da"
        AND NOT FILE_EXISTS "override/fl#randoptions.2da" BEGIN
    OUTER_TEXT_SPRINT h_legacy_options_fixture ~Option%WNL%weidu_action%WNL%~
    COPY + "...blank" "override/fl#randoptions.2da"
      INSERT_BYTES 0 STRING_LENGTH ~%h_legacy_options_fixture%~
      WRITE_ASCIIE 0 ~%h_legacy_options_fixture%~ (STRING_LENGTH ~%h_legacy_options_fixture%~)
    BUT_ONLY
  END
END

DEFINE_ACTION_MACRO flir_registry_harness_generated_endpoint BEGIN
  OUTER_SET $bg2_tiers("1") = 1
  OUTER_SPRINT flir_endpoint_arg_provider ~core~
  OUTER_SPRINT flir_endpoint_arg_id ~ground-generated~
  OUTER_SPRINT flir_endpoint_arg_area ~area-generated~
  OUTER_SPRINT flir_endpoint_arg_target_kind ~ground~
  OUTER_SPRINT flir_endpoint_arg_target_identity ~-~
  OUTER_SET flir_endpoint_arg_x = 50
  OUTER_SET flir_endpoint_arg_y = 60
  OUTER_SET flir_endpoint_arg_capacity = 1
  OUTER_SPRINT flir_endpoint_arg_static_policy ~authored-static~
  OUTER_SPRINT flir_endpoint_arg_fallback ~-~
  OUTER_SPRINT flir_endpoint_arg_adapter ~~
  OUTER_SET flir_endpoint_arg_enabled = 1
  LAM flir_endpoints_add_endpoint
  OUTER_SPRINT flir_endpoint_arg_id ~endpoint-generated~
  OUTER_SPRINT flir_endpoint_arg_target_kind ~container~
  OUTER_SPRINT flir_endpoint_arg_target_identity ~target-generated~
  OUTER_SET flir_endpoint_arg_x = 0
  OUTER_SET flir_endpoint_arg_y = 0
  OUTER_SET flir_endpoint_arg_capacity = 1
  OUTER_SPRINT flir_endpoint_arg_static_policy ~runtime-resolve~
  OUTER_SPRINT flir_endpoint_arg_fallback ~core:ground-generated~
  LAM flir_endpoints_add_endpoint
  OUTER_SET $flir_endpoint_candidate("bg2" "1" "bg2:1" "core:endpoint-generated") = 1
END

DEFINE_PATCH_MACRO flir_registry_harness_read_generated_fingerprint BEGIN
  READ_LONG 0 h_generated_original_fingerprint
END

DEFINE_ACTION_MACRO flir_registry_harness_write_report BEGIN
  LAF flir_registry_canonical_rows RET flir_registry_report_rows = rows END
  OUTER_TEXT_SPRINT flir_registry_report ~schema=%flir_registry_schema% backend=%flir_registry_backend% catalog=%flir_registry_catalog_fingerprint%%WNL%%flir_registry_report_rows%~
  COPY + "...blank" "%argv[1]%"
    INSERT_BYTES 0 STRING_LENGTH ~%flir_registry_report%~
    WRITE_ASCIIE 0 ~%flir_registry_report%~ (STRING_LENGTH ~%flir_registry_report%~)
  BUT_ONLY
END

DEFINE_ACTION_MACRO flir_registry_harness_write_extra_plan BEGIN
  OUTER_SPRINT h_plan_stable $flir_registry_planned_extra_stable("1" "%h_plan_prefix%" "1")
  OUTER_SPRINT h_plan_compact $flir_registry_planned_extra_compact("1" "%h_plan_prefix%" "1")
  OUTER_TEXT_SPRINT h_plan_report ~PLAN 1 %h_plan_prefix% 1 %h_plan_stable% %h_plan_compact%%WNL%~
  COPY + "...blank" "%argv[1]%"
    INSERT_BYTES 0 STRING_LENGTH ~%h_plan_report%~
    WRITE_ASCIIE 0 ~%h_plan_report%~ (STRING_LENGTH ~%h_plan_report%~)
  BUT_ONLY
END

DEFINE_ACTION_MACRO flir_registry_harness_add_unit BEGIN
  OUTER_SPRINT $flir_registry_catalog_unit("%h_campaign%" "%h_tier%" "%h_id%") ~1~
END

DEFINE_ACTION_MACRO flir_registry_harness_add_slot BEGIN
  OUTER_SPRINT $flir_registry_catalog_slot("%h_campaign%" "%h_tier%" "%h_id%") ~1~
END

DEFINE_ACTION_MACRO flir_registry_harness_seed_legacy_locations BEGIN
  ACTION_CLEAR_ARRAY bg1_tiers
  ACTION_CLEAR_ARRAY bg2_tiers
  OUTER_SPRINT $bg2_tiers("1") ~~
  ACTION_CLEAR_ARRAY location_array
  OUTER_SPRINT $location_array("raw999" "1" "target-a.cre" "area-a" "a") ~~
  OUTER_SPRINT $location_array("raw005" "1" "target-b.cre" "area-b" "b") ~~
  LAM flir_registry_snapshot_legacy_slots
END

DEFINE_ACTION_MACRO flir_registry_harness_seed_production_arrays BEGIN
  ACTION_CLEAR_ARRAY removed_item_array
  ACTION_CLEAR_ARRAY extra_tokens
  ACTION_CLEAR_ARRAY location_array
  ACTION_CLEAR_ARRAY bg1_tiers
  ACTION_CLEAR_ARRAY bg2_tiers
  OUTER_SPRINT $bg2_tiers("1") ~~
  OUTER_SPRINT $bg1_tiers("24") ~~
  OUTER_SPRINT $removed_item_array("1" "1" "alpha") ~~
  OUTER_SPRINT $removed_item_array("1" "x0" "x") ~~
  OUTER_SPRINT $removed_item_array("1" "y0" "x") ~~
  OUTER_SPRINT $extra_tokens("1" "x0") "1"
  OUTER_SPRINT $extra_tokens("1" "y0") "1"
  OUTER_SPRINT $location_array("raw100" "1" "target-a.cre" "area-a" "same") ~~
  OUTER_SPRINT $location_array("raw200" "1" "target-b.cre" "area-b" "same") ~~
  OUTER_SPRINT $location_array("raw300" "1" "target-c.cre" "area-c" "fixes") "1"
  OUTER_SPRINT $location_array("raw400" "24" "target-d.cre" "area-d" "bg1row") ~~
END

DEFINE_ACTION_MACRO flir_registry_harness_reset_sources BEGIN
  OUTER_SET flir_source_decl_count = 0
  OUTER_SET flir_source_legacy_snapshot_initialized = 0
  OUTER_SET flir_source_legacy_cursor = 0
  ACTION_CLEAR_ARRAY flir_source_decl_order
  ACTION_CLEAR_ARRAY flir_source_decl_exists
  ACTION_CLEAR_ARRAY flir_source_decl_enabled
  ACTION_CLEAR_ARRAY flir_source_decl_item
  ACTION_CLEAR_ARRAY flir_source_decl_replacement
  ACTION_CLEAR_ARRAY flir_source_decl_source
  ACTION_CLEAR_ARRAY flir_source_decl_tier
  ACTION_CLEAR_ARRAY flir_source_decl_token
  ACTION_CLEAR_ARRAY flir_source_decl_ident
  ACTION_CLEAR_ARRAY flir_source_decl_chance
  ACTION_CLEAR_ARRAY flir_source_decl_source_kind
  ACTION_CLEAR_ARRAY flir_source_decl_object_or_slot
  ACTION_CLEAR_ARRAY flir_source_decl_virtual_policy
  ACTION_CLEAR_ARRAY flir_source_decl_declared_charge1
  ACTION_CLEAR_ARRAY flir_source_decl_declared_charge2
  ACTION_CLEAR_ARRAY flir_source_decl_declared_charge3
  ACTION_CLEAR_ARRAY flir_source_decl_expected_quantity
  ACTION_CLEAR_ARRAY flir_source_decl_campaign
  ACTION_CLEAR_ARRAY flir_source_decl_tier_hook
  ACTION_CLEAR_ARRAY flir_source_decl_birth_campaign
  ACTION_CLEAR_ARRAY flir_source_decl_birth_tier
  ACTION_CLEAR_ARRAY flir_source_decl_birth_stable
  ACTION_CLEAR_ARRAY flir_source_decl_birth_fingerprint
  ACTION_CLEAR_ARRAY flir_source_birth_hash_canonical
  ACTION_CLEAR_ARRAY flir_source_birth_occurrence
  ACTION_CLEAR_ARRAY flir_source_direct_occurrence
  ACTION_CLEAR_ARRAY flir_source_legacy_filter_signature
  ACTION_CLEAR_ARRAY flir_source_legacy_filter_skip
  ACTION_CLEAR_ARRAY flir_source_legacy_stage1
  ACTION_CLEAR_ARRAY flir_source_legacy_item_array
  ACTION_CLEAR_ARRAY flir_source_legacy_row_key
  ACTION_CLEAR_ARRAY flir_source_current_row_key
  ACTION_CLEAR_ARRAY flir_registry_legacy_ident_filter
  ACTION_CLEAR_ARRAY ident_filter
  ACTION_CLEAR_ARRAY identitem
  ACTION_CLEAR_ARRAY rebalance_tier
  ACTION_CLEAR_ARRAY rebalance_token
  ACTION_CLEAR_ARRAY item_array#stage1
  ACTION_CLEAR_ARRAY item_array
END

DEFINE_ACTION_MACRO flir_registry_harness_add_named_source BEGIN
  OUTER_SET flir_source_decl_count += 1
  OUTER_SPRINT flir_source_key ~ident:%h_source_ident%~
  OUTER_SPRINT $flir_source_decl_order("%flir_source_decl_count%") ~%flir_source_key%~
  OUTER_SPRINT $flir_source_decl_exists("%flir_source_key%") ~1~
  OUTER_SET $flir_source_decl_enabled("%flir_source_key%") = 1
  OUTER_SPRINT $flir_source_decl_item("%flir_source_key%") ~%h_source_item%~
  OUTER_SPRINT $flir_source_decl_replacement("%flir_source_key%") ~blank~
  OUTER_SPRINT $flir_source_decl_source("%flir_source_key%") ~%h_source_resource%~
  OUTER_SPRINT $flir_source_decl_tier("%flir_source_key%") ~%h_source_tier%~
  OUTER_SPRINT $flir_source_decl_token("%flir_source_key%") ~%h_source_token%~
  OUTER_SPRINT $flir_source_decl_ident("%flir_source_key%") ~%h_source_ident%~
  OUTER_SET $flir_source_decl_chance("%flir_source_key%") = h_source_chance
  OUTER_SPRINT $flir_source_decl_source_kind("%flir_source_key%") ~%h_source_kind%~
  OUTER_SPRINT $flir_source_decl_object_or_slot("%flir_source_key%") ~*~
  OUTER_SPRINT $flir_source_decl_virtual_policy("%flir_source_key%") ~%h_source_virtual_policy%~
  OUTER_SET $flir_source_decl_declared_charge1("%flir_source_key%") = 0
  OUTER_SET $flir_source_decl_declared_charge2("%flir_source_key%") = 0
  OUTER_SET $flir_source_decl_declared_charge3("%flir_source_key%") = 0
  OUTER_SET $flir_source_decl_expected_quantity("%flir_source_key%") = 1
  ACTION_IF VARIABLE_IS_SET h_source_campaign BEGIN
    OUTER_SPRINT $flir_source_decl_campaign("%flir_source_key%") ~%h_source_campaign%~
    ACTION_IF "%h_source_campaign%" STRING_EQUAL_CASE ~bg1~ BEGIN
      OUTER_SPRINT $flir_source_decl_tier_hook("%flir_source_key%") ~bg1_tiers~
    END ELSE ACTION_IF "%h_source_campaign%" STRING_EQUAL_CASE ~bg2~ BEGIN
      OUTER_SPRINT $flir_source_decl_tier_hook("%flir_source_key%") ~bg2_tiers~
    END
  END
END

DEFINE_ACTION_MACRO flir_registry_harness_run_order_probe BEGIN
  OUTER_TEXT_SPRINT h_order_report ~STATE %flir_registry_loaded_existing% %flir_registry_old_unmarked_migration%%WNL%~
  OUTER_FOR (h_order_seed = 1; h_order_seed <= 64; ++h_order_seed) BEGIN
    LAM flir_registry_harness_reset_sources
    ACTION_CLEAR_ARRAY bg1_tiers
    ACTION_CLEAR_ARRAY bg2_tiers
    ACTION_CLEAR_ARRAY location_array#stage1
    ACTION_CLEAR_ARRAY location_array
    ACTION_CLEAR_ARRAY tier_array
    OUTER_SPRINT $bg2_tiers("1") ~~
    OUTER_SET flir_source_allow_override_availability = 1
    OUTER_SPRINT h_source_campaign ~bg2~
    OUTER_SPRINT h_source_item ~rng00001~
    OUTER_SPRINT h_source_resource ~blank~
    OUTER_SPRINT h_source_tier ~1~
    OUTER_SPRINT h_source_token ~1~
    OUTER_SPRINT h_source_ident ~order_item~
    OUTER_SET h_source_chance = 50
    OUTER_SPRINT h_source_kind ~virtual~
    OUTER_SPRINT h_source_virtual_policy ~explicit~
    LAM flir_registry_harness_add_named_source

    RANDOM_SEED "%h_order_seed%"
    LAM flir_source_filter_stage1_legacy_ident_filter
    OUTER_PATCH "" BEGIN
      LPF create_loc_array#filter
        INT_VAR chance = 50
        STR_VAR location = ~order_loc~ tier = ~1~ target = ~container~ area = ~blank~ ident = ~order_location~
        RET h_order_location_skip = skip
      END
    END
    LAM flir_source_finalize_legacy_snapshot
    LAM flir_source_adopt_direct_virtual_rows
    ACTION_IF "%Preserve%" STRING_EQUAL_CASE "y" BEGIN
      LAM flir_removal_plan_load_preserve
    END
    LAM flir_registry_capture_old_unmarked_legacy_slots
    LAM flir_source_apply_extension_hook
    LAM flir_source_filter_stage1
    OUTER_SET h_order_item_skip = 0
    ACTION_IF VARIABLE_IS_SET $ident_filter("order_item") BEGIN
      OUTER_SET h_order_item_skip = 1
    END
    OUTER_SET h_order_next = RANDOM(1 100)
    OUTER_TEXT_SPRINT h_order_report ~%h_order_report%ORDER %h_order_seed% %h_order_item_skip% %h_order_location_skip% %h_order_next%%WNL%~
  END
END

DEFINE_ACTION_MACRO flir_registry_harness_run_origin_probe BEGIN
  OUTER_TEXT_SPRINT h_origin_report ~STATE %flir_registry_loaded_existing% %flir_registry_old_unmarked_migration% %flir_registry_origin%%WNL%~
  OUTER_FOR (h_origin_seed = 1; h_origin_seed <= 64; ++h_origin_seed) BEGIN
    LAM flir_registry_harness_reset_sources
    ACTION_CLEAR_ARRAY bg1_tiers
    ACTION_CLEAR_ARRAY bg2_tiers
    ACTION_CLEAR_ARRAY location_array#stage1
    ACTION_CLEAR_ARRAY location_array
    ACTION_CLEAR_ARRAY tier_array
    ACTION_CLEAR_ARRAY removed_item_array
    ACTION_CLEAR_ARRAY flir_removal_history_array
    OUTER_SPRINT $bg2_tiers("1") ~~
    OUTER_SPRINT $location_array#stage1("010" "1" "target-a.cre" "area-a" "base_a") ~~
    OUTER_SPRINT $location_array#stage1("020" "1" "target-b.cre" "area-b" "base_b") ~~
    ACTION_IF "%Preserve%" STRING_EQUAL_CASE "y" BEGIN
      LAM flir_removal_plan_load_preserve
    END ELSE BEGIN
      OUTER_SPRINT $removed_item_array("1" "1" "alpha") ~~
      OUTER_SPRINT $removed_item_array("1" "2" "beta") ~~
      OUTER_SPRINT $removed_item_array("1" "3" "gamma") ~~
    END

    RANDOM_SEED "%h_origin_seed%"
    LAM flir_registry_capture_old_unmarked_legacy_slots

    OUTER_SET flir_source_allow_override_availability = 1
    OUTER_SPRINT h_source_campaign ~bg2~
    OUTER_SPRINT h_source_item ~rng00002~
    OUTER_SPRINT h_source_resource ~blank~
    OUTER_SPRINT h_source_tier ~1~
    OUTER_SPRINT h_source_token ~4~
    OUTER_SPRINT h_source_ident ~origin_ext~
    OUTER_SET h_source_chance = 50
    OUTER_SPRINT h_source_kind ~virtual~
    OUTER_SPRINT h_source_virtual_policy ~explicit~
    LAM flir_registry_harness_add_named_source
    LAM flir_source_filter_stage1
    LAM create_loc_array#finalise
    LAM flir_registry_add_current_overflow_locations

    OUTER_SET h_origin_extension_skip = 0
    ACTION_IF VARIABLE_IS_SET $ident_filter("origin_ext") BEGIN
      OUTER_SET h_origin_extension_skip = 1
    END
    OUTER_SPRINT h_origin_overflow_raw ~missing~
    OUTER_SPRINT h_origin_overflow_target ~missing~
    OUTER_SPRINT h_origin_overflow_area ~missing~
    ACTION_PHP_EACH location_array AS h_origin_location => blank BEGIN
      ACTION_IF "%h_origin_location_4%" STRING_EQUAL_CASE "" BEGIN
        OUTER_SPRINT h_origin_overflow_raw ~%h_origin_location_0%~
        OUTER_SPRINT h_origin_overflow_target ~%h_origin_location_2%~
        OUTER_SPRINT h_origin_overflow_area ~%h_origin_location_3%~
      END
    END
    OUTER_SET h_origin_next = RANDOM(1 100)
    OUTER_TEXT_SPRINT h_origin_report ~%h_origin_report%ORIGIN_ORDER %h_origin_seed% %h_origin_extension_skip% %h_origin_overflow_raw% %h_origin_overflow_target% %h_origin_overflow_area% %h_origin_next%%WNL%~
  END
END

DEFINE_ACTION_MACRO flir_registry_harness_choose_mixed_seed BEGIN
  OUTER_SET h_mixed_seed = 0
  OUTER_FOR (h_mixed_candidate = 1; h_mixed_candidate <= 64; ++h_mixed_candidate) BEGIN
    RANDOM_SEED "%h_mixed_candidate%"
    OUTER_SET h_mixed_expected_a = RANDOM(1 2)
    OUTER_SET h_mixed_expected_extension = RANDOM(1 100)
    OUTER_SET h_mixed_expected_b = RANDOM(1 2)
    RANDOM_SEED "%h_mixed_candidate%"
    OUTER_SET h_mixed_fresh_extension = RANDOM(1 100)
    OUTER_SET h_mixed_fresh_a = RANDOM(1 2)
    OUTER_SET h_mixed_fresh_b = RANDOM(1 2)
    RANDOM_SEED "%h_mixed_candidate%"
    OUTER_SET h_mixed_wrong_a = RANDOM(1 2)
    OUTER_SET h_mixed_wrong_b = RANDOM(1 2)
    OUTER_SET h_mixed_wrong_extension = RANDOM(1 100)
    OUTER_SET h_mixed_legacy_discriminates = 0
    OUTER_SET h_mixed_fresh_discriminates = 0
    ACTION_IF (h_mixed_expected_extension > 50 AND h_mixed_wrong_extension <= 50)
          OR (h_mixed_expected_extension <= 50 AND h_mixed_wrong_extension > 50)
          OR h_mixed_expected_b != h_mixed_wrong_b BEGIN
      OUTER_SET h_mixed_legacy_discriminates = 1
    END
    ACTION_IF (h_mixed_fresh_extension > 50 AND h_mixed_wrong_extension <= 50)
          OR (h_mixed_fresh_extension <= 50 AND h_mixed_wrong_extension > 50)
          OR h_mixed_fresh_a != h_mixed_wrong_a
          OR h_mixed_fresh_b != h_mixed_wrong_b BEGIN
      OUTER_SET h_mixed_fresh_discriminates = 1
    END
    ACTION_IF h_mixed_seed = 0
          AND h_mixed_legacy_discriminates = 1
          AND h_mixed_fresh_discriminates = 1 BEGIN
      OUTER_SET h_mixed_seed = h_mixed_candidate
    END
  END
  ACTION_IF h_mixed_seed = 0 BEGIN
    FAIL ~FLIR_REGISTRY_TEST NO_DISCRIMINATING_MIXED_SEED~
  END
END

DEFINE_ACTION_MACRO flir_registry_harness_run_mixed_probe BEGIN
  LAM flir_registry_harness_choose_mixed_seed
  LAM flir_registry_harness_reset_sources
  ACTION_CLEAR_ARRAY bg1_tiers
  ACTION_CLEAR_ARRAY bg2_tiers
  ACTION_CLEAR_ARRAY location_array#stage1
  ACTION_CLEAR_ARRAY location_array
  ACTION_CLEAR_ARRAY tier_array
  ACTION_CLEAR_ARRAY removed_item_array
  ACTION_CLEAR_ARRAY flir_removal_history_array
  OUTER_SPRINT $bg2_tiers("1") ~~
  OUTER_SPRINT $location_array#stage1("010" "1" "target-a.cre" "area-a" "base_a") ~~
  OUTER_SPRINT $location_array#stage1("020" "1" "target-b.cre" "area-b" "base_b") ~~
  ACTION_IF "%Preserve%" STRING_EQUAL_CASE "y" BEGIN
    LAM flir_removal_plan_load_preserve
  END ELSE BEGIN
    OUTER_SPRINT $removed_item_array("1" "1" "alpha") ~~
    OUTER_SPRINT $removed_item_array("1" "2" "beta") ~~
    OUTER_SPRINT $removed_item_array("1" "3" "gamma") ~~
    OUTER_SPRINT $removed_item_array("1" "4" "delta") ~~
  END

  RANDOM_SEED "%h_mixed_seed%"
  LAM flir_registry_capture_old_unmarked_legacy_slots

  OUTER_SET flir_source_allow_override_availability = 1
  OUTER_SPRINT h_source_campaign ~bg2~
  OUTER_SPRINT h_source_item ~rng00002~
  OUTER_SPRINT h_source_resource ~blank~
  OUTER_SPRINT h_source_tier ~1~
  OUTER_SPRINT h_source_token ~4~
  OUTER_SPRINT h_source_ident ~mixed_ext~
  OUTER_SET h_source_chance = 50
  OUTER_SPRINT h_source_kind ~virtual~
  OUTER_SPRINT h_source_virtual_policy ~explicit~
  LAM flir_registry_harness_add_named_source
  LAM flir_source_filter_stage1
  LAM create_loc_array#finalise
  ACTION_IF !VARIABLE_IS_SET $removed_item_array("1" "4" "delta") BEGIN
    OUTER_SPRINT $removed_item_array("1" "4" "delta") ~~
  END
  LAM flir_registry_add_current_overflow_locations

  OUTER_SET h_mixed_extension_skip = 0
  ACTION_IF VARIABLE_IS_SET $ident_filter("mixed_ext") BEGIN
    OUTER_SET h_mixed_extension_skip = 1
  END
  OUTER_TEXT_SPRINT h_mixed_overflow_rows ~~
  ACTION_SORT_ARRAY_INDICES location_array LEXICOGRAPHICALLY
  ACTION_PHP_EACH location_array AS h_mixed_location => blank BEGIN
    ACTION_IF "%h_mixed_location_4%" STRING_EQUAL_CASE "" BEGIN
      OUTER_TEXT_SPRINT h_mixed_overflow_rows ~%h_mixed_overflow_rows%MIXED_OVERFLOW %h_mixed_location_0% %h_mixed_location_2% %h_mixed_location_3%%WNL%~
    END
  END
  OUTER_SET h_mixed_next = RANDOM(1 100)
  LAM flir_registry_capture_final_slots
  LAM flir_registry_reconcile
  LAF flir_registry_canonical_rows RET h_mixed_registry_rows = rows END
  OUTER_TEXT_SPRINT h_mixed_report ~MIXED_STATE %flir_registry_loaded_existing% %flir_registry_old_unmarked_migration% %flir_registry_origin%%WNL%MIXED_SEED %h_mixed_seed%%WNL%MIXED_EXTENSION %h_mixed_extension_skip%%WNL%%h_mixed_overflow_rows%MIXED_NEXT %h_mixed_next%%WNL%%h_mixed_registry_rows%~
END

DEFINE_ACTION_MACRO flir_registry_harness_write_migration_report BEGIN
  LAF flir_registry_canonical_rows RET flir_registry_report_rows = rows END
  OUTER_TEXT_SPRINT flir_registry_current_rows ~~
  ACTION_SORT_ARRAY_INDICES removed_item_array LEXICOGRAPHICALLY
  ACTION_PHP_EACH removed_item_array AS flir_registry_current_removed => blank BEGIN
    OUTER_TEXT_SPRINT flir_registry_current_rows ~%flir_registry_current_rows%CURRENT %flir_registry_current_removed_0% %flir_registry_current_removed_1% %flir_registry_current_removed_2%%WNL%~
  END
  OUTER_TEXT_SPRINT flir_registry_report ~%flir_registry_report_rows%%flir_registry_current_rows%~
  COPY + "...blank" "%argv[1]%"
    INSERT_BYTES 0 STRING_LENGTH ~%flir_registry_report%~
    WRITE_ASCIIE 0 ~%flir_registry_report%~ (STRING_LENGTH ~%flir_registry_report%~)
  BUT_ONLY
END

DEFINE_ACTION_MACRO flir_registry_harness_write_raw_fixture BEGIN
  OUTER_TEXT_SPRINT flir_registry_fixture_base ~2DA V1.0%WNL%0%WNL%CAMPAIGN TIER KIND STABLE_ID COMPACT ENABLED%WNL%@meta @schema schema %h_schema% 1 1%WNL%@meta @backend backend %h_backend% 1 1%WNL%@meta @origin origin %h_origin% 1 1%WNL%@meta @catalog catalog %h_catalog% 1 1%WNL%%h_rows%~
  LAF flir_registry_hash_text STR_VAR text = EVAL ~%flir_registry_fixture_base%~ RET flir_registry_fixture_fingerprint = hash END
  OUTER_TEXT_SPRINT flir_registry_fixture_state ~2DA V1.0%WNL%0%WNL%CAMPAIGN TIER KIND STABLE_ID COMPACT ENABLED%WNL%@meta @schema schema %h_schema% 1 1%WNL%@meta @backend backend %h_backend% 1 1%WNL%@meta @origin origin %h_origin% 1 1%WNL%@meta @catalog catalog %h_catalog% 1 1%WNL%@meta @fingerprint fingerprint %flir_registry_fixture_fingerprint% 1 1%WNL%%h_rows%~
  COPY + "...blank" "override/fl#irreg.2da"
    INSERT_BYTES 0 STRING_LENGTH ~%flir_registry_fixture_state%~
    WRITE_ASCIIE 0 ~%flir_registry_fixture_state%~ (STRING_LENGTH ~%flir_registry_fixture_state%~)
  BUT_ONLY
END

DEFINE_ACTION_MACRO flir_registry_harness_write_tampered_fixture BEGIN
  OUTER_TEXT_SPRINT flir_registry_fixture_base ~2DA V1.0%WNL%0%WNL%CAMPAIGN TIER KIND STABLE_ID COMPACT ENABLED%WNL%@meta @schema schema %h_schema% 1 1%WNL%@meta @backend backend %h_backend% 1 1%WNL%@meta @origin origin %h_origin% 1 1%WNL%@meta @catalog catalog %h_catalog% 1 1%WNL%%h_fingerprint_rows%~
  LAF flir_registry_hash_text STR_VAR text = EVAL ~%flir_registry_fixture_base%~ RET flir_registry_fixture_fingerprint = hash END
  OUTER_TEXT_SPRINT flir_registry_fixture_state ~2DA V1.0%WNL%0%WNL%%h_header%%WNL%@meta @schema %h_schema_kind% %h_schema% %h_schema_compact% %h_schema_enabled%%WNL%@meta @backend %h_backend_kind% %h_backend% %h_backend_compact% %h_backend_enabled%%WNL%@meta @origin origin %h_origin% 1 1%WNL%@meta @catalog %h_catalog_kind% %h_catalog% %h_catalog_compact% %h_catalog_enabled%%WNL%@meta @fingerprint %h_fingerprint_kind% %flir_registry_fixture_fingerprint% %h_fingerprint_compact% %h_fingerprint_enabled%%WNL%%h_rows%~
  COPY + "...blank" "override/fl#irreg.2da"
    INSERT_BYTES 0 STRING_LENGTH ~%flir_registry_fixture_state%~
    WRITE_ASCIIE 0 ~%flir_registry_fixture_state%~ (STRING_LENGTH ~%flir_registry_fixture_state%~)
  BUT_ONLY
END

DEFINE_ACTION_MACRO flir_registry_harness_default_tamper_fields BEGIN
  OUTER_SPRINT h_schema ~flir-registry-v1~
  OUTER_SPRINT h_backend ~legacy-bcs-v1~
  OUTER_SET h_catalog = 11111
  OUTER_SPRINT h_header ~CAMPAIGN TIER KIND STABLE_ID COMPACT ENABLED~
  OUTER_SPRINT h_schema_kind ~schema~
  OUTER_SPRINT h_schema_compact ~1~
  OUTER_SET h_schema_enabled = 1
  OUTER_SPRINT h_backend_kind ~backend~
  OUTER_SPRINT h_backend_compact ~1~
  OUTER_SET h_backend_enabled = 1
  OUTER_SPRINT h_catalog_kind ~catalog~
  OUTER_SPRINT h_catalog_compact ~1~
  OUTER_SET h_catalog_enabled = 1
  OUTER_SPRINT h_fingerprint_kind ~fingerprint~
  OUTER_SPRINT h_fingerprint_compact ~1~
  OUTER_SET h_fingerprint_enabled = 1
  OUTER_TEXT_SPRINT h_rows ~~
  OUTER_TEXT_SPRINT h_fingerprint_rows ~~
END

BEGIN ~fresh registry publish~ DESIGNATED 0
  LAM flir_registry_harness_reset
  OUTER_SPRINT h_tier ~1~
  OUTER_SPRINT h_id ~core:unit-a~
  LAM flir_registry_harness_add_unit
  OUTER_SPRINT h_id ~core:unit-b~
  LAM flir_registry_harness_add_unit
  OUTER_SPRINT h_id ~core:unit-extra-x0~
  LAM flir_registry_harness_add_unit
  OUTER_SPRINT h_id ~core:unit-extra-y0~
  LAM flir_registry_harness_add_unit
  OUTER_SPRINT h_id ~core:slot-a~
  LAM flir_registry_harness_add_slot
  OUTER_SPRINT h_id ~core:slot-b~
  LAM flir_registry_harness_add_slot
  LAM flir_registry_bootstrap
  LAM flir_registry_write_state
  LAM flir_registry_harness_write_report

