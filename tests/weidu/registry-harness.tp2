  OUTER_SPRINT h_tier ~1~
  OUTER_SPRINT h_id ~core:unit-a~
  LAM flir_registry_harness_add_unit
  LAM flir_registry_bootstrap
  ACTION_IF FILE_EXISTS ~override/fl#irreg.2da~ BEGIN
    FAIL ~FLIR_REGISTRY_ERR MODE2_PUBLISHED kind=boundary id=fl#irreg.2da~
  END
  LAM flir_registry_harness_write_report

