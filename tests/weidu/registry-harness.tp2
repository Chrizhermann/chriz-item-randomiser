BEGIN ~anonymous birth identity excludes compact token~ DESIGNATED 105
  LAM flir_registry_harness_reset
  OUTER_SPRINT Preserve ~n~
  LAM flir_registry_preload_state
  LAM flir_registry_harness_reset_sources
  ACTION_CLEAR_ARRAY bg1_tiers
  ACTION_CLEAR_ARRAY bg2_tiers
  OUTER_SPRINT $bg2_tiers("1") ~~
  OUTER_SET flir_source_allow_override_availability = 1
  OUTER_SPRINT tier_hook ~bg2_tiers~

  OUTER_PATCH "" BEGIN
    SPRINT item ~anon0001~
    SPRINT replacement ~blank~
    SPRINT source ~blank~
    SPRINT tier ~1~
    SPRINT token ~a0~
    SPRINT ident ~x~
    SET chance = 100
    SPRINT source_kind ~virtual~
    SPRINT object_or_slot ~explicit~
    SPRINT virtual_policy ~explicit~
    SET declared_charge1 = 0
    SET declared_charge2 = 0
    SET declared_charge3 = 0
    SET expected_quantity = 1
    SPRINT flir_source_decl_update_mode ~add~
    SPRINT flir_source_decl_enabled_value ~1~
    LPM flir_source_decl_store_current
  END
  OUTER_PATCH "" BEGIN
    SPRINT item ~anon0001~
    SPRINT replacement ~blank~
    SPRINT source ~blank~
    SPRINT tier ~1~
    SPRINT token ~a1~
    SPRINT ident ~x~
    SET chance = 100
    SPRINT source_kind ~virtual~
    SPRINT object_or_slot ~explicit~
    SPRINT virtual_policy ~explicit~
    SET declared_charge1 = 0
    SET declared_charge2 = 0
    SET declared_charge3 = 0
    SET expected_quantity = 1
    SPRINT flir_source_decl_update_mode ~add~
    SPRINT flir_source_decl_enabled_value ~1~
    LPM flir_source_decl_store_current
  END
  OUTER_PATCH "" BEGIN
    SPRINT item ~anon0002~
    SPRINT replacement ~blank~
    SPRINT source ~blank~
    SPRINT tier ~1~
    SPRINT token ~a2~
    SPRINT ident ~x~
    SET chance = 100
    SPRINT source_kind ~virtual~
    SPRINT object_or_slot ~explicit~
    SPRINT virtual_policy ~explicit~
    SET declared_charge1 = 0
    SET declared_charge2 = 0
    SET declared_charge3 = 0
    SET expected_quantity = 1
    SPRINT flir_source_decl_update_mode ~add~
    SPRINT flir_source_decl_enabled_value ~1~
    LPM flir_source_decl_store_current
  END
  LAM flir_source_filter_stage1
  LAM create_item_array#finalise
  LAM flir_removal_plan_build
  OUTER_TEXT_SPRINT h_anon_birth_report ~~
  OUTER_FOR (h_anon_i = 1; h_anon_i <= flir_removal_plan_count; ++h_anon_i) BEGIN
    OUTER_SPRINT h_anon_stable ~missing~
    ACTION_IF VARIABLE_IS_SET $flir_removal_plan_stable("%h_anon_i%") BEGIN
      OUTER_SPRINT h_anon_stable $flir_removal_plan_stable("%h_anon_i%")
    END
    OUTER_TEXT_SPRINT h_anon_birth_report ~%h_anon_birth_report%ANON %h_anon_i% %h_anon_stable%%WNL%~
  END
  COPY + "...blank" "%argv[1]%"
    INSERT_BYTES 0 STRING_LENGTH ~%h_anon_birth_report%~
    WRITE_ASCIIE 0 ~%h_anon_birth_report%~ (STRING_LENGTH ~%h_anon_birth_report%~)
  BUT_ONLY

BEGIN ~direct virtual row participates in old migration~ DESIGNATED 106
  LAM flir_registry_harness_reset
  OUTER_SPRINT Preserve ~y~
  LAM flir_registry_preload_state
