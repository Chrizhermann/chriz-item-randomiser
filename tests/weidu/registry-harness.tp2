  ACTION_PHP_EACH removed_item_array AS h_direct_removed => blank BEGIN
    OUTER_TEXT_SPRINT h_direct_current ~%h_direct_current%CURRENT %h_direct_removed_0% %h_direct_removed_1% %h_direct_removed_2%%WNL%~
  END
  OUTER_TEXT_SPRINT h_direct_report ~PLAN_COUNT %h_direct_plan_count%%WNL%PLANMETA sp0 x %h_direct_kind% %h_direct_source% %h_direct_policy%%WNL%%h_direct_rows%%h_direct_current%~
  COPY + "...blank" "%argv[1]%"
