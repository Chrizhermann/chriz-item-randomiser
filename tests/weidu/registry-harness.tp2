  OUTER_SET flir_mode1_defer_state_publication = 1
  OUTER_SPRINT Preserve ~n~
  ACTION_CLEAR_ARRAY removed_item_array
  OUTER_SPRINT $removed_item_array("1" "9" "changed") ~~
