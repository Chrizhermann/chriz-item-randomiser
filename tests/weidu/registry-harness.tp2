  LAM flir_registry_harness_add_named_source
  OUTER_SPRINT h_source_item ~synt0002~
  OUTER_SPRINT h_source_token ~2~
  OUTER_SPRINT h_source_ident ~beta~
  LAM flir_registry_harness_add_named_source
  OUTER_SPRINT h_source_item ~synt0003~
  OUTER_SPRINT h_source_resource ~blank~
  OUTER_SPRINT h_source_token ~3~
  OUTER_SPRINT h_source_ident ~gamma~
  OUTER_SPRINT h_source_kind ~virtual~
  OUTER_SPRINT h_source_virtual_policy ~legacy_blank~
  LAM flir_registry_harness_add_named_source
  OUTER_SPRINT h_source_item ~synt0004~
  OUTER_SPRINT h_source_token ~4~
  OUTER_SPRINT h_source_ident ~delta~
  LAM flir_registry_harness_add_named_source

  LAM flir_source_filter_stage1_legacy_ident_filter
  LAM flir_source_finalize_legacy_snapshot

  OUTER_SPRINT $flir_source_decl_item("ident:alpha") ~synt0002~
  OUTER_SPRINT $flir_source_decl_item("ident:beta") ~synt0001~
  OUTER_SPRINT $flir_source_decl_item("ident:gamma") ~synt0004~
  OUTER_SPRINT $flir_source_decl_item("ident:delta") ~synt0003~
  LAM flir_source_filter_stage1
  LAM create_item_array#finalise

  LAM flir_removal_plan_build
  LAM flir_removal_plan_apply
  LAM flir_registry_register_applied_units
  LAM flir_registry_reconcile
  LAM flir_registry_write_state
  LAM flir_registry_harness_write_migration_report

