BEGIN ~old migration reconstructs fixes overflow before extensions~ DESIGNATED 109
  LAM flir_registry_harness_reset
  OUTER_SPRINT Preserve ~y~
  LAM flir_registry_preload_state
  LAM flir_registry_harness_reset_sources
  ACTION_CLEAR_ARRAY bg1_tiers
  ACTION_CLEAR_ARRAY bg2_tiers
  ACTION_CLEAR_ARRAY ident_filter
  ACTION_CLEAR_ARRAY location_array#stage1
  ACTION_CLEAR_ARRAY location_array
  ACTION_CLEAR_ARRAY tier_array
  OUTER_SPRINT $bg2_tiers("1") ~~
  LAM flir_removal_plan_load_preserve

  // These are the two exact eligible rows the historical fixes loop saw.
  OUTER_SPRINT $location_array#stage1("010" "1" "target-a.cre" "area-a" "base_a") ~~
  OUTER_SPRINT $location_array#stage1("020" "1" "target-b.cre" "area-b" "base_b") ~~

  // Three historical units required one random overflow row. Compute the
  // expected old draw independently, then reset to the migration seed.
  RANDOM_SEED "1701"
  OUTER_SET h_overflow_expected_pick = RANDOM(1 2)
  OUTER_SET h_overflow_expected_next = RANDOM(1 100)
  OUTER_SET h_overflow_expected_raw = 100 + h_overflow_expected_pick
  OUTER_SPRINT h_overflow_expected_stable ~legacy:slot-bg2-1-%h_overflow_expected_raw%--1~
  OUTER_SPRINT h_overflow_expected_target ~target-a.cre~
  OUTER_SPRINT h_overflow_expected_area ~area-a~
  ACTION_IF h_overflow_expected_pick = 2 BEGIN
    OUTER_SPRINT h_overflow_expected_target ~target-b.cre~
    OUTER_SPRINT h_overflow_expected_area ~area-b~
  END
  RANDOM_SEED "1701"

  LAM flir_registry_capture_old_unmarked_legacy_slots
  OUTER_SPRINT h_overflow_cached_stable ~missing~
  OUTER_SET h_overflow_cached_occurrence = 0
  ACTION_IF VARIABLE_IS_SET $flir_registry_legacy_overflow_stable("%h_overflow_expected_raw%" "1" "%h_overflow_expected_target%" "%h_overflow_expected_area%") BEGIN
    OUTER_SPRINT h_overflow_cached_stable $flir_registry_legacy_overflow_stable("%h_overflow_expected_raw%" "1" "%h_overflow_expected_target%" "%h_overflow_expected_area%")
  END
  ACTION_IF VARIABLE_IS_SET $flir_registry_legacy_overflow_occurrence("%h_overflow_expected_raw%" "1" "%h_overflow_expected_target%" "%h_overflow_expected_area%") BEGIN
    OUTER_SET h_overflow_cached_occurrence = $flir_registry_legacy_overflow_occurrence("%h_overflow_expected_raw%" "1" "%h_overflow_expected_target%" "%h_overflow_expected_area%")
  END
  OUTER_SET h_overflow_endpoint_matches = 0
  OUTER_SET h_overflow_endpoint_wrong = 0
  ACTION_PHP_EACH location_array#stage1 AS h_overflow_replayed => blank BEGIN
    ACTION_IF "%h_overflow_replayed_0%" STRING_EQUAL_CASE "%h_overflow_expected_raw%"
          AND "%h_overflow_replayed_1%" STRING_EQUAL_CASE "1" BEGIN
      ACTION_IF "%h_overflow_replayed_2%" STRING_EQUAL_CASE "%h_overflow_expected_target%"
            AND "%h_overflow_replayed_3%" STRING_EQUAL_CASE "%h_overflow_expected_area%"
            AND "%h_overflow_replayed_4%" STRING_EQUAL_CASE "" BEGIN
        OUTER_SET h_overflow_endpoint_matches += 1
      END ELSE BEGIN
        OUTER_SET h_overflow_endpoint_wrong += 1
      END
    END
  END
  LAM create_loc_array#finalise

  // A current extension supplies enough authored capacity that the unmodified
  // fixes loop would add no overflow row and would silently take compact 3.
  OUTER_SPRINT $location_array("001" "1" "target-ext.cre" "area-ext" "ext") ~~
  LAM flir_registry_add_current_overflow_locations
  LAM flir_registry_capture_final_slots
  LAM flir_registry_reconcile
  LAM flir_registry_write_state
  OUTER_SET h_overflow_actual_next = RANDOM(1 100)
  LAF flir_registry_canonical_rows RET h_overflow_rows = rows END
  OUTER_TEXT_SPRINT h_overflow_report ~STATE %flir_registry_loaded_existing% %flir_registry_old_unmarked_migration% %flir_registry_origin%%WNL%EXPECTED_OVERFLOW %h_overflow_expected_stable% 3%WNL%CACHE %h_overflow_cached_stable% %h_overflow_cached_occurrence%%WNL%ENDPOINT %h_overflow_expected_target% %h_overflow_expected_area% %h_overflow_endpoint_matches% %h_overflow_endpoint_wrong%%WNL%RNG_NEXT %h_overflow_expected_next% %h_overflow_actual_next%%WNL%%h_overflow_rows%~
  COPY + "...blank" "%argv[1]%"
    INSERT_BYTES 0 STRING_LENGTH ~%h_overflow_report%~
    WRITE_ASCIIE 0 ~%h_overflow_report%~ (STRING_LENGTH ~%h_overflow_report%~)
  BUT_ONLY

BEGIN ~old migration rejects named raw compact drift~ DESIGNATED 110
