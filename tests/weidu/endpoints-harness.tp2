// Synthetic endpoint/capacity harness. All resources and IDs are fictional.
// argv[0] = production endpoints.tpa
// argv[1] = production catalog.tpa
// argv[2] = report path
// argv[3] = endpoint extension fixture
// argv[4] = hermetic fl#bg1pal stub
// argv[5] = optional real SSL BAF
BACKUP ~backup~
AUTHOR ~BG2 Item Randomiser endpoint test harness~

ALWAYS
  OUTER_SET h_bg1pal_area_mapping = 0
  INCLUDE ~%argv[4]%~
  INCLUDE ~%argv[1]%~
  INCLUDE ~%argv[0]%~
END

DEFINE_ACTION_MACRO h_endpoint BEGIN
  LAM flir_endpoints_add_endpoint
END

DEFINE_ACTION_MACRO h_slot BEGIN
  LAM flir_endpoints_add_slot
END

DEFINE_ACTION_MACRO flir_registry_campaign_for_tier BEGIN
  ACTION_IF "%flir_registry_tier_for_campaign%" STRING_MATCHES_REGEXP ~^\([1-9]\|1[0-3]\|fa\|ka\|s[4-9]\)$~ = 0 BEGIN
    OUTER_SPRINT flir_registry_detected_campaign ~bg2~
  END ELSE BEGIN
    OUTER_SPRINT flir_registry_detected_campaign ~bg1~
  END
END

DEFINE_PATCH_MACRO h_read_legacy_locations BEGIN
  READ_2DA_ENTRIES_NOW h_location_rows 6
  FOR (h_row = 1; h_row < h_location_rows; ++h_row) BEGIN
    READ_2DA_ENTRY_FORMER h_location_rows h_row 0 h_raw
    READ_2DA_ENTRY_FORMER h_location_rows h_row 1 h_tier
    READ_2DA_ENTRY_FORMER h_location_rows h_row 2 h_target
    READ_2DA_ENTRY_FORMER h_location_rows h_row 3 h_area
    READ_2DA_ENTRY_FORMER h_location_rows h_row 4 h_ident
    SPRINT $location_array("%h_raw%" "%h_tier%" "%h_target%" "%h_area%" "%h_ident%") ~~
  END
END

BEGIN ~valid explicit endpoints, fair rounds, and sparse values~ DESIGNATED 0
  LAM flir_endpoints_reset

  OUTER_SPRINT flir_endpoint_arg_provider ~core~
  OUTER_SPRINT flir_endpoint_arg_id ~ground-a~
  OUTER_SPRINT flir_endpoint_arg_area ~area-a~
  OUTER_SPRINT flir_endpoint_arg_target_kind ~ground~
  OUTER_SPRINT flir_endpoint_arg_target_identity ~-~
  OUTER_SET flir_endpoint_arg_x = 100
  OUTER_SET flir_endpoint_arg_y = 200
  OUTER_SET flir_endpoint_arg_capacity = 6
  OUTER_SPRINT flir_endpoint_arg_static_policy ~authored~
  OUTER_SPRINT flir_endpoint_arg_fallback ~-~
  OUTER_SPRINT flir_endpoint_arg_adapter ~~
  OUTER_SET flir_endpoint_arg_enabled = 1
  LAM h_endpoint

  ACTION_DEFINE_ASSOCIATIVE_ARRAY h_caps BEGIN
    a => 2
    b => 1
    c => 3
  END
  ACTION_PHP_EACH h_caps AS h_name => h_cap BEGIN
    OUTER_SPRINT flir_endpoint_arg_provider ~core~
    OUTER_SPRINT flir_endpoint_arg_id ~endpoint-%h_name%~
    OUTER_SPRINT flir_endpoint_arg_area ~area-a~
    ACTION_IF "%h_name%" STRING_EQUAL_CASE ~a~ BEGIN
      OUTER_SPRINT flir_endpoint_arg_target_kind ~creature~
    END ELSE ACTION_IF "%h_name%" STRING_EQUAL_CASE ~b~ BEGIN
      OUTER_SPRINT flir_endpoint_arg_target_kind ~container~
    END ELSE BEGIN
      OUTER_SPRINT flir_endpoint_arg_target_kind ~group~
    END
    OUTER_SPRINT flir_endpoint_arg_target_identity ~target-%h_name%~
    OUTER_SET flir_endpoint_arg_x = 0
    OUTER_SET flir_endpoint_arg_y = 0
    OUTER_SET flir_endpoint_arg_capacity = h_cap
    OUTER_SPRINT flir_endpoint_arg_static_policy ~runtime-resolve~
    OUTER_SPRINT flir_endpoint_arg_fallback ~core:ground-a~
    OUTER_SPRINT flir_endpoint_arg_adapter ~~
    OUTER_SET flir_endpoint_arg_enabled = 1
    LAM h_endpoint
    OUTER_SET $flir_endpoint_candidate("bg2" "1" "early" "core:endpoint-%h_name%") = 1
  END

  OUTER_SPRINT flir_endpoint_allocate_campaign ~bg2~
  OUTER_SPRINT flir_endpoint_allocate_tier ~1~
  OUTER_SPRINT flir_endpoint_allocate_band ~early~
  OUTER_SET flir_endpoint_allocate_demand = 6
  OUTER_SPRINT flir_endpoint_allocate_provider ~core~
  OUTER_SPRINT flir_endpoint_allocate_id ~scope-a~
  LAM flir_endpoints_allocate_rounds

  OUTER_SPRINT flir_endpoint_reserve_campaign ~bg2~
  OUTER_SPRINT flir_endpoint_reserve_tier ~1~
  OUTER_SPRINT flir_endpoint_reserve_provider ~core~
  OUTER_SPRINT flir_endpoint_reserve_id ~tombstone~
  OUTER_SET flir_endpoint_reserve_value = 1000
  LAM flir_endpoints_reserve_value
  // Freeze two migrated values and leave a long tombstone gap before appends.
  OUTER_SPRINT h_first_slot $flir_endpoint_slot_order("1")
  OUTER_SPRINT h_second_slot $flir_endpoint_slot_order("2")
  OUTER_SET $flir_endpoint_slot_value("%h_first_slot%") = 2
  OUTER_SET $flir_endpoint_slot_value("%h_second_slot%") = 7
  LAM flir_endpoints_validate
  LAM flir_endpoints_finalize_values

  OUTER_SPRINT h_order ~~
  OUTER_FOR (h_i = 1; h_i <= flir_endpoint_slot_count; ++h_i) BEGIN
    OUTER_SPRINT h_slot_id $flir_endpoint_slot_order("%h_i%")
    OUTER_SPRINT h_endpoint_id $flir_endpoint_slot_endpoint("%h_slot_id%")
    OUTER_SPRINT h_value $flir_endpoint_slot_value("%h_slot_id%")
    OUTER_SPRINT h_order ~%h_order%%h_endpoint_id%@%h_value%;~
  END
  OUTER_SPRINT h_scope ~bg2|1~
  OUTER_SPRINT h_list $flir_endpoint_scope_list("%h_scope%")
  OUTER_SPRINT h_max $flir_endpoint_scope_max("%h_scope%")
  OUTER_SPRINT flir_endpoint_ssl_campaign ~bg2~
  OUTER_SPRINT flir_endpoint_ssl_tier ~1~
  LAM flir_endpoints_build_ssl_scope
  OUTER_TEXT_SPRINT h_report ~ORDER %h_order%%WNL%SCOPE %h_list% MAX %h_max%%WNL%SPARSE%WNL%RandomNum(1004,2)%WNL%RandomNum(1004,7)%WNL%RandomNum(1004,1001)%WNL%RandomNum(1004,1002)%WNL%RandomNum(1004,1003)%WNL%RandomNum(1004,1004)%WNL%~
  COPY + ~%argv[0]%~ ~%argv[2]%~
    DELETE_BYTES 0 BUFFER_LENGTH
    INSERT_BYTES 0 STRING_LENGTH ~%h_report%~
    WRITE_ASCIIE 0 ~%h_report%~ (STRING_LENGTH ~%h_report%~)
    LAUNCH_PATCH_MACRO flir_endpoints_rewrite_sparse_rolls
  BUT_ONLY

BEGIN ~all base declarations match the legacy active set~ DESIGNATED 1
  ACTION_CLEAR_ARRAY location_array
  ACTION_CLEAR_ARRAY removed_item_array
  COPY - ~randomiser/lists/locations/base/bg2.2da~
         ~.../randomiser/fl-inlined/lists/locations/base/bg2.2da~
    LAUNCH_PATCH_MACRO h_read_legacy_locations
  COPY - ~randomiser/lists/locations/base/bg1.2da~
         ~.../randomiser/fl-inlined/lists/locations/base/bg1.2da~
    LAUNCH_PATCH_MACRO h_read_legacy_locations
  LAM flir_endpoints_load_declarations
  LAM flir_endpoints_validate
  OUTER_TEXT_SPRINT h_report ~DECLARATIONS %flir_endpoint_slot_count% ENDPOINTS %flir_endpoint_count%%WNL%~
  COPY + ~%argv[0]%~ ~%argv[2]%~
    DELETE_BYTES 0 BUFFER_LENGTH
    INSERT_BYTES 0 STRING_LENGTH ~%h_report%~
    WRITE_ASCIIE 0 ~%h_report%~ (STRING_LENGTH ~%h_report%~)
  BUT_ONLY

BEGIN ~planned units drive pre-mutation capacity~ DESIGNATED 2
  LAM flir_endpoints_reset

  OUTER_SPRINT flir_endpoint_arg_provider ~core~
  OUTER_SPRINT flir_endpoint_arg_id ~ground-plan~
  OUTER_SPRINT flir_endpoint_arg_area ~area-plan~
  OUTER_SPRINT flir_endpoint_arg_target_kind ~ground~
  OUTER_SPRINT flir_endpoint_arg_target_identity ~-~
  OUTER_SET flir_endpoint_arg_x = 100
  OUTER_SET flir_endpoint_arg_y = 200
  OUTER_SET flir_endpoint_arg_capacity = 3
  OUTER_SPRINT flir_endpoint_arg_static_policy ~authored~
  OUTER_SPRINT flir_endpoint_arg_fallback ~-~
  OUTER_SPRINT flir_endpoint_arg_adapter ~~
  OUTER_SET flir_endpoint_arg_enabled = 1
  LAM h_endpoint

  OUTER_SPRINT flir_endpoint_arg_id ~endpoint-plan~
  OUTER_SPRINT flir_endpoint_arg_target_kind ~container~
  OUTER_SPRINT flir_endpoint_arg_target_identity ~target-plan~
  OUTER_SET flir_endpoint_arg_x = 0
  OUTER_SET flir_endpoint_arg_y = 0
  OUTER_SPRINT flir_endpoint_arg_static_policy ~runtime-resolve~
  OUTER_SPRINT flir_endpoint_arg_fallback ~core:ground-plan~
  LAM h_endpoint
  OUTER_SPRINT flir_endpoint_candidate_provider ~core~
  OUTER_SPRINT flir_endpoint_candidate_id ~endpoint-plan~
  OUTER_SPRINT flir_endpoint_candidate_campaign ~bg2~
  OUTER_SPRINT flir_endpoint_candidate_tier ~1~
  OUTER_SPRINT flir_endpoint_candidate_band ~bg2:1~
  OUTER_SPRINT flir_endpoint_candidate_endpoint ~core:endpoint-plan~
  LAM flir_endpoints_mark_candidate

  OUTER_SET flir_endpoints_loaded = 1
  OUTER_SET flir_removal_plan_count = 2
  OUTER_SET $flir_removal_plan_emit("1") = 1
  OUTER_SET $flir_removal_plan_emit_count("1") = 2
  OUTER_SPRINT $flir_removal_plan_tier("1") ~1~
  OUTER_SET $flir_removal_plan_emit("2") = 1
  OUTER_SET $flir_removal_plan_emit_count("2") = 1
  OUTER_SPRINT $flir_removal_plan_tier("2") ~1~
  // Preserve history is deliberately unrelated and must never drive demand.
  OUTER_SPRINT $removed_item_array("24" "99" "history") ~~
  LAM flir_endpoints_build_plan

  OUTER_TEXT_SPRINT h_report ~PLANNED_SLOTS %flir_endpoint_slot_count%%WNL%~
  COPY + ~%argv[0]%~ ~%argv[2]%~
    DELETE_BYTES 0 BUFFER_LENGTH
    INSERT_BYTES 0 STRING_LENGTH ~%h_report%~
    WRITE_ASCIIE 0 ~%h_report%~ (STRING_LENGTH ~%h_report%~)
  BUT_ONLY

BEGIN ~historical generated slots survive lower demand~ DESIGNATED 3
  LAM flir_endpoints_reset
  OUTER_SPRINT flir_endpoint_arg_provider ~core~
  OUTER_SPRINT flir_endpoint_arg_id ~ground-history~
  OUTER_SPRINT flir_endpoint_arg_area ~area-history~
  OUTER_SPRINT flir_endpoint_arg_target_kind ~ground~
  OUTER_SPRINT flir_endpoint_arg_target_identity ~-~
  OUTER_SET flir_endpoint_arg_x = 100
  OUTER_SET flir_endpoint_arg_y = 200
  OUTER_SET flir_endpoint_arg_capacity = 2
  OUTER_SPRINT flir_endpoint_arg_static_policy ~authored~
  OUTER_SPRINT flir_endpoint_arg_fallback ~-~
  OUTER_SPRINT flir_endpoint_arg_adapter ~~
  OUTER_SET flir_endpoint_arg_enabled = 1
  LAM h_endpoint
  OUTER_SPRINT flir_endpoint_arg_id ~endpoint-history~
  OUTER_SPRINT flir_endpoint_arg_target_kind ~container~
  OUTER_SPRINT flir_endpoint_arg_target_identity ~target-history~
  OUTER_SET flir_endpoint_arg_x = 0
  OUTER_SET flir_endpoint_arg_y = 0
  OUTER_SPRINT flir_endpoint_arg_static_policy ~runtime-resolve~
  OUTER_SPRINT flir_endpoint_arg_fallback ~core:ground-history~
  LAM h_endpoint
  OUTER_SPRINT flir_endpoint_candidate_provider ~core~
  OUTER_SPRINT flir_endpoint_candidate_id ~endpoint-history~
  OUTER_SPRINT flir_endpoint_candidate_campaign ~bg2~
  OUTER_SPRINT flir_endpoint_candidate_tier ~1~
  OUTER_SPRINT flir_endpoint_candidate_band ~bg2:1~
  OUTER_SPRINT flir_endpoint_candidate_endpoint ~core:endpoint-history~
  LAM flir_endpoints_mark_candidate
  OUTER_SPRINT flir_endpoint_generated_campaign ~bg2~
  OUTER_SPRINT flir_endpoint_generated_tier ~1~
  OUTER_SPRINT flir_endpoint_generated_band ~bg2:1~
  OUTER_SPRINT flir_endpoint_generated_endpoint ~core:endpoint-history~
  OUTER_SET flir_endpoint_generated_round = 1
  OUTER_SET flir_endpoint_generated_generation = 0
  LAM flir_endpoints_generated_slot_identity
  OUTER_SET flir_registry_available = 1
  OUTER_SET $flir_registry_index("history-row") = 1
  OUTER_SPRINT $flir_registry_index_campaign("history-row") ~bg2~
  OUTER_SPRINT $flir_registry_index_tier("history-row") ~1~
  OUTER_SPRINT $flir_registry_index_kind("history-row") ~slot~
  OUTER_SPRINT $flir_registry_index_stable("history-row") ~%flir_endpoint_generated_qualified%~
  OUTER_SET $flir_registry_enabled("bg2" "1" "slot" "%flir_endpoint_generated_qualified%") = 1
  OUTER_SET $flir_registry_compact("bg2" "1" "slot" "%flir_endpoint_generated_qualified%") = 7
  LAM flir_endpoints_rehydrate_generated_slots
  OUTER_SPRINT h_history_slot $flir_endpoint_slot_order("1")
  OUTER_SET h_history_value = $flir_endpoint_slot_value("%h_history_slot%")
  OUTER_TEXT_SPRINT h_report ~HISTORY slots=%flir_endpoint_slot_count% value=%h_history_value%%WNL%~
  COPY + ~%argv[0]%~ ~%argv[2]%~
    DELETE_BYTES 0 BUFFER_LENGTH
    INSERT_BYTES 0 STRING_LENGTH ~%h_report%~
    WRITE_ASCIIE 0 ~%h_report%~ (STRING_LENGTH ~%h_report%~)
  BUT_ONLY

BEGIN ~historical legacy overflow keeps its physical endpoint~ DESIGNATED 5
  ACTION_CLEAR_ARRAY location_array
  ACTION_CLEAR_ARRAY removed_item_array
  COPY - ~randomiser/lists/locations/base/bg2.2da~
         ~.../randomiser/fl-inlined/lists/locations/base/bg2.2da~
    LAUNCH_PATCH_MACRO h_read_legacy_locations
  COPY - ~randomiser/lists/locations/base/bg1.2da~
         ~.../randomiser/fl-inlined/lists/locations/base/bg1.2da~
    LAUNCH_PATCH_MACRO h_read_legacy_locations
  OUTER_SPRINT h_overflow_target ~~
  OUTER_SPRINT h_overflow_area ~~
  ACTION_PHP_EACH location_array AS h_overflow_base => blank BEGIN
    ACTION_IF "%h_overflow_base_0%" STRING_EQUAL_CASE ~1~
          AND "%h_overflow_base_1%" STRING_EQUAL_CASE ~1~ BEGIN
      OUTER_SPRINT h_overflow_target ~%h_overflow_base_2%~
      OUTER_SPRINT h_overflow_area ~%h_overflow_base_3%~
    END
  END
  ACTION_IF "%h_overflow_target%" STRING_EQUAL_CASE ~~ BEGIN
    FAIL ~FLIR_ENDPOINT_ERR FIXTURE_MISSING provider=test id=overflow-base~
  END
  OUTER_SPRINT h_overflow_raw ~9001~
  OUTER_SPRINT h_overflow_stable ~legacy:slot-bg2-1-9001--1~
  OUTER_SPRINT $location_array("%h_overflow_raw%" "1" "%h_overflow_target%" "%h_overflow_area%" "") ~~
  OUTER_SPRINT $flir_registry_legacy_overflow_location("%h_overflow_raw%" "1" "%h_overflow_target%" "%h_overflow_area%") ~1~
  OUTER_SPRINT $flir_registry_legacy_overflow_stable("%h_overflow_raw%" "1" "%h_overflow_target%" "%h_overflow_area%") ~%h_overflow_stable%~
  OUTER_SET $flir_registry_legacy_overflow_occurrence("%h_overflow_raw%" "1" "%h_overflow_target%" "%h_overflow_area%") = 1
  OUTER_SET flir_registry_available = 1
  OUTER_SPRINT $flir_registry_present("bg2" "1" "slot" "%h_overflow_stable%") ~1~
  OUTER_SET $flir_registry_enabled("bg2" "1" "slot" "%h_overflow_stable%") = 1
  OUTER_SET $flir_registry_compact("bg2" "1" "slot" "%h_overflow_stable%") = 300
  LAM flir_endpoints_load_declarations
  LAM flir_endpoints_validate
  OUTER_SET h_overflow_value = 0
  OUTER_FOR (h_overflow_i = 1; h_overflow_i <= flir_endpoint_slot_count; ++h_overflow_i) BEGIN
    OUTER_SPRINT h_overflow_slot $flir_endpoint_slot_order("%h_overflow_i%")
    ACTION_IF $flir_endpoint_slot_registry_stable("%h_overflow_slot%") STRING_EQUAL_CASE ~%h_overflow_stable%~ BEGIN
      OUTER_SET h_overflow_value = $flir_endpoint_slot_value("%h_overflow_slot%")
    END
  END
  OUTER_TEXT_SPRINT h_report ~OVERFLOW active=%flir_endpoint_active_count% matched=%flir_endpoint_matched_count% slots=%flir_endpoint_slot_count% value=%h_overflow_value%%WNL%~
  COPY + ~%argv[0]%~ ~%argv[2]%~
    DELETE_BYTES 0 BUFFER_LENGTH
    INSERT_BYTES 0 STRING_LENGTH ~%h_report%~
    WRITE_ASCIIE 0 ~%h_report%~ (STRING_LENGTH ~%h_report%~)
  BUT_ONLY

BEGIN ~tombstoned generated identities are never reused~ DESIGNATED 4
  LAM flir_endpoints_reset
  OUTER_SPRINT flir_endpoint_arg_provider ~core~
  OUTER_SPRINT flir_endpoint_arg_id ~ground-tomb~
  OUTER_SPRINT flir_endpoint_arg_area ~area-tomb~
  OUTER_SPRINT flir_endpoint_arg_target_kind ~ground~
  OUTER_SPRINT flir_endpoint_arg_target_identity ~-~
  OUTER_SET flir_endpoint_arg_x = 100
  OUTER_SET flir_endpoint_arg_y = 200
  OUTER_SET flir_endpoint_arg_capacity = 1
  OUTER_SPRINT flir_endpoint_arg_static_policy ~authored~
  OUTER_SPRINT flir_endpoint_arg_fallback ~-~
  OUTER_SPRINT flir_endpoint_arg_adapter ~~
  OUTER_SET flir_endpoint_arg_enabled = 1
  LAM h_endpoint
  OUTER_SPRINT flir_endpoint_arg_id ~endpoint-tomb~
  OUTER_SPRINT flir_endpoint_arg_target_kind ~container~
  OUTER_SPRINT flir_endpoint_arg_target_identity ~target-tomb~
  OUTER_SET flir_endpoint_arg_x = 0
  OUTER_SET flir_endpoint_arg_y = 0
  OUTER_SPRINT flir_endpoint_arg_static_policy ~runtime-resolve~
  OUTER_SPRINT flir_endpoint_arg_fallback ~core:ground-tomb~
  LAM h_endpoint
  OUTER_SPRINT flir_endpoint_candidate_provider ~core~
  OUTER_SPRINT flir_endpoint_candidate_id ~endpoint-tomb~
  OUTER_SPRINT flir_endpoint_candidate_campaign ~bg2~
  OUTER_SPRINT flir_endpoint_candidate_tier ~1~
  OUTER_SPRINT flir_endpoint_candidate_band ~bg2:1~
  OUTER_SPRINT flir_endpoint_candidate_endpoint ~core:endpoint-tomb~
  LAM flir_endpoints_mark_candidate
  OUTER_SPRINT flir_endpoint_generated_campaign ~bg2~
  OUTER_SPRINT flir_endpoint_generated_tier ~1~
  OUTER_SPRINT flir_endpoint_generated_band ~bg2:1~
  OUTER_SPRINT flir_endpoint_generated_endpoint ~core:endpoint-tomb~
  OUTER_SET flir_endpoint_generated_round = 1
  OUTER_SET flir_endpoint_generated_generation = 0
  LAM flir_endpoints_generated_slot_identity
  OUTER_SET flir_registry_available = 1
  OUTER_SPRINT $flir_registry_present("bg2" "1" "slot" "%flir_endpoint_generated_qualified%") ~1~
  OUTER_SET $flir_registry_enabled("bg2" "1" "slot" "%flir_endpoint_generated_qualified%") = 0
  OUTER_SET flir_endpoint_allocate_demand = 1
  OUTER_SPRINT flir_endpoint_allocate_campaign ~bg2~
  OUTER_SPRINT flir_endpoint_allocate_tier ~1~
  OUTER_SPRINT flir_endpoint_allocate_band ~bg2:1~
  OUTER_SPRINT flir_endpoint_allocate_provider ~core~
  OUTER_SPRINT flir_endpoint_allocate_id ~tombstone~
  LAM flir_endpoints_allocate_rounds
  OUTER_TEXT_SPRINT h_report ~TOMBSTONE generation=%flir_endpoint_generated_generation% slots=%flir_endpoint_slot_count%%WNL%~
  COPY + ~%argv[0]%~ ~%argv[2]%~
    DELETE_BYTES 0 BUFFER_LENGTH
    INSERT_BYTES 0 STRING_LENGTH ~%h_report%~
    WRITE_ASCIIE 0 ~%h_report%~ (STRING_LENGTH ~%h_report%~)
  BUT_ONLY

BEGIN ~real SSL sparse roll rewrite~ DESIGNATED 6
  ACTION_CLEAR_ARRAY flir_endpoint_scope_list
  ACTION_CLEAR_ARRAY flir_endpoint_scope_max
  ACTION_CLEAR_ARRAY flir_endpoint_scope_active
  OUTER_SPRINT $flir_endpoint_scope_list("bg2|1") ~2;7;1001;1002;1003;1004~
  OUTER_SET $flir_endpoint_scope_max("bg2|1") = 1004
  ACTION_FOR_EACH h_value IN 2 7 1001 1002 1003 1004 BEGIN
    OUTER_SET $flir_endpoint_scope_active("bg2|1" "%h_value%") = 1
  END
  OUTER_SPRINT flir_endpoint_ssl_campaign ~bg2~
  OUTER_SPRINT flir_endpoint_ssl_tier ~1~
  LAM flir_endpoints_build_ssl_scope
  COPY + ~%argv[5]%~ ~%argv[2]%~
    LAUNCH_PATCH_MACRO flir_endpoints_rewrite_sparse_rolls
  BUT_ONLY

BEGIN ~extension rows survive loading and preserve identity~ DESIGNATED 7
  ACTION_CLEAR_ARRAY location_array
  ACTION_CLEAR_ARRAY removed_item_array
  COPY - ~randomiser/lists/locations/base/bg2.2da~
         ~.../randomiser/fl-inlined/lists/locations/base/bg2.2da~
    LAUNCH_PATCH_MACRO h_read_legacy_locations
  COPY - ~randomiser/lists/locations/base/bg1.2da~
         ~.../randomiser/fl-inlined/lists/locations/base/bg1.2da~
    LAUNCH_PATCH_MACRO h_read_legacy_locations
  OUTER_SPRINT flir_endpoint_extension_fixture ~%argv[3]%~
  LAM flir_endpoints_load_declarations

  OUTER_SET $flir_endpoint_slot_value("ext:slot-a") = 17
  OUTER_SET flir_endpoint_extension_expected_fingerprint = $flir_endpoint_slot_row_fingerprint("ext:slot-a")
  OUTER_SPRINT flir_endpoint_extension_kind ~slot~
  OUTER_SPRINT flir_endpoint_extension_operation ~REPLACE~
  OUTER_SPRINT flir_endpoint_extension_actor_provider ~compat~
  OUTER_SPRINT flir_endpoint_extension_provider ~ext~
  OUTER_SPRINT flir_endpoint_extension_id ~slot-a~
  OUTER_SPRINT flir_endpoint_extension_campaign ~bg2~
  OUTER_SPRINT flir_endpoint_extension_tier ~1~
  OUTER_SPRINT flir_endpoint_extension_endpoint ~ext:endpoint-a~
  OUTER_SPRINT flir_endpoint_extension_band ~bg2:1~
  OUTER_SET flir_endpoint_extension_weight = 1
  OUTER_SET flir_endpoint_extension_enabled = 1
  LAM flir_endpoints_apply

  OUTER_SET flir_endpoint_extension_expected_fingerprint = $flir_endpoint_slot_row_fingerprint("ext:slot-b")
  OUTER_SPRINT flir_endpoint_extension_kind ~slot~
  OUTER_SPRINT flir_endpoint_extension_operation ~DISABLE~
  OUTER_SPRINT flir_endpoint_extension_actor_provider ~ext~
  OUTER_SPRINT flir_endpoint_extension_provider ~ext~
  OUTER_SPRINT flir_endpoint_extension_id ~slot-b~
  LAM flir_endpoints_apply
  LAM flir_endpoints_rebuild_candidates
  LAM flir_endpoints_validate

  OUTER_SET h_ext_active = $flir_endpoint_slot_enabled("ext:slot-a")
  OUTER_SET h_ext_disabled = 1 - $flir_endpoint_slot_enabled("ext:slot-b")
  OUTER_SET h_ext_compact = $flir_endpoint_slot_value("ext:slot-a")
  OUTER_TEXT_SPRINT h_report ~EXTENSIONS endpoints=%flir_endpoint_count% slots=%flir_endpoint_slot_count% active_ext=%h_ext_active% disabled_ext=%h_ext_disabled% compact=%h_ext_compact%%WNL%~
  COPY + ~%argv[0]%~ ~%argv[2]%~
    DELETE_BYTES 0 BUFFER_LENGTH
    INSERT_BYTES 0 STRING_LENGTH ~%h_report%~
    WRITE_ASCIIE 0 ~%h_report%~ (STRING_LENGTH ~%h_report%~)
  BUT_ONLY

BEGIN ~cross-area fallback fails~ DESIGNATED 10
  LAM flir_endpoints_reset
  OUTER_SPRINT flir_endpoint_arg_provider ~core~
  OUTER_SPRINT flir_endpoint_arg_id ~ground-b~
  OUTER_SPRINT flir_endpoint_arg_area ~area-b~
  OUTER_SPRINT flir_endpoint_arg_target_kind ~ground~
  OUTER_SPRINT flir_endpoint_arg_target_identity ~-~
  OUTER_SET flir_endpoint_arg_x = 50
  OUTER_SET flir_endpoint_arg_y = 60
  OUTER_SET flir_endpoint_arg_capacity = 1
  OUTER_SPRINT flir_endpoint_arg_static_policy ~authored~
