DEFINE_ACTION_MACRO flir_manifest_harness_defaults BEGIN
  OUTER_SET flir_manifest_harness_reverse = 0
  OUTER_SET flir_manifest_harness_changed = 0
  OUTER_SET flir_manifest_harness_synthesized = 0
  OUTER_SET flir_manifest_harness_adapter_changed = 0
  OUTER_SET flir_manifest_harness_variant_changed = 0
  OUTER_SET flir_manifest_harness_duplicate_global = 0
  OUTER_SET flir_manifest_harness_duplicate_override = 0
  OUTER_SET flir_manifest_harness_disable_item = 0
  OUTER_SET flir_manifest_harness_disable_unit = 0
  OUTER_SET flir_manifest_harness_predeclared_unit = 0
  OUTER_SET flir_manifest_harness_missing_override = 0
  OUTER_SET flir_manifest_harness_scope_override = 0
  OUTER_SET flir_manifest_harness_capacity_override = 0
  OUTER_SET flir_manifest_harness_adapter_override = 0
  OUTER_SET flir_manifest_harness_legacy_book = 0
  OUTER_SET flir_manifest_harness_ground_override = 0
END

DEFINE_ACTION_MACRO flir_manifest_harness_seed BEGIN
  OUTER_SET weidu_action = 0
  OUTER_SPRINT Preserve ~n~
  OUTER_SPRINT flir_registry_backend ~eeex-manifest-v1~
  LAM flir_registry_reset
  LAM flir_endpoints_reset
  ACTION_CLEAR_ARRAY bg1_tiers
  ACTION_CLEAR_ARRAY bg2_tiers
  ACTION_CLEAR_ARRAY removed_item_array
  ACTION_CLEAR_ARRAY plugintierandtokenandgetitem
  ACTION_CLEAR_ARRAY charge_array
  ACTION_CLEAR_ARRAY extra_tokens
  ACTION_CLEAR_ARRAY RandOptions
  ACTION_CLEAR_ARRAY flir_registry_applied_unit_stable
  ACTION_CLEAR_ARRAY flir_registry_applied_extra_stable
  OUTER_SPRINT $bg2_tiers("1") ~~

  ACTION_IF flir_manifest_harness_legacy_book = 1 BEGIN
    OUTER_SET $RandOptions("flrc500") = 1
  END

  ACTION_IF flir_manifest_harness_reverse = 1 BEGIN
    OUTER_SPRINT $removed_item_array("1" "2" "beta") ~~
    ACTION_IF flir_manifest_harness_legacy_book = 1 BEGIN
      OUTER_SPRINT $removed_item_array("1" "1" "b2c") ~~
    END ELSE BEGIN
      OUTER_SPRINT $removed_item_array("1" "1" "alpha") ~~
    END
    OUTER_SPRINT $plugintierandtokenandgetitem("1" "2") ~synt0002~
    OUTER_SPRINT $plugintierandtokenandgetitem("1" "1") ~synt0001~
    ACTION_IF flir_manifest_harness_synthesized != 1 BEGIN
      LAM flir_manifest_harness_add_item_b
      LAM flir_manifest_harness_add_item_a
    END
    LAM flir_manifest_harness_add_ground_b
    LAM flir_manifest_harness_add_container_b
    LAM flir_manifest_harness_add_disabled_ground
    LAM flir_manifest_harness_add_legacy_adapter
    LAM flir_manifest_harness_add_ground_a
    LAM flir_manifest_harness_add_override_endpoint
    LAM flir_manifest_harness_add_container_a
    LAM flir_manifest_harness_add_disabled_slot
    LAM flir_manifest_harness_add_legacy_adapter_slot
    LAM flir_manifest_harness_add_slot_a
    LAM flir_manifest_harness_add_slot_b
  END ELSE BEGIN
    ACTION_IF flir_manifest_harness_legacy_book = 1 BEGIN
      OUTER_SPRINT $removed_item_array("1" "1" "b2c") ~~
    END ELSE BEGIN
      OUTER_SPRINT $removed_item_array("1" "1" "alpha") ~~
    END
    OUTER_SPRINT $removed_item_array("1" "2" "beta") ~~
    OUTER_SPRINT $plugintierandtokenandgetitem("1" "1") ~synt0001~
    OUTER_SPRINT $plugintierandtokenandgetitem("1" "2") ~synt0002~
    ACTION_IF flir_manifest_harness_synthesized != 1 BEGIN
      LAM flir_manifest_harness_add_item_a
      LAM flir_manifest_harness_add_item_b
    END
    LAM flir_manifest_harness_add_ground_a
    LAM flir_manifest_harness_add_container_a
    LAM flir_manifest_harness_add_override_endpoint
    LAM flir_manifest_harness_add_legacy_adapter
    LAM flir_manifest_harness_add_disabled_ground
    LAM flir_manifest_harness_add_ground_b
    LAM flir_manifest_harness_add_container_b
    LAM flir_manifest_harness_add_slot_b
    LAM flir_manifest_harness_add_slot_a
    LAM flir_manifest_harness_add_legacy_adapter_slot
    LAM flir_manifest_harness_add_disabled_slot
  END

  ACTION_IF flir_manifest_harness_synthesized = 1 BEGIN
    OUTER_SPRINT $removed_item_array("1" "x0" "x") ~~
    OUTER_SPRINT $removed_item_array("1" "y0" "x") ~~
    OUTER_SPRINT $plugintierandtokenandgetitem("1" "x0") ~synt0001~
    OUTER_SPRINT $plugintierandtokenandgetitem("1" "y0") ~synt0001~
    OUTER_SPRINT $extra_tokens("1" "x0") ~1~
    OUTER_SPRINT $extra_tokens("1" "y0") ~1~
    OUTER_SPRINT $flir_registry_applied_extra_stable("1" "x0") ~core:unit-x~
    OUTER_SPRINT $flir_registry_applied_extra_stable("1" "y0") ~core:unit-y~
  END

  ACTION_IF flir_manifest_harness_scope_override = 1 BEGIN
    LAM flir_manifest_harness_add_scope_item
  END
  ACTION_IF flir_manifest_harness_disable_item = 1 BEGIN
    LAM flir_manifest_harness_disable_item_a
  END
  ACTION_IF flir_manifest_harness_disable_unit = 1 BEGIN
    LAM flir_manifest_harness_add_unit_a
    LAM flir_manifest_harness_disable_unit_a
  END ELSE ACTION_IF flir_manifest_harness_predeclared_unit = 1 BEGIN
    LAM flir_manifest_harness_add_unit_a
  END

  ACTION_IF flir_manifest_harness_ground_override = 1 BEGIN
    OUTER_SET $flir_endpoint_candidate("bg2" "1" "bg2:1" "core:ground-a") = 1
  END

  ACTION_IF flir_manifest_harness_legacy_book = 1 BEGIN
    OUTER_SPRINT $flir_registry_applied_unit_stable("1" "1" "b2c") ~core:unit-a~
  END ELSE BEGIN
    OUTER_SPRINT $flir_registry_applied_unit_stable("1" "1" "alpha") ~core:unit-a~
  END
  OUTER_SPRINT $flir_registry_applied_unit_stable("1" "2" "beta") ~core:unit-b~
  ACTION_IF flir_manifest_harness_changed = 1 BEGIN
    OUTER_SPRINT $charge_array("1" "1" "3" "2" "2") ~~
  END ELSE BEGIN
    OUTER_SPRINT $charge_array("1" "1" "3" "2" "1") ~~
  END
  OUTER_SPRINT $charge_array("2" "1" "0" "4" "0") ~~

  LAM flir_endpoints_validate
  LAM flir_registry_register_applied_units
  LAM flir_endpoints_register_registry_slots
  LAM flir_registry_reconcile_mappings
  LAM flir_endpoints_claim_slots
  LAM flir_endpoints_register_catalog_rows
  ACTION_IF flir_manifest_harness_synthesized != 1
        AND flir_manifest_harness_disable_item != 1 BEGIN
    ACTION_IF flir_manifest_harness_reverse = 1 BEGIN
      LAM flir_manifest_harness_add_disabled_override
      LAM flir_manifest_harness_add_sparse_override
    END ELSE BEGIN
      LAM flir_manifest_harness_add_sparse_override
      LAM flir_manifest_harness_add_disabled_override
    END
  END
  ACTION_IF flir_manifest_harness_duplicate_override = 1 BEGIN
    LAM flir_manifest_harness_add_duplicate_override
  END
  ACTION_IF flir_manifest_harness_missing_override = 1 BEGIN
    LAM flir_manifest_harness_add_missing_override
  END
  ACTION_IF flir_manifest_harness_scope_override = 1 BEGIN
    LAM flir_manifest_harness_add_scope_override
  END
  ACTION_IF flir_manifest_harness_capacity_override = 1 BEGIN
    LAM flir_manifest_harness_add_capacity_override
  END
  ACTION_IF flir_manifest_harness_adapter_override = 1 BEGIN
    LAM flir_manifest_harness_add_adapter_override
  END
  ACTION_IF flir_manifest_harness_ground_override = 1 BEGIN
    LAM flir_manifest_harness_add_ground_override
  END
  ACTION_IF flir_manifest_harness_duplicate_global = 1 BEGIN
    // Inject after registry reconciliation so manifest validation, not registry
    // setup, owns the duplicate GLOBAL diagnostic.
    OUTER_SPRINT $removed_item_array("1" "1" "duplicate") ~~
  END

  // This is the production seam under test: actual applied arrays and their
  // registry identities are normalized before the final catalog fingerprint.
  LAM flir_manifest_prepare_catalog
  LAM flir_registry_finalize_catalog
  OUTER_SPRINT flir_manifest_probe ~THIS_MUST_NOT_REPLACE_LITERAL_DATA~
  OUTER_SPRINT flir_manifest_output_path ~%argv[4]%~
  LAM flir_manifest_write
END

BEGIN ~Manifest harness: forward declarations~ DESIGNATED 0
