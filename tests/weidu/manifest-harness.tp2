// Hermetic --nogame harness for the generated Mode 1 delivery manifest.
// argv[0] = production manifest.tpa
// argv[1] = production catalog.tpa
// argv[2] = production registry.tpa
// argv[3] = production endpoints.tpa
// argv[4] = exact FLDLVMan.lua output path

BACKUP ~backup~
AUTHOR ~BG2 Item Randomiser test harness~

ALWAYS
  INCLUDE ~%argv[1]%~
  INCLUDE ~%argv[2]%~
  INCLUDE ~%argv[3]%~
  INCLUDE ~%argv[0]%~
END

DEFINE_ACTION_MACRO flir_manifest_harness_make_escaped_identity BEGIN
  // Construct the percent bytes rather than placing a percent-delimited token
  // in TP2 source. This proves the generator never recursively evaluates data.
  OUTER_INNER_PATCH_SAVE flir_manifest_harness_escaped_identity ~Container "A"\B]]flir_manifest_probe~ BEGIN
    INSERT_BYTES 36 4
    WRITE_BYTE 36 0x25
    WRITE_BYTE 37 0x0a
    WRITE_BYTE 38 0x09
    WRITE_BYTE 39 0x01
    INSERT_BYTES 17 1
    WRITE_BYTE 17 0x25
  END
  // Build policy%flir_manifest_probe%tail as bytes. The probe variable is set
  // only immediately before manifest publication, catching recursive expansion
  // of provider-owned catalog data at the encoder boundary.
  OUTER_INNER_PATCH_SAVE flir_manifest_harness_percent_policy ~policyflir_manifest_probetail~ BEGIN
    INSERT_BYTES 25 1
    WRITE_BYTE 25 0x25
    INSERT_BYTES 6 1
    WRITE_BYTE 6 0x25
  END
END

DEFINE_ACTION_MACRO flir_manifest_harness_add_item_a BEGIN
  OUTER_SPRINT flir_catalog_arg_operation ~ADD~
  OUTER_SPRINT flir_catalog_arg_actor_provider ~core~
  OUTER_SPRINT flir_catalog_arg_provider ~core~
  OUTER_SPRINT flir_catalog_arg_id ~item-a~
  OUTER_SPRINT flir_catalog_arg_tier ~1~
  OUTER_SPRINT flir_catalog_arg_resref ~synt0001~
  ACTION_IF flir_manifest_harness_variant_changed = 1 BEGIN
    OUTER_TEXT_SPRINT flir_catalog_arg_variant_policy ~%flir_manifest_harness_percent_policy%~
  END ELSE BEGIN
    OUTER_SPRINT flir_catalog_arg_variant_policy ~exact~
  END
  OUTER_SPRINT flir_catalog_arg_source_set_id ~core:sources-a~
  OUTER_SET flir_catalog_arg_enabled = 1
  LAM flir_catalog_item
END

DEFINE_ACTION_MACRO flir_manifest_harness_add_scope_item BEGIN
  OUTER_SPRINT flir_catalog_arg_operation ~ADD~
  OUTER_SPRINT flir_catalog_arg_actor_provider ~core~
  OUTER_SPRINT flir_catalog_arg_provider ~core~
  OUTER_SPRINT flir_catalog_arg_id ~item-scope~
  OUTER_SPRINT flir_catalog_arg_tier ~2~
  OUTER_SPRINT flir_catalog_arg_resref ~synt0003~
  OUTER_SPRINT flir_catalog_arg_variant_policy ~exact~
  OUTER_SPRINT flir_catalog_arg_source_set_id ~core:sources-scope~
  OUTER_SET flir_catalog_arg_enabled = 1
  LAM flir_catalog_item
END

DEFINE_ACTION_MACRO flir_manifest_harness_disable_item_a BEGIN
  OUTER_SET flir_manifest_harness_row_fingerprint = $flir_catalog_row_fingerprint("item" "core:item-a")
  OUTER_SPRINT flir_catalog_arg_operation ~DISABLE~
  OUTER_SPRINT flir_catalog_arg_actor_provider ~core~
  OUTER_SPRINT flir_catalog_arg_provider ~core~
  OUTER_SPRINT flir_catalog_arg_id ~item-a~
  OUTER_SET flir_catalog_arg_expected_fingerprint = flir_manifest_harness_row_fingerprint
  LAM flir_catalog_item
END

