LAM flir_catalog_unit
ACTION_IF $flir_catalog_enabled("unit" "core:unit-tombstone") != 0
  OR NOT (~token-001~ STRING_EQUAL $flir_catalog_compact_token("unit" "core:unit-tombstone"))
  OR NOT (~core~ STRING_EQUAL $flir_catalog_owner("unit" "core:unit-tombstone"))
  OR NOT (~core~ STRING_EQUAL $flir_catalog_provider("unit" "core:unit-tombstone"))
  OR NOT (~unit-tombstone~ STRING_EQUAL $flir_catalog_id("unit" "core:unit-tombstone")) BEGIN
  FAIL ~HARNESS_ERR unit DISABLE changed stored identity or fields~
END
OUTER_SET flir_harness_tombstone_fingerprint = $flir_catalog_row_fingerprint("unit" "core:unit-tombstone")
OUTER_SPRINT flir_catalog_arg_operation ~REPLACE~
OUTER_SPRINT flir_catalog_arg_actor_provider ~compat~
