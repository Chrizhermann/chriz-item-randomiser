
IF
  Exists("picture1")
  Global("fl12t01","GLOBAL",10)
THEN RESPONSE #100
  ActionOverride("picture1",CreateItem("compon01",1,0,0))
  SetGlobal("fl12t01","GLOBAL",-1)
  DestroySelf()
END

