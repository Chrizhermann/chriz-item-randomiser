
IF
  Exists("container2")
  Global("fl5t01","GLOBAL",11)
THEN RESPONSE #100
  ActionOverride("container2",CreateItem("ring27",1,1,1))
  SetGlobal("fl5t01","GLOBAL",-1)
  DestroySelf()
END

