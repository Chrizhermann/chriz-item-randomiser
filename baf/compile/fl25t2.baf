
IF
  Exists("container4")
  Global("fl25t01","GLOBAL",2)
THEN RESPONSE #100
  ActionOverride("container4",CreateItem("amul15",10,0,0))
  SetGlobal("fl25t01","GLOBAL",-1)
  DestroySelf()
END

