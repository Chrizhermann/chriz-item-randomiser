
IF
  Exists("DIANA")
  Global("flsat01","GLOBAL",2)
THEN RESPONSE #100
  GiveItemCreate("scrl66","DIANA",1,0,0)
  SetGlobal("flsat01","GLOBAL",-1)
  DestroySelf()
END

