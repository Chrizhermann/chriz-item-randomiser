
IF
  Exists("container6")
  Global("fl7t01","GLOBAL",2)
THEN RESPONSE #100
  ActionOverride("container6",CreateItem("brac10",0,0,0))
  SetGlobal("fl7t01","GLOBAL",-1)
  DestroySelf()
END

